@* ================================================================================
   VISTA: CMS.UI/Views/Settings/ExchangeRates.cshtml
   PROPÓSITO: Mantenimiento del catálogo de Tipos de Tasa de Cambio
   TABLA:     {company_schema}.exchange_rate  (BD operacional de la compañía)
   ================================================================================ *@
@{
    ViewData["Title"] = "Tipos de Tasa de Cambio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .er-code-badge {
        font-size: .75rem;
        font-weight: 700;
        padding: .25rem .6rem;
        border-radius: 5px;
        background: #1e3a5f;
        color: #60a5fa;
        border: 1px solid #2563eb44;
        font-family: monospace;
        letter-spacing: .04em;
    }
</style>

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="text-white mb-0">
                <i class="bi bi-currency-exchange me-2 text-info"></i>Tipos de Tasa de Cambio
            </h4>
            <small class="text-muted">Catálogo de tipos de tasa utilizados en transacciones contables</small>
        </div>
        <button class="btn btn-primary" onclick="ER.openNew()">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Tipo
        </button>
    </div>

    <!-- Alert -->
    <div id="erAlert" class="alert d-none mb-3" role="alert"></div>

    <!-- Tabla -->
    <div class="card bg-dark border-secondary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-sm mb-0" id="tblExchangeRates">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-center" style="width:90px;">Orden</th>
                            <th class="text-center" style="width:90px;">Activo</th>
                            <th style="width:100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="bodyExchangeRates">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">
                                <i class="bi bi-hourglass-split me-1"></i>Cargando…
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- ============================================================
     MODAL CREAR / EDITAR
     ============================================================ -->
<div class="modal fade" id="erModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="erModalTitle">
                    <i class="bi bi-currency-exchange me-2 text-info"></i>Tipo de Tasa de Cambio
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="erId">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Código *
                            <small>(máx. 20)</small>
                        </label>
                        <input type="text" id="erCode" class="form-control text-uppercase" maxlength="20"
                               placeholder="Ej: PER">
                        <small>Código único sin espacios. Ej: PER, SER, UER</small>
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label">Descripción</label>
                        <input type="text" id="erDescription" class="form-control" maxlength="200"
                               placeholder="Ej: Purchase Exchange Rate — Tasa de compra">
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label">Orden de visualización</label>
                        <input type="number" id="erDisplayOrder" class="form-control" min="0" step="1" value="0">
                        <small>Menor número aparece primero</small>
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="erActive" checked>
                            <label class="form-check-label" for="erActive">Activo</label>
                            <div><small>Disponible para usar en el sistema</small></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="ER.save()">
                    <i class="bi bi-floppy me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL ELIMINAR
     ============================================================ -->
<div class="modal fade" id="erDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light">
            <div class="modal-header border-danger">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Eliminar Tipo de Tasa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea eliminar el tipo de tasa <strong id="erDeleteName" class="text-info"></strong>?</p>
                <small class="text-muted">
                    Esta acción es irreversible. Si el tipo de tasa está siendo usado en transacciones,
                    considere desactivarlo en lugar de eliminarlo.
                </small>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="ER.confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.ER_API   = '@ViewBag.ApiBaseUrl';
    window.ER_TOKEN = '@ViewBag.ApiToken';
</script>
<script src="~/js/exchangeRates.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        ['erModal', 'erDeleteModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });
    });
</script>
}
