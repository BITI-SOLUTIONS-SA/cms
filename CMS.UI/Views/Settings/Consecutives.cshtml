@* ARCHIVO: CMS.UI/Views/Settings/Consecutives.cshtml                               *@
@* PROPÓSITO: Gestión de Consecutivos de Documentos por Compañía                   *@
@* AUTOR: BITI SOLUTIONS S.A                                                        *@
@* CREADO: 2025-01-22                                                               *@
@* ================================================================================ *@

@{
    ViewData["Title"] = "Consecutivos";
}

<div class="content-container">
    <!-- ===== HEADER ===== -->
    <div class="page-header mb-4">
        <div class="page-header-content">
            <h1><i class="bi bi-hash me-2"></i>Consecutivos de Documentos</h1>
            <p class="text-muted mb-0">Configuración de numeración automática de documentos (Journal Entries, Facturas, etc.)</p>
        </div>
        <div class="page-header-actions">
            <button type="button" class="btn btn-tech-primary" data-bs-toggle="modal" data-bs-target="#modalConsecutive">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Consecutivo
            </button>
        </div>
    </div>

    <!-- ===== ALERTAS ===== -->
    <div id="alert-container"></div>

    <!-- ===== INFO PANEL ===== -->
    <div class="alert alert-info-tech mb-4">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-3 fs-4"></i>
            <div>
                <h6 class="mb-2">Tokens de Máscara Disponibles:</h6>
                <ul class="mb-0 small">
                    <li><code>{YYYY}</code> - Año completo (2025)</li>
                    <li><code>{YY}</code> - Año corto (25)</li>
                    <li><code>{MM}</code> - Mes (01-12)</li>
                    <li><code>{DD}</code> - Día (01-31)</li>
                    <li><code>{####}</code> - Consecutivo numérico (longitud según campo Length)</li>
                </ul>
                <p class="mb-0 mt-2"><strong>Ejemplo:</strong> <code>JE-{YYYY}-{######}</code> → <code>JE-2025-000001</code></p>
            </div>
        </div>
    </div>

    <!-- ===== FILTROS ===== -->
    <div class="card bg-dark-card border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Entity Type</label>
                    <select id="filterEntityType" class="form-select bg-dark text-light">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Entity Document</label>
                    <select id="filterEntityDocument" class="form-select bg-dark text-light">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Buscar</label>
                    <input type="text" id="searchInput" class="form-control bg-dark text-light" placeholder="Buscar por código o descripción...">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-tech-secondary w-100" onclick="CO.applyFilters()">
                        <i class="bi bi-funnel me-2"></i>Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== TABLA ===== -->
    <div class="card bg-dark-card border-0">
        <div class="card-header bg-dark-header">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Consecutivos Configurados</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" id="tableConsecutives">
                    <thead>
                        <tr>
                            <th style="width: 150px;">Código</th>
                            <th>Descripción</th>
                            <th style="width: 120px;">Tipo</th>
                            <th style="width: 120px;">Documento</th>
                            <th style="width: 200px;">Máscara</th>
                            <th style="width: 120px;">Último Valor</th>
                            <th style="width: 100px;">Estado</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL CREAR/EDITAR ===== -->
<div class="modal fade" id="modalConsecutive" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">
                    <i class="bi bi-hash me-2"></i><span id="modalTitleText">Nuevo Consecutivo</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formConsecutive">
                    <input type="hidden" id="consecutiveId">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="code" class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="code" maxlength="50" required>
                            <small class="text-muted">Identificador único del consecutivo</small>
                        </div>
                        <div class="col-md-6">
                            <label for="description" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="description" maxlength="200" required>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <label for="idEntityType" class="form-label">Entity Type <span class="text-danger">*</span></label>
                            <select class="form-select bg-dark text-light" id="idEntityType" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="idEntityDocument" class="form-label">Entity Document <span class="text-danger">*</span></label>
                            <select class="form-select bg-dark text-light" id="idEntityDocument" required>
                                <option value="">Seleccione entity type primero...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="idMenu" class="form-label">Menú <span class="text-danger">*</span></label>
                            <select class="form-select bg-dark text-light" id="idMenu" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <small class="text-muted">Proceso/módulo donde se usa</small>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-12">
                            <label for="mask" class="form-label">Máscara <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="mask" maxlength="50" required placeholder="Ej: JE-{YYYY}-{######}">
                            <small class="text-muted">Tokens: {YYYY}, {YY}, {MM}, {DD}, {####...}</small>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-3">
                            <label for="length" class="form-label">Longitud <span class="text-danger">*</span></label>
                            <input type="number" class="form-control bg-dark text-light" id="length" min="1" max="20" value="6" required>
                            <small class="text-muted">Dígitos del consecutivo</small>
                        </div>
                        <div class="col-md-3">
                            <label for="initialValue" class="form-label">Valor Inicial <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="initialValue" maxlength="50" value="000001" required>
                        </div>
                        <div class="col-md-3">
                            <label for="finalValue" class="form-label">Valor Final <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="finalValue" maxlength="50" value="999999" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label d-block">Estado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label" for="isActive">Activo</label>
                            </div>
                        </div>
                    </div>

                    <div id="lastUsageInfo" class="mt-3" style="display: none;">
                        <hr class="border-secondary">
                        <h6 class="text-muted">Información de Uso</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label text-muted">Último Valor</label>
                                <p class="form-control-plaintext text-light" id="lastValueDisplay">-</p>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted">Último Usuario</label>
                                <p class="form-control-plaintext text-light" id="lastUserDisplay">-</p>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted">Última Fecha</label>
                                <p class="form-control-plaintext text-light" id="lastDateDisplay">-</p>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="CO.save()">
                    <i class="bi bi-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Consecutives Module
const CO = {
    data: [],
    entityTypes: [],
    entityDocuments: [],
    menus: [],

    init() {
        this.loadEntityTypes();
        this.loadEntityDocuments();
        this.loadMenus();
        this.loadData();
        this.setupModal();
        this.setupEntityTypeChange();
    },

    async loadEntityTypes() {
        try {
            const response = await fetch('/api/EntityType/active');
            if (!response.ok) throw new Error('Error cargando entity types');

            this.entityTypes = await response.json();
            this.populateEntityTypeSelectors();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando entity types', 'danger');
        }
    },

    async loadEntityDocuments() {
        try {
            const response = await fetch('/api/EntityDocument/active');
            if (!response.ok) throw new Error('Error cargando entity documents');

            this.entityDocuments = await response.json();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando entity documents', 'danger');
        }
    },

    async loadMenus() {
        try {
            const response = await fetch('/api/menu/admin');
            if (!response.ok) throw new Error('Error cargando menús');

            const result = await response.json();
            this.menus = result.data || [];
            this.populateMenuSelector();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando menús', 'danger');
        }
    },

    populateMenuSelector() {
        const menuSelect = document.getElementById('idMenu');
        menuSelect.innerHTML = '<option value="">Seleccione...</option>' +
            this.menus.map(m => `<option value="${m.idMenu}">${m.name} (${m.url})</option>`).join('');
    },

    populateEntityTypeSelectors() {
        // Modal selector
        const modalSelect = document.getElementById('idEntityType');
        modalSelect.innerHTML = '<option value="">Seleccione...</option>' +
            this.entityTypes.map(et => `<option value="${et.id}">${et.code} - ${et.name}</option>`).join('');

        // Filter selector
        const filterSelect = document.getElementById('filterEntityType');
        filterSelect.innerHTML = '<option value="">Todos</option>' +
            this.entityTypes.map(et => `<option value="${et.id}">${et.code} - ${et.name}</option>`).join('');
    },

    setupEntityTypeChange() {
        document.getElementById('idEntityType')?.addEventListener('change', (e) => {
            const entityTypeId = parseInt(e.target.value);
            const docSelect = document.getElementById('idEntityDocument');

            if (!entityTypeId) {
                docSelect.innerHTML = '<option value="">Seleccione entity type primero...</option>';
                return;
            }

            const docs = this.entityDocuments.filter(d => d.idEntityType === entityTypeId);
            docSelect.innerHTML = '<option value="">Seleccione...</option>' +
                docs.map(d => `<option value="${d.id}">${d.code} - ${d.name}</option>`).join('');
        });

        document.getElementById('filterEntityType')?.addEventListener('change', (e) => {
            const entityTypeId = parseInt(e.target.value);
            const docSelect = document.getElementById('filterEntityDocument');

            if (!entityTypeId) {
                docSelect.innerHTML = '<option value="">Todos</option>';
                this.applyFilters();
                return;
            }

            const docs = this.entityDocuments.filter(d => d.idEntityType === entityTypeId);
            docSelect.innerHTML = '<option value="">Todos</option>' +
                docs.map(d => `<option value="${d.id}">${d.code} - ${d.name}</option>`).join('');
            this.applyFilters();
        });
    },

    async loadData() {
        try {
            const response = await fetch('/api/Consecutive');
            if (!response.ok) throw new Error('Error cargando consecutivos');

            this.data = await response.json();
            this.renderTable();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando datos', 'danger');
        }
    },

    renderTable() {
        const tbody = document.querySelector('#tableConsecutives tbody');
        if (!this.data.length) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No hay consecutivos configurados
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = this.data.map(item => `
            <tr data-entity-type="${item.idEntityType}" data-entity-document="${item.idEntityDocument}">
                <td><code class="text-info">${this.escapeHtml(item.code)}</code></td>
                <td class="fw-semibold">${this.escapeHtml(item.description)}</td>
                <td>
                    <span class="badge bg-info">${this.escapeHtml(item.entityTypeCode)}</span>
                </td>
                <td>
                    <span class="badge bg-secondary">${this.escapeHtml(item.entityDocumentCode)}</span>
                </td>
                <td><code class="text-warning">${this.escapeHtml(item.mask)}</code></td>
                <td>
                    ${item.lastValue 
                        ? `<code class="text-success">${this.escapeHtml(item.lastValue)}</code>` 
                        : '<span class="text-muted">Sin uso</span>'}
                </td>
                <td>
                    ${item.isActive 
                        ? '<span class="badge bg-success">Activo</span>' 
                        : '<span class="badge bg-secondary">Inactivo</span>'}
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="CO.edit(${item.id})" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="CO.confirmDelete(${item.id})" title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    },

    applyFilters() {
        const entityTypeFilter = document.getElementById('filterEntityType').value;
        const entityDocumentFilter = document.getElementById('filterEntityDocument').value;
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#tableConsecutives tbody tr');

        rows.forEach(row => {
            const entityType = row.getAttribute('data-entity-type');
            const entityDocument = row.getAttribute('data-entity-document');
            const text = row.textContent.toLowerCase();

            const matchesEntityType = !entityTypeFilter || entityType === entityTypeFilter;
            const matchesEntityDocument = !entityDocumentFilter || entityDocument === entityDocumentFilter;
            const matchesSearch = !searchTerm || text.includes(searchTerm);

            row.style.display = matchesEntityType && matchesEntityDocument && matchesSearch ? '' : 'none';
        });
    },

    setupModal() {
        const modal = document.getElementById('modalConsecutive');
        modal?.addEventListener('hidden.bs.modal', () => this.resetForm());
    },

    resetForm() {
        document.getElementById('formConsecutive').reset();
        document.getElementById('consecutiveId').value = '';
        document.getElementById('modalTitleText').textContent = 'Nuevo Consecutivo';
        document.getElementById('isActive').checked = true;
        document.getElementById('lastUsageInfo').style.display = 'none';
        document.getElementById('idEntityDocument').innerHTML = '<option value="">Seleccione entity type primero...</option>';
    },

    async edit(id) {
        try {
            const response = await fetch(`/api/Consecutive/${id}`);
            if (!response.ok) throw new Error('Error cargando consecutivo');

            const data = await response.json();
            document.getElementById('consecutiveId').value = data.id;
            document.getElementById('code').value = data.code;
            document.getElementById('description').value = data.description;
            document.getElementById('idEntityType').value = data.idEntityType;

            // Trigger change para cargar documentos
            document.getElementById('idEntityType').dispatchEvent(new Event('change'));
            setTimeout(() => {
                document.getElementById('idEntityDocument').value = data.idEntityDocument;
            }, 100);

            document.getElementById('idMenu').value = data.idMenu;
            document.getElementById('mask').value = data.mask;
            document.getElementById('length').value = data.length;
            document.getElementById('initialValue').value = data.initialValue;
            document.getElementById('finalValue').value = data.finalValue;
            document.getElementById('isActive').checked = data.isActive;

            // Mostrar info de uso
            if (data.lastValue) {
                document.getElementById('lastUsageInfo').style.display = 'block';
                document.getElementById('lastValueDisplay').textContent = data.lastValue;
                document.getElementById('lastUserDisplay').textContent = data.lastUser || '-';
                document.getElementById('lastDateDisplay').textContent = data.lastDate 
                    ? new Date(data.lastDate).toLocaleString() 
                    : '-';
            }

            document.getElementById('modalTitleText').textContent = 'Editar Consecutivo';
            new bootstrap.Modal(document.getElementById('modalConsecutive')).show();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando datos', 'danger');
        }
    },

    async save() {
        const id = document.getElementById('consecutiveId').value;
        const dto = {
            code: document.getElementById('code').value.trim(),
            description: document.getElementById('description').value.trim(),
            idEntityType: parseInt(document.getElementById('idEntityType').value),
            idEntityDocument: parseInt(document.getElementById('idEntityDocument').value),
            idMenu: parseInt(document.getElementById('idMenu').value),
            mask: document.getElementById('mask').value.trim(),
            length: parseInt(document.getElementById('length').value),
            initialValue: document.getElementById('initialValue').value.trim(),
            finalValue: document.getElementById('finalValue').value.trim(),
            isActive: document.getElementById('isActive').checked
        };

        if (!dto.code || !dto.description || !dto.idEntityType || !dto.idEntityDocument || !dto.idMenu || !dto.mask || !dto.initialValue || !dto.finalValue) {
            this.showAlert('Complete todos los campos obligatorios', 'warning');
            return;
        }

        try {
            const url = id ? `/api/Consecutive/${id}` : '/api/Consecutive';
            const method = id ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Error guardando');
            }

            bootstrap.Modal.getInstance(document.getElementById('modalConsecutive')).hide();
            this.showAlert(id ? 'Consecutivo actualizado exitosamente' : 'Consecutivo creado exitosamente', 'success');
            this.loadData();
        } catch (error) {
            console.error(error);
            this.showAlert(error.message, 'danger');
        }
    },

    async confirmDelete(id) {
        if (!confirm('¿Está seguro de eliminar este consecutivo?')) return;

        try {
            const response = await fetch(`/api/Consecutive/${id}`, { method: 'DELETE' });
            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Error eliminando');
            }

            this.showAlert('Consecutivo eliminado exitosamente', 'success');
            this.loadData();
        } catch (error) {
            console.error(error);
            this.showAlert(error.message, 'danger');
        }
    },

    showAlert(message, type) {
        const container = document.getElementById('alert-container');
        const alert = `
            <div class="alert alert-${type} alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'}-fill me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        container.innerHTML = alert;
        setTimeout(() => container.innerHTML = '', 5000);
    },

    escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

// Inicializar
document.addEventListener('DOMContentLoaded', () => CO.init());

// Mover modales al body
document.addEventListener('DOMContentLoaded', function () {
    ['modalConsecutive'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) document.body.appendChild(el);
    });
});
</script>

<style>
    .bg-dark-card { background: linear-gradient(135deg, #1a1f36 0%, #252b47 100%); }
    .bg-dark-header { background: rgba(0, 0, 0, 0.2); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
    .table-dark { --bs-table-bg: transparent; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .alert-info-tech {
        background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6e 100%);
        border: 1px solid rgba(100, 149, 237, 0.3);
        color: #e0e7ff;
    }
</style>
}
