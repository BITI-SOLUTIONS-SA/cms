@model List<CMS.Entities.Operational.Customer>

@{
    ViewData["Title"] = "Customers";
}

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Customers</h4>
        <a href="/Customers/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Crear Customer
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card mb-3" style="background-color: #16213e; border: 1px solid #24304f;">
        <div class="card-body">
            <form method="get" action="/Customers/Customers">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Buscar</label>
                        <input type="text" name="search" class="form-control" 
                               value="@ViewBag.Search" 
                               placeholder="Nombre, código, identificación, email..." />
                        <small class="form-text">Busca por nombre, código, identificación o email</small>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select name="includeInactive" class="form-select">
                            <option value="false" selected="@(ViewBag.IncludeInactive == false || ViewBag.IncludeInactive == null)">Solo activos</option>
                            <option value="true" selected="@(ViewBag.IncludeInactive == true)">Incluir inactivos</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a href="/Customers/Customers" class="btn btn-outline-light">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de resultados -->
    <div class="card" style="background-color: #16213e; border: 1px solid #24304f;">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron customers.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Identificación</th>
                                <th>Tipo</th>
                                <th>Email</th>
                                <th>Emisor</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>
                                        <code class="text-light">@customer.Code</code>
                                    </td>
                                    <td>@customer.Name</td>
                                    <td>@customer.Identification</td>
                                    <td>
                                        <span class="badge bg-secondary">@customer.CustomerType</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Email))
                                        {
                                            <small>@customer.Email</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted">-</span>
                                    </td>
                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="/Customers/Details/@customer.Id" 
                                               class="btn btn-outline-info" 
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/Customers/Edit/@customer.Id" 
                                               class="btn btn-outline-warning" 
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-light">
                    <small>Total: <strong>@Model.Count</strong> customers</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Modales se mueven al body para evitar problemas de z-index -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // No hay modales en esta vista actualmente
        });
    </script>
}
