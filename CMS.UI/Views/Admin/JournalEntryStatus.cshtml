@* ================================================================================
   VISTA: CMS.UI/Views/Admin/JournalEntryStatus.cshtml
   PROPÓSITO: Mantenimiento del catálogo admin.journal_entry_status
   TABLA:     admin.journal_entry_status  (BD central: cms)
   DESCRIPCIÓN: Gestiona los estados del asiento de diario.
                Códigos: Draft, Posted, Reversed, Cancelled
   ================================================================================ *@
@{
    ViewData["Title"] = "Estados de Asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .jes-code { font-size: .85rem; color: #7dd3fc; font-family: monospace; font-weight: 600; }
</style>

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="text-white mb-0">
                <i class="bi bi-signpost-split me-2 text-info"></i>Estados de Asiento
            </h4>
            <small class="text-muted">
                Catálogo central compartido por todas las compañías —
                define los estados del ciclo de vida de los asientos de diario
            </small>
        </div>
        <button class="btn btn-primary" onclick="JES.openNew()">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Estado
        </button>
    </div>

    <!-- Alert página -->
    <div id="jesAlert" class="alert d-none mb-3" role="alert"></div>

    <!-- Tabla -->
    <div class="card bg-dark border-secondary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">Orden</th>
                            <th style="width:120px;">Código</th>
                            <th>Descripción</th>
                            <th class="text-center">Icono</th>
                            <th class="text-center" style="width:100px;">Color</th>
                            <th class="text-center" style="width:80px;">Activo</th>
                            <th style="width:110px;"></th>
                        </tr>
                    </thead>
                    <tbody id="bodyJES">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="bi bi-hourglass-split me-1"></i>Cargando…
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL CREAR / EDITAR
     ============================================================ -->
<div class="modal fade" id="jesModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="jesModalTitle">
                    <i class="bi bi-signpost-split me-2 text-info"></i>Estado de Asiento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="jesId">
                <div id="jesModalAlert" class="alert d-none" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label">Código *
                            <small>(máx. 30)</small>
                        </label>
                        <input type="text" id="jesCode" class="form-control" maxlength="30"
                               placeholder="Ej: Draft">
                        <small>Debe coincidir con el valor usado en sinai.journal_entry.status</small>
                    </div>
                    <div class="col-12 col-md-7">
                        <label class="form-label">Descripción</label>
                        <input type="text" id="jesDesc" class="form-control" maxlength="100"
                               placeholder="Ej: Borrador">
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Icono Bootstrap Icons</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary">
                                <i id="jesIconPreview" class="bi bi-question-circle text-info"></i>
                            </span>
                            <input type="text" id="jesIcon" class="form-control" maxlength="50"
                                   placeholder="Ej: bi-pencil-square" oninput="JES.previewIcon(this.value)">
                        </div>
                        <small>Clase de Bootstrap Icons</small>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Color Bootstrap</label>
                        <select id="jesColor" class="form-select">
                            <option value="">Sin color</option>
                            <option value="primary">primary — Azul</option>
                            <option value="secondary">secondary — Gris</option>
                            <option value="success">success — Verde</option>
                            <option value="danger">danger — Rojo</option>
                            <option value="warning">warning — Amarillo</option>
                            <option value="info">info — Celeste</option>
                            <option value="light">light — Claro</option>
                            <option value="dark">dark — Oscuro</option>
                        </select>
                        <small>Color del badge en la UI (ej: warning para Draft)</small>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="jesOrder" class="form-control" min="0" step="10" value="10">
                    </div>
                    <div class="col-6 col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="jesActive" checked>
                            <label class="form-check-label" for="jesActive">Activo</label>
                            <div><small>Disponible para usar</small></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="JES.save()">
                    <i class="bi bi-floppy me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal desactivar -->
<div class="modal fade" id="jesDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light">
            <div class="modal-header border-danger">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Desactivar
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea desactivar el estado <strong id="jesDeleteCode"></strong>?</p>
                <small class="text-muted">
                    Los asientos existentes con este estado no se verán afectados.
                </small>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="JES.confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.JES_API   = '@ViewBag.ApiBaseUrl';
    window.JES_TOKEN = '@ViewBag.ApiToken';
</script>
<script src="~/js/journalEntryStatus.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        ['jesModal', 'jesDeleteModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });
    });
</script>
}
