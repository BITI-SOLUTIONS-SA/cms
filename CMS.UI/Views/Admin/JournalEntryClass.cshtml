@* ================================================================================
   VISTA: CMS.UI/Views/Admin/JournalEntryClass.cshtml
   PROPÓSITO: Mantenimiento del catálogo admin.journal_entry_class
   TABLA:     admin.journal_entry_class  (BD central: cms)
   DESCRIPCIÓN: Clasifica los asientos de diario según su naturaleza contable.
                Códigos: N=Normal, C=Closing, D=Exchange Rate Differential, B=Banks
   ================================================================================ *@
@{
    ViewData["Title"] = "Clases de Asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .jec-code { font-size: .85rem; color: #7dd3fc; font-family: monospace; font-weight: 600; }
</style>

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="text-white mb-0">
                <i class="bi bi-bookmark-check me-2 text-info"></i>Clases de Asiento
            </h4>
            <small class="text-muted">
                Catálogo central compartido por todas las compañías —
                clasifica los asientos de diario según su naturaleza contable
            </small>
        </div>
        <button class="btn btn-primary" onclick="JEC.openNew()">
            <i class="bi bi-plus-lg me-1"></i>Nueva Clase
        </button>
    </div>

    <!-- Alert página -->
    <div id="jecAlert" class="alert d-none mb-3" role="alert"></div>

    <!-- Tabla -->
    <div class="card bg-dark border-secondary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">Orden</th>
                            <th style="width:80px;">Código</th>
                            <th>Descripción</th>
                            <th class="text-center">Icono</th>
                            <th class="text-center" style="width:80px;">Activo</th>
                            <th style="width:110px;"></th>
                        </tr>
                    </thead>
                    <tbody id="bodyJEC">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">
                                <i class="bi bi-hourglass-split me-1"></i>Cargando…
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL CREAR / EDITAR
     ============================================================ -->
<div class="modal fade" id="jecModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="jecModalTitle">
                    <i class="bi bi-bookmark-check me-2 text-info"></i>Clase de Asiento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="jecId">
                <div id="jecModalAlert" class="alert d-none" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Código *
                            <small>(máx. 30 — mayúsculas)</small>
                        </label>
                        <input type="text" id="jecCode" class="form-control text-uppercase" maxlength="30"
                               placeholder="Ej: N">
                        <small>Identificador único de la clase</small>
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label">Descripción</label>
                        <input type="text" id="jecDesc" class="form-control" maxlength="100"
                               placeholder="Ej: Normal">
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Icono Bootstrap Icons</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary">
                                <i id="jecIconPreview" class="bi bi-question-circle text-info"></i>
                            </span>
                            <input type="text" id="jecIcon" class="form-control" maxlength="50"
                                   placeholder="Ej: bi-journal-text" oninput="JEC.previewIcon(this.value)">
                        </div>
                        <small>Clase de Bootstrap Icons</small>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="jecOrder" class="form-control" min="0" step="10" value="10">
                    </div>
                    <div class="col-6 col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="jecActive" checked>
                            <label class="form-check-label" for="jecActive">Activo</label>
                            <div><small>Disponible para usar</small></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="JEC.save()">
                    <i class="bi bi-floppy me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal desactivar -->
<div class="modal fade" id="jecDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light">
            <div class="modal-header border-danger">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Desactivar
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea desactivar la clase de asiento <strong id="jecDeleteCode"></strong>?</p>
                <small class="text-muted">
                    Los asientos existentes con esta clase no se verán afectados.
                </small>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="JEC.confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.JEC_API   = '@ViewBag.ApiBaseUrl';
    window.JEC_TOKEN = '@ViewBag.ApiToken';
</script>
<script src="~/js/journalEntryClass.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        ['jecModal', 'jecDeleteModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });
    });
</script>
}
