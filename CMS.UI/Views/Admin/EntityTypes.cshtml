@* PROPÓSITO: Gestión de Entity Types (Tipos de Entidad del Sistema)               *@
@* AUTOR: BITI SOLUTIONS S.A                                                        *@
@* CREADO: 2025-01-22                                                               *@
@* ================================================================================ *@

@{
    ViewData["Title"] = "Entity Types";
}

<div class="content-container">
    <!-- ===== HEADER ===== -->
    <div class="page-header mb-4">
        <div class="page-header-content">
            <h1><i class="bi bi-diagram-3 me-2"></i>Entity Types</h1>
            <p class="text-muted mb-0">Tipos de entidad del sistema (DOC, JOU, EMP, SUP, CUS, INV, etc.)</p>
        </div>
        <div class="page-header-actions">
            <button type="button" class="btn btn-tech-primary" data-bs-toggle="modal" data-bs-target="#modalEntityType">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Entity Type
            </button>
        </div>
    </div>

    <!-- ===== ALERTAS ===== -->
    <div id="alert-container"></div>

    <!-- ===== TABLA ===== -->
    <div class="card bg-dark-card border-0">
        <div class="card-header bg-dark-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Tipos de Entidad</h5>
            <div class="input-group" style="max-width: 300px;">
                <input type="text" id="searchInput" class="form-control bg-dark text-light" placeholder="Buscar...">
                <button class="btn btn-outline-secondary" type="button">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" id="tableEntityTypes">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th style="width: 100px;">Orden</th>
                            <th style="width: 100px;">Estado</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL CREAR/EDITAR ===== -->
<div class="modal fade" id="modalEntityType" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="modalTitle">
                    <i class="bi bi-diagram-3 me-2"></i><span id="modalTitleText">Nuevo Entity Type</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEntityType">
                    <input type="hidden" id="entityTypeId">

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="code" class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="code" maxlength="10" required>
                            <small class="text-muted">Máx. 10 caracteres</small>
                        </div>
                        <div class="col-md-8">
                            <label for="name" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light" id="name" maxlength="100" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Descripción</label>
                        <textarea class="form-control bg-dark text-light" id="description" rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="sortOrder" class="form-label">Orden</label>
                            <input type="number" class="form-control bg-dark text-light" id="sortOrder" value="0" min="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label d-block">Estado</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label" for="isActive">Activo</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="ET.save()">
                    <i class="bi bi-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Entity Types Module
const ET = {
    data: [],

    init() {
        this.loadData();
        this.setupSearch();
        this.setupModal();
    },

    async loadData() {
        try {
            const response = await fetch('/api/EntityType');
            if (!response.ok) throw new Error('Error cargando entity types');

            this.data = await response.json();
            this.renderTable();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando datos', 'danger');
        }
    },

    renderTable() {
        const tbody = document.querySelector('#tableEntityTypes tbody');
        if (!this.data.length) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No hay entity types registrados
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = this.data.map(item => `
            <tr>
                <td><code class="text-info">${this.escapeHtml(item.code)}</code></td>
                <td class="fw-semibold">${this.escapeHtml(item.name)}</td>
                <td class="text-muted small">${this.escapeHtml(item.description || '')}</td>
                <td>${item.sortOrder}</td>
                <td>
                    ${item.isActive 
                        ? '<span class="badge bg-success">Activo</span>' 
                        : '<span class="badge bg-secondary">Inactivo</span>'}
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="ET.edit(${item.id})" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="ET.confirmDelete(${item.id})" title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    },

    setupSearch() {
        const searchInput = document.getElementById('searchInput');
        searchInput?.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#tableEntityTypes tbody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(term) ? '' : 'none';
            });
        });
    },

    setupModal() {
        const modal = document.getElementById('modalEntityType');
        modal?.addEventListener('hidden.bs.modal', () => this.resetForm());
    },

    resetForm() {
        document.getElementById('formEntityType').reset();
        document.getElementById('entityTypeId').value = '';
        document.getElementById('modalTitleText').textContent = 'Nuevo Entity Type';
        document.getElementById('isActive').checked = true;
    },

    async edit(id) {
        try {
            const response = await fetch(`/api/EntityType/${id}`);
            if (!response.ok) throw new Error('Error cargando entity type');

            const data = await response.json();
            document.getElementById('entityTypeId').value = data.id;
            document.getElementById('code').value = data.code;
            document.getElementById('name').value = data.name;
            document.getElementById('description').value = data.description || '';
            document.getElementById('sortOrder').value = data.sortOrder;
            document.getElementById('isActive').checked = data.isActive;
            document.getElementById('modalTitleText').textContent = 'Editar Entity Type';

            new bootstrap.Modal(document.getElementById('modalEntityType')).show();
        } catch (error) {
            console.error(error);
            this.showAlert('Error cargando datos', 'danger');
        }
    },

    async save() {
        const id = document.getElementById('entityTypeId').value;
        const dto = {
            code: document.getElementById('code').value.trim(),
            name: document.getElementById('name').value.trim(),
            description: document.getElementById('description').value.trim(),
            sortOrder: parseInt(document.getElementById('sortOrder').value),
            isActive: document.getElementById('isActive').checked
        };

        if (!dto.code || !dto.name) {
            this.showAlert('Complete los campos obligatorios', 'warning');
            return;
        }

        try {
            const url = id ? `/api/EntityType/${id}` : '/api/EntityType';
            const method = id ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Error guardando');
            }

            bootstrap.Modal.getInstance(document.getElementById('modalEntityType')).hide();
            this.showAlert(id ? 'Entity type actualizado exitosamente' : 'Entity type creado exitosamente', 'success');
            this.loadData();
        } catch (error) {
            console.error(error);
            this.showAlert(error.message, 'danger');
        }
    },

    async confirmDelete(id) {
        if (!confirm('¿Está seguro de eliminar este entity type?')) return;

        try {
            const response = await fetch(`/api/EntityType/${id}`, { method: 'DELETE' });
            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Error eliminando');
            }

            this.showAlert('Entity type eliminado exitosamente', 'success');
            this.loadData();
        } catch (error) {
            console.error(error);
            this.showAlert(error.message, 'danger');
        }
    },

    showAlert(message, type) {
        const container = document.getElementById('alert-container');
        const alert = `
            <div class="alert alert-${type} alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'}-fill me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        container.innerHTML = alert;
        setTimeout(() => container.innerHTML = '', 5000);
    },

    escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
};

// Inicializar al cargar la página
document.addEventListener('DOMContentLoaded', () => ET.init());

// Mover modales al body para evitar conflictos con el sidebar
document.addEventListener('DOMContentLoaded', function () {
    ['modalEntityType'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) document.body.appendChild(el);
    });
});
</script>

<style>
    .bg-dark-card { background: linear-gradient(135deg, #1a1f36 0%, #252b47 100%); }
    .bg-dark-header { background: rgba(0, 0, 0, 0.2); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
    .table-dark { --bs-table-bg: transparent; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
</style>
}
