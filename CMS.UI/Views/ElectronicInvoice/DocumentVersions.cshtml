@{
    ViewData["Title"] = "Versiones de Documento Electrónico";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .edv-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    /* La tabla usa fondo claro; el texto debe ser OSCURO para contrastar */
    .edv-table { color: #1e293b; background-color: #ffffff; }
    .edv-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .edv-table td, .edv-table th { border-color: #cbd5e1; vertical-align: middle; }
    .edv-table td { color: #1e293b; }
    /* Texto secundario dentro de la tabla: gris oscuro legible sobre fondo claro */
    .edv-table td small, .edv-table td .text-muted, .edv-table .text-muted { color: #475569 !important; }
    .edv-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-layers me-2"></i>Versiones de Documento Electrónico</h4>
        <div>
            <a asp-action="DocumentTypes" class="btn btn-outline-light btn-sm"><i class="bi bi-file-earmark-ruled"></i> Tipos</a>
            <button id="edvNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nueva versión</button>
        </div>
    </div>

    <div class="card edv-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central (<code>admin.electronic_document_version</code>) de versiones del esquema de Hacienda CR.
                <strong>Solo una versión puede estar marcada como vigente</strong>; esa es la que el sistema usa para
                generar los documentos electrónicos.
            </p>
            <div class="table-responsive">
                <table class="table edv-table align-middle">
                    <thead>
                        <tr>
                            <th>Versión</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Vigencia</th>
                            <th class="text-center">Vigente</th>
                            <th class="text-center">Activo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="edvTableBody">
                        <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="edvModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="edvModalTitle">Editar versión</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="f_id" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Código</label>
                        <input type="text" id="f_code" class="form-control" maxlength="10" placeholder="4.4" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Nombre</label>
                        <input type="text" id="f_name" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <input type="text" id="f_description" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de vigencia</label>
                        <input type="date" id="f_effectiveDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Orden</label>
                        <input type="number" id="f_sortOrder" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notas</label>
                        <textarea id="f_notes" class="form-control" rows="2" maxlength="2000"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="f_isActive" />
                            <label class="form-check-label" for="f_isActive">Activo</label>
                        </div>
                        <small class="form-text">La marca de <strong>versión vigente</strong> se cambia desde el botón "Marcar vigente" de la tabla.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="edvSaveBtn">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.EDV_API   = '@Html.Raw(apiBaseUrl)';
    window.EDV_TOKEN = '@Html.Raw(apiToken)';
</script>
<script>
(function () {
    const EDV = { api: window.EDV_API || '', token: window.EDV_TOKEN || '' };
    let modal;
    let cache = [];

    async function edvFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (EDV.token) opts.headers['Authorization'] = `Bearer ${EDV.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(EDV.api + path, opts);
    }

    function boolBadge(v, yes, no) {
        return v
            ? `<span class="badge bg-success badge-flag">${yes || 'Sí'}</span>`
            : `<span class="badge bg-secondary badge-flag">${no || 'No'}</span>`;
    }

    const fmtDate = (d) => d ? new Date(d).toISOString().substring(0, 10) : '';

    async function loadVersions() {
        const body = document.getElementById('edvTableBody');
        try {
            const r = await edvFetch('/api/electronicdocumentversion');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            cache = await r.json();
            if (!cache.length) {
                body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Sin registros.</td></tr>';
                return;
            }
            body.innerHTML = cache.map(v => `
                <tr>
                    <td><span class="edv-code">${v.code}</span></td>
                    <td>${v.name || ''}</td>
                    <td><small class="text-muted">${v.description || ''}</small></td>
                    <td class="text-center"><small>${fmtDate(v.effectiveDate)}</small></td>
                    <td class="text-center">${boolBadge(v.isCurrent, 'Vigente')}</td>
                    <td class="text-center">${boolBadge(v.isActive)}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-info" data-edit="${v.id}"><i class="bi bi-pencil"></i></button>
                        ${v.isCurrent ? '' : `<button class="btn btn-sm btn-outline-success" data-current="${v.id}" title="Marcar como vigente"><i class="bi bi-check2-circle"></i></button>`}
                    </td>
                </tr>`).join('');
            body.querySelectorAll('[data-edit]').forEach(btn =>
                btn.addEventListener('click', () => openEdit(parseInt(btn.dataset.edit, 10))));
            body.querySelectorAll('[data-current]').forEach(btn =>
                btn.addEventListener('click', () => setCurrent(parseInt(btn.dataset.current, 10))));
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    const setV = (id, val) => { document.getElementById(id).value = val ?? ''; };
    const setC = (id, val) => { document.getElementById(id).checked = !!val; };
    const getV = (id) => document.getElementById(id).value;
    const getC = (id) => document.getElementById(id).checked;

    function openNew() {
        document.getElementById('edvModalTitle').textContent = 'Nueva versión';
        setV('f_id', '');
        setV('f_code', '');
        setV('f_name', '');
        setV('f_description', '');
        setV('f_effectiveDate', '');
        setV('f_sortOrder', (cache.length + 1).toString());
        setV('f_notes', '');
        setC('f_isActive', true);
        modal.show();
    }

    function openEdit(id) {
        const v = cache.find(x => x.id === id);
        if (!v) return;
        document.getElementById('edvModalTitle').textContent = 'Editar versión';
        setV('f_id', v.id);
        setV('f_code', v.code);
        setV('f_name', v.name);
        setV('f_description', v.description);
        setV('f_effectiveDate', fmtDate(v.effectiveDate));
        setV('f_sortOrder', v.sortOrder);
        setV('f_notes', v.notes);
        setC('f_isActive', v.isActive);
        modal.show();
    }

    async function save() {
        const idStr = getV('f_id');
        const id = idStr ? parseInt(idStr, 10) : 0;
        const original = cache.find(x => x.id === id) || {};
        const payload = Object.assign({}, original, {
            code: getV('f_code'),
            name: getV('f_name'),
            description: getV('f_description') || null,
            effectiveDate: getV('f_effectiveDate') || null,
            sortOrder: parseInt(getV('f_sortOrder'), 10) || 0,
            notes: getV('f_notes') || null,
            isActive: getC('f_isActive')
        });

        const btn = document.getElementById('edvSaveBtn');
        btn.disabled = true;
        try {
            const r = id
                ? await edvFetch(`/api/electronicdocumentversion/${id}`, { method: 'PUT', body: JSON.stringify(payload) })
                : await edvFetch(`/api/electronicdocumentversion`, { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            modal.hide();
            await loadVersions();
        } catch (e) {
            console.error(e);
            alert('No se pudo guardar la versión.');
        } finally {
            btn.disabled = false;
        }
    }

    async function setCurrent(id) {
        if (!confirm('¿Marcar esta versión como la vigente? El sistema la usará para generar los documentos electrónicos.')) return;
        try {
            const r = await edvFetch(`/api/electronicdocumentversion/${id}/current`, { method: 'PUT' });
            if (!r.ok) throw new Error('HTTP ' + r.status);
            await loadVersions();
        } catch (e) {
            console.error(e);
            alert('No se pudo marcar la versión como vigente.');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const el = document.getElementById('edvModal');
        if (el) document.body.appendChild(el);
        modal = new bootstrap.Modal(el);
        document.getElementById('edvSaveBtn').addEventListener('click', save);
        document.getElementById('edvNewBtn').addEventListener('click', openNew);
        loadVersions();
    });
})();
</script>
}
