@{
    ViewData["Title"] = "Tipos de Impuesto";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .dtt-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    .dtt-table { color: #1e293b; background-color: #ffffff; }
    .dtt-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .dtt-table td, .dtt-table th { border-color: #cbd5e1; vertical-align: middle; }
    .dtt-table td { color: #1e293b; }
    .dtt-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
    .dtt-table td small, .dtt-table .text-muted { color: #475569 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-percent-square me-2"></i>Tipos de Impuesto</h4>
        <div>
            <a asp-action="TaxRates" class="btn btn-outline-light btn-sm"><i class="bi bi-percent"></i> Códigos de Tarifa</a>
            <a asp-action="Discounts" class="btn btn-outline-light btn-sm"><i class="bi bi-percent"></i> Códigos de Descuento</a>
            <a asp-action="PaymentMethods" class="btn btn-outline-light btn-sm"><i class="bi bi-credit-card"></i> Medios de Pago</a>
            <button id="dttNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo tipo</button>
        </div>
    </div>

    <div class="card dtt-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central de <strong>tipos de impuesto del Ministerio de Hacienda</strong>
                (<code>CodigoImpuesto</code>, formato <code>00</code>). Es compartido por todas las compañías.
                Los códigos marcados como <strong>activos</strong> aparecen en el selector de impuesto de las líneas
                en la pantalla de emisión <em>"/ElectronicInvoice/Emit"</em> y como tipo de impuesto por defecto de cada artículo.
            </p>

            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-light">Buscar (código o descripción)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="dttSearch" class="form-control" placeholder="Ej: IVA..." />
                        <button class="btn btn-outline-info" type="button" id="dttSearchBtn"><i class="bi bi-search"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="dttSearchClear" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="dttOnlyActive" />
                        <label class="form-check-label" for="dttOnlyActive">Solo activos</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table dtt-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 90px;">Código</th>
                            <th>Descripción</th>
                            <th class="text-center" style="width: 110px;">Orden</th>
                            <th class="text-center" style="width: 120px;">Req. Tarifa</th>
                            <th class="text-center" style="width: 90px;">Activo</th>
                            <th class="text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="dttTableBody">
                        <tr><td colspan="6" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-light" id="dttInfo"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-light" id="dttPrev"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-light" id="dttNext"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="dttModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="dttModalTitle">Editar tipo</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="f_id" />
                <div class="row g-2">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Código</label>
                        <input type="text" id="f_code" class="form-control" maxlength="2" placeholder="00" />
                        <small class="form-text">Formato Hacienda: 00</small>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="f_sortOrder" class="form-control" min="0" max="999" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="f_description" class="form-control" rows="2" maxlength="200"></textarea>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="f_requiresTaxRate" />
                    <label class="form-check-label" for="f_requiresTaxRate">Requiere código de tarifa (muestra el selector de tarifa en el modal de impuesto)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="f_isActive" checked />
                    <label class="form-check-label" for="f_isActive">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="dttSaveBtn"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const DTT = { api: '@Html.Raw(apiBaseUrl)', token: '@Html.Raw(apiToken)' };
    let dttPage = 1, dttPageSize = 50, dttTotal = 0;

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    async function dttFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (DTT.token) opts.headers['Authorization'] = `Bearer ${DTT.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(DTT.api + path, opts);
    }

    function boolBadge(v) {
        return v
            ? '<span class="badge bg-success badge-flag">Sí</span>'
            : '<span class="badge bg-secondary badge-flag">No</span>';
    }

    async function loadTaxTypes() {
        const body = document.getElementById('dttTableBody');
        body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Cargando...</td></tr>';
        const search = document.getElementById('dttSearch').value.trim();
        const onlyActive = document.getElementById('dttOnlyActive').checked;
        const qs = new URLSearchParams({ page: dttPage, pageSize: dttPageSize, onlyActive });
        if (search) qs.set('search', search);
        try {
            const r = await dttFetch('/api/electronicdocumenttaxtype?' + qs.toString());
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            dttTotal = data.total;
            const rows = data.items || [];
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Sin resultados.</td></tr>';
            } else {
                body.innerHTML = rows.map(a => `
                    <tr>
                        <td><span class="dtt-code">${escapeHtml(a.code)}</span></td>
                        <td>${escapeHtml(a.description)}</td>
                        <td class="text-center">${a.sortOrder ?? 0}</td>
                        <td class="text-center">${boolBadge(a.requiresTaxRate)}</td>
                        <td class="text-center">${boolBadge(a.isActive)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick='dttEdit(${JSON.stringify(a).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="dttDelete(${a.id})"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`).join('');
            }
            const from = dttTotal === 0 ? 0 : (dttPage - 1) * dttPageSize + 1;
            const to = Math.min(dttPage * dttPageSize, dttTotal);
            document.getElementById('dttInfo').textContent = `Mostrando ${from}-${to} de ${dttTotal}`;
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    function dttOpenModal(title) {
        document.getElementById('dttModalTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('dttModal')).show();
    }

    function dttNew() {
        document.getElementById('f_id').value = '';
        document.getElementById('f_code').value = '';
        document.getElementById('f_description').value = '';
        document.getElementById('f_sortOrder').value = '0';
        document.getElementById('f_requiresTaxRate').checked = false;
        document.getElementById('f_isActive').checked = true;
        document.getElementById('f_code').disabled = false;
        dttOpenModal('Nuevo tipo de impuesto');
    }

    function dttEdit(a) {
        document.getElementById('f_id').value = a.id;
        document.getElementById('f_code').value = a.code;
        document.getElementById('f_description').value = a.description;
        document.getElementById('f_sortOrder').value = a.sortOrder ?? 0;
        document.getElementById('f_requiresTaxRate').checked = !!a.requiresTaxRate;
        document.getElementById('f_isActive').checked = a.isActive;
        document.getElementById('f_code').disabled = false;
        dttOpenModal('Editar tipo de impuesto');
    }

    async function dttSave() {
        const id = document.getElementById('f_id').value;
        const payload = {
            code: document.getElementById('f_code').value.trim(),
            description: document.getElementById('f_description').value.trim(),
            sortOrder: parseInt(document.getElementById('f_sortOrder').value, 10) || 0,
            requiresTaxRate: document.getElementById('f_requiresTaxRate').checked,
            isActive: document.getElementById('f_isActive').checked
        };
        if (!payload.code || !payload.description) {
            alert('Código y descripción son obligatorios.');
            return;
        }
        try {
            const r = id
                ? await dttFetch('/api/electronicdocumenttaxtype/' + id, { method: 'PUT', body: JSON.stringify(payload) })
                : await dttFetch('/api/electronicdocumenttaxtype', { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al guardar.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('dttModal')).hide();
            await loadTaxTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    async function dttDelete(id) {
        if (!confirm('¿Eliminar este tipo de impuesto?')) return;
        try {
            const r = await dttFetch('/api/electronicdocumenttaxtype/' + id, { method: 'DELETE' });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al eliminar.');
                return;
            }
            await loadTaxTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Mover modal al body para evitar problemas de z-index con el sidebar
        ['dttModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        document.getElementById('dttNewBtn').addEventListener('click', dttNew);
        document.getElementById('dttSaveBtn').addEventListener('click', dttSave);
        document.getElementById('dttSearchBtn').addEventListener('click', () => { dttPage = 1; loadTaxTypes(); });
        document.getElementById('dttSearch').addEventListener('keyup', e => { if (e.key === 'Enter') { dttPage = 1; loadTaxTypes(); } });
        document.getElementById('dttSearchClear').addEventListener('click', () => { document.getElementById('dttSearch').value = ''; dttPage = 1; loadTaxTypes(); });
        document.getElementById('dttOnlyActive').addEventListener('change', () => { dttPage = 1; loadTaxTypes(); });
        document.getElementById('dttPrev').addEventListener('click', () => { if (dttPage > 1) { dttPage--; loadTaxTypes(); } });
        document.getElementById('dttNext').addEventListener('click', () => { if (dttPage * dttPageSize < dttTotal) { dttPage++; loadTaxTypes(); } });

        loadTaxTypes();
    });
</script>
}
