@model string
@{ var env = Model; var suffix = env == "prod" ? "Prod" : "Stag"; }
@*
    PARTIAL: _CredentialForm — formulario de credenciales por ambiente (stag/prod).
    El data-env indica el ambiente al que pertenecen los campos.
*@
<div class="credential-form" data-env="@env">
    <div class="mb-2 small text-muted">
        <i class="bi bi-info-circle"></i>
        @(env == "prod"
            ? "Credenciales REALES de producción. Úselas solo tras aprobar las pruebas ante Hacienda."
            : "Credenciales de PRUEBAS (sandbox). Se usan primero para validar antes de producción.")
    </div>
    <div class="mb-2 small" id="certInfo@(suffix)">
        <span class="badge bg-warning">Sin certificado</span>
    </div>
    <div class="mb-3">
        <label class="form-label">Archivo .p12 / .pfx</label>
        <input type="file" id="c_file@(suffix)" class="form-control form-control-sm" accept=".p12,.pfx">
        <small class="form-text">Se cifra AES-256 en el servidor. Nunca se almacena en texto plano.</small>
    </div>
    <div class="mb-3"><label class="form-label">PIN del certificado</label>
        <input id="c_pin@(suffix)" type="password" class="form-control form-control-sm"></div>
    <hr class="text-muted">
    <div class="mb-3"><label class="form-label">Usuario OAuth Hacienda (@env)</label>
        <input id="c_oauthUser@(suffix)" class="form-control form-control-sm"
               placeholder="@(env == "prod" ? "cpf-...@@prod.comprobanteselectronicos.go.cr" : "cpf-...@@stag.comprobanteselectronicos.go.cr")"></div>
    <div class="mb-3"><label class="form-label">Clave OAuth Hacienda (@env)</label>
        <input id="c_oauthPass@(suffix)" type="password" class="form-control form-control-sm"></div>
    <button class="btn btn-sm @(env == "prod" ? "btn-danger" : "btn-success") saveCertBtn" data-env="@env" data-suffix="@suffix">
        <i class="bi bi-shield-check"></i> Cargar y cifrar (@env)
    </button>
</div>
