@{
    ViewData["Title"] = "Medios de Pago";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .pmc-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    .pmc-table { color: #1e293b; background-color: #ffffff; }
    .pmc-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .pmc-table td, .pmc-table th { border-color: #cbd5e1; vertical-align: middle; }
    .pmc-table td { color: #1e293b; }
    .pmc-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
    .pmc-table td small, .pmc-table .text-muted { color: #475569 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-credit-card me-2"></i>Medios de Pago</h4>
        <div>
            <a asp-action="SalesConditions" class="btn btn-outline-light btn-sm"><i class="bi bi-cash-coin"></i> Condiciones de Venta</a>
            <button id="pmcNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo medio de pago</button>
        </div>
    </div>

    <div class="card pmc-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central de <strong>medios de pago del Ministerio de Hacienda</strong>
                (<code>MedioPago</code> / <code>TipoMedioPago</code>, formato <code>00</code>). Es compartido por todas las compañías.
                Los medios marcados como <strong>activos</strong> aparecen en el selector de la pantalla de emisión
                <em>"/ElectronicInvoice/Emit"</em>, donde se pueden elegir uno o varios.
            </p>

            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-light">Buscar (código o descripción)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="pmcSearch" class="form-control" placeholder="Ej: Tarjeta..." />
                        <button class="btn btn-outline-info" type="button" id="pmcSearchBtn"><i class="bi bi-search"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="pmcSearchClear" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="pmcOnlyActive" />
                        <label class="form-check-label" for="pmcOnlyActive">Solo activos</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table pmc-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 90px;">Código</th>
                            <th>Descripción</th>
                            <th class="text-center" style="width: 110px;">Orden</th>
                            <th class="text-center" style="width: 90px;">Activo</th>
                            <th class="text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="pmcTableBody">
                        <tr><td colspan="5" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-light" id="pmcInfo"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-light" id="pmcPrev"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-light" id="pmcNext"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="pmcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="pmcModalTitle">Editar medio de pago</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="f_id" />
                <div class="row g-2">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Código</label>
                        <input type="text" id="f_code" class="form-control" maxlength="2" placeholder="00" />
                        <small class="form-text">Formato Hacienda: 00</small>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="f_sortOrder" class="form-control" min="0" max="999" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="f_description" class="form-control" rows="2" maxlength="200"></textarea>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="f_isActive" checked />
                    <label class="form-check-label" for="f_isActive">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="pmcSaveBtn"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const PMC = { api: '@Html.Raw(apiBaseUrl)', token: '@Html.Raw(apiToken)' };
    let pmcPage = 1, pmcPageSize = 50, pmcTotal = 0;

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    async function pmcFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (PMC.token) opts.headers['Authorization'] = `Bearer ${PMC.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(PMC.api + path, opts);
    }

    function boolBadge(v) {
        return v
            ? '<span class="badge bg-success badge-flag">Sí</span>'
            : '<span class="badge bg-secondary badge-flag">No</span>';
    }

    async function loadMethods() {
        const body = document.getElementById('pmcTableBody');
        body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Cargando...</td></tr>';
        const search = document.getElementById('pmcSearch').value.trim();
        const onlyActive = document.getElementById('pmcOnlyActive').checked;
        const qs = new URLSearchParams({ page: pmcPage, pageSize: pmcPageSize, onlyActive });
        if (search) qs.set('search', search);
        try {
            const r = await pmcFetch('/api/electronicdocumentpaymentmethod?' + qs.toString());
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            pmcTotal = data.total;
            const rows = data.items || [];
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Sin resultados.</td></tr>';
            } else {
                body.innerHTML = rows.map(a => `
                    <tr>
                        <td><span class="pmc-code">${escapeHtml(a.code)}</span></td>
                        <td>${escapeHtml(a.description)}</td>
                        <td class="text-center">${a.sortOrder ?? 0}</td>
                        <td class="text-center">${boolBadge(a.isActive)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick='pmcEdit(${JSON.stringify(a).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="pmcDelete(${a.id})"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`).join('');
            }
            const from = pmcTotal === 0 ? 0 : (pmcPage - 1) * pmcPageSize + 1;
            const to = Math.min(pmcPage * pmcPageSize, pmcTotal);
            document.getElementById('pmcInfo').textContent = `Mostrando ${from}-${to} de ${pmcTotal}`;
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    function pmcOpenModal(title) {
        document.getElementById('pmcModalTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('pmcModal')).show();
    }

    function pmcNew() {
        document.getElementById('f_id').value = '';
        document.getElementById('f_code').value = '';
        document.getElementById('f_description').value = '';
        document.getElementById('f_sortOrder').value = '0';
        document.getElementById('f_isActive').checked = true;
        document.getElementById('f_code').disabled = false;
        pmcOpenModal('Nuevo medio de pago');
    }

    function pmcEdit(a) {
        document.getElementById('f_id').value = a.id;
        document.getElementById('f_code').value = a.code;
        document.getElementById('f_description').value = a.description;
        document.getElementById('f_sortOrder').value = a.sortOrder ?? 0;
        document.getElementById('f_isActive').checked = a.isActive;
        document.getElementById('f_code').disabled = false;
        pmcOpenModal('Editar medio de pago');
    }

    async function pmcSave() {
        const id = document.getElementById('f_id').value;
        const payload = {
            code: document.getElementById('f_code').value.trim(),
            description: document.getElementById('f_description').value.trim(),
            sortOrder: parseInt(document.getElementById('f_sortOrder').value, 10) || 0,
            isActive: document.getElementById('f_isActive').checked
        };
        if (!payload.code || !payload.description) {
            alert('Código y descripción son obligatorios.');
            return;
        }
        try {
            const r = id
                ? await pmcFetch('/api/electronicdocumentpaymentmethod/' + id, { method: 'PUT', body: JSON.stringify(payload) })
                : await pmcFetch('/api/electronicdocumentpaymentmethod', { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al guardar.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('pmcModal')).hide();
            await loadMethods();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    async function pmcDelete(id) {
        if (!confirm('¿Eliminar este medio de pago?')) return;
        try {
            const r = await pmcFetch('/api/electronicdocumentpaymentmethod/' + id, { method: 'DELETE' });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al eliminar.');
                return;
            }
            await loadMethods();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Mover modal al body para evitar problemas de z-index con el sidebar
        ['pmcModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        document.getElementById('pmcNewBtn').addEventListener('click', pmcNew);
        document.getElementById('pmcSaveBtn').addEventListener('click', pmcSave);
        document.getElementById('pmcSearchBtn').addEventListener('click', () => { pmcPage = 1; loadMethods(); });
        document.getElementById('pmcSearch').addEventListener('keyup', e => { if (e.key === 'Enter') { pmcPage = 1; loadMethods(); } });
        document.getElementById('pmcSearchClear').addEventListener('click', () => { document.getElementById('pmcSearch').value = ''; pmcPage = 1; loadMethods(); });
        document.getElementById('pmcOnlyActive').addEventListener('change', () => { pmcPage = 1; loadMethods(); });
        document.getElementById('pmcPrev').addEventListener('click', () => { if (pmcPage > 1) { pmcPage--; loadMethods(); } });
        document.getElementById('pmcNext').addEventListener('click', () => { if (pmcPage * pmcPageSize < pmcTotal) { pmcPage++; loadMethods(); } });

        loadMethods();
    });
</script>
}
