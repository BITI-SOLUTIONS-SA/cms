                    </div>` : '') +
                    chip('Medio Pago Tipo', rf.medioPagoTipo, 'col-6 col-md-2') +
                    chip('Medio Pago Total', rf.medioPagoTotal, 'col-6 col-md-2') +
                    `<div class="col-12"><div style="background:#0c2a1e;border:1px solid #166534;border-radius:8px;padding:.6rem 1rem;display:flex;justify-content:space-between;align-items:center">
                        <span style="font-weight:700;text-transform:uppercase;font-size:.8rem;color:#86efac">Total Comprobante</span>
                        <span style="font-size:1.25rem;font-weight:800;color:#22c55e">${rf.totalComprobante} ${rf.codigoMoneda||''}</span>
                    </div></div>`
                ) : '';

                s8 = cabecera + emisorSec + receptorSec + rfSec;
            }

            // -- S9: Respuesta de Hacienda parseada (de BD) ----------
            let s9 = '';
            if (xr && xr.mensajeCodigo) {
                const msgColor = xr.mensajeCodigo==='1' ? '#22c55e' : xr.mensajeCodigo==='3' ? '#ef4444' : '#f59e0b';
                s9 = sec('bi-bank','Respuesta de Hacienda (detalle)',
                    `<div class="col-12"><div class="p-2 rounded mb-2" style="background:#111827;border:1px solid ${msgColor};font-size:.88rem">
                        <span style="color:${msgColor};font-weight:700;font-size:1rem">${MSG_CODE[xr.mensajeCodigo]||`Mensaje ${xr.mensajeCodigo}`}</span>
                        ${xr.detalleMensaje ? `<div style="margin-top:.35rem;color:#fde68a">${xr.detalleMensaje}</div>` : ''}
                    </div></div>` +
                    chip('Monto Total Impuesto', xr.montoImpuesto, 'col-6 col-md-3') +
                    chip('Total Factura', xr.totalFactura, 'col-6 col-md-3') +
                    chip('Fecha Emisión Doc.', fmtDate(xr.fechaEmisionDoc), 'col-6 col-md-3') +
                    chip('Fecha Recepción', fmtDate(xr.fechaRecepcion), 'col-6 col-md-3')
                );
            }

            body.innerHTML = rej + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9;

        } catch(e) {
            body.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error al cargar: ${e.message}</div>`;
        }
    }

    function copyXml() {
        if (!_xmlContent) return;
        navigator.clipboard.writeText(_xmlContent).then(() => {
            const btn = document.getElementById('xmlCopyBtn');
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Copiado';
            setTimeout(() => { btn.innerHTML = '<i class="bi bi-clipboard"></i> Copiar'; }, 2000);
        });
    }
    function downloadXml() {
        if (!_xmlContent) return;
        const a = document.createElement('a');
        a.href = 'data:text/xml;charset=utf-8,' + encodeURIComponent(_xmlContent);
        a.download = _xmlFilename; a.click();
    }
    function downloadPdf() {
        if (!_pdfBlob) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(_pdfBlob);
        a.download = _pdfFilename; a.click();
    }

    // ── Init: seguro sin importar si DOMContentLoaded ya disparó ──
    //    (Scripts se inyecta al final del body; el DOM ya está listo
    //     pero el evento puede haber disparado antes de este bloque)
    function initPage() {
        console.log('%c[EI] initPage() iniciando...', 'color:#6c63ff;font-weight:bold');
        console.log('[EI] document.readyState =', document.readyState);
        console.log('[EI] EI.api  =', EI.api);
        console.log('[EI] EI.token existe =', !!EI.token);

        // Mover modales al <body> para escapar del z-index del layout
        ['docDetailModal','xmlViewerModal','docViewerModal','pdfViewerModal','logViewerModal'].forEach(function (mid) {
            var el = document.getElementById(mid);
            if (el && el.parentNode !== document.body) {
                document.body.appendChild(el);
                console.log('[EI] Modal movido al body:', mid);
            } else if (!el) {
                console.warn('[EI] ⚠️ Modal NO encontrado en el DOM:', mid);
            }
        });

        // Listeners de los botones del modal de DETALLE
        var btnXmlS = document.getElementById('detailXmlSignedBtn');
        var btnXmlR = document.getElementById('detailXmlRespBtn');
        var btnPdf  = document.getElementById('detailPdfBtn');
        var btnCopy = document.getElementById('xmlCopyBtn');
        var btnDlXml= document.getElementById('xmlDownloadBtn');
        var btnDlPdf= document.getElementById('pdfDownloadBtn');

        console.log('[EI] Botones del modal de detalle encontrados:',
            { detailXmlSignedBtn: !!btnXmlS, detailXmlRespBtn: !!btnXmlR,
              detailPdfBtn: !!btnPdf, xmlCopyBtn: !!btnCopy,
              xmlDownloadBtn: !!btnDlXml, pdfDownloadBtn: !!btnDlPdf });

        if (btnXmlS)  btnXmlS.addEventListener('click',  function() { console.log('[EI] Click: XML Firmado, docId=', EI.activeDocId); openXmlForDoc(EI.activeDocId, 'signed');   });
        if (btnXmlR)  btnXmlR.addEventListener('click',  function() { console.log('[EI] Click: XML Respuesta, docId=', EI.activeDocId); openXmlForDoc(EI.activeDocId, 'response'); });
        if (btnPdf)   btnPdf.addEventListener('click',   function() { console.log('[EI] Click: PDF, docId=', EI.activeDocId); openPdfForDoc(EI.activeDocId); });
        if (btnCopy)  btnCopy.addEventListener('click',  copyXml);
        if (btnDlXml) btnDlXml.addEventListener('click', downloadXml);
        if (btnDlPdf) btnDlPdf.addEventListener('click', downloadPdf);

        // Expandir / colapsar XML
        var btnExpandAll  = document.getElementById('xmlExpandAllBtn');
        var btnCollapseAll= document.getElementById('xmlCollapseAllBtn');
        if (btnExpandAll)   btnExpandAll.addEventListener('click',  xmlExpandAll);
        if (btnCollapseAll) btnCollapseAll.addEventListener('click', xmlCollapseAll);

        console.log('%c[EI] initPage() completado ✅ — cargando lista...', 'color:#22c55e;font-weight:bold');

        // Cargar la lista de comprobantes
        load();
    }

    // Ejecutar inmediatamente si el DOM ya está listo, si no esperar el evento
    console.log('%c[EI] Script cargado. readyState =', 'color:#f59e0b;font-weight:bold', document.readyState);
    if (document.readyState === 'loading') {
        console.log('[EI] DOM aún cargando → esperando DOMContentLoaded');
        document.addEventListener('DOMContentLoaded', initPage);
    } else {
        console.log('[EI] DOM ya listo → ejecutando initPage() directamente');
        initPage();
    }
})();
</script>
}
