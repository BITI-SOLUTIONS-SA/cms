    function buildXmlTree(xmlString) {
        const container = document.getElementById('xmlViewerContent');
        container.innerHTML = '';
        let doc;
        try {
            doc = new DOMParser().parseFromString(xmlString, 'application/xml');
            const err = doc.querySelector('parsererror');
            if (err) throw new Error(err.textContent.substring(0, 200));
        } catch(e) {
            container.innerHTML = `<span style="color:#ef4444">Error al parsear XML: ${e.message}</span>`;
            return;
        }
        function esc(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
        function renderAttrs(el) {
            let html = '';
            for (const a of el.attributes) {
                const isNs = a.name.startsWith('xmlns');
                html += ` <span class="${isNs?'xns':'xa'}">${esc(a.name)}</span>=<span class="xv">&quot;${esc(a.value)}&quot;</span>`;
            }
            return html;
        }
        function renderNode(node, parentEl) {
            if (node.nodeType === Node.PROCESSING_INSTRUCTION_NODE) {
                const d = document.createElement('div'); d.className = 'xn';
                d.innerHTML = `<span class="xpi">&lt;?${esc(node.nodeName)} ${esc(node.nodeValue)}?&gt;</span>`;
                parentEl.appendChild(d); return;
            }
            if (node.nodeType === Node.COMMENT_NODE) {
                const d = document.createElement('div'); d.className = 'xn';
                d.innerHTML = `<span class="xcom">&lt;!-- ${esc(node.nodeValue)} --&gt;</span>`;
                parentEl.appendChild(d); return;
            }
            if (node.nodeType === Node.TEXT_NODE) {
                const t = node.nodeValue.trim(); if (!t) return;
                const d = document.createElement('div'); d.className = 'xn';
                d.innerHTML = `<span class="xval">${esc(t)}</span>`;
                parentEl.appendChild(d); return;
            }
            if (node.nodeType !== Node.ELEMENT_NODE) return;
            const tag = esc(node.nodeName);
            const attrs = renderAttrs(node);
            const kids = Array.from(node.childNodes).filter(c =>
                c.nodeType === Node.ELEMENT_NODE || c.nodeType === Node.COMMENT_NODE ||
                c.nodeType === Node.PROCESSING_INSTRUCTION_NODE ||
                (c.nodeType === Node.TEXT_NODE && c.nodeValue.trim())
            );
            if (kids.length === 0) {
                const d = document.createElement('div'); d.className = 'xn';
                const tv = node.textContent.trim();
                d.innerHTML = `<span class="xfold" style="visibility:hidden">&#9660;</span>` +
                    `<span class="xt">&lt;${tag}</span>${attrs}<span class="xt">&gt;</span>` +
                    (tv ? `<span class="xval">${esc(tv)}</span>` : '') +
                    `<span class="xt">&lt;/${tag}&gt;</span>`;
                parentEl.appendChild(d); return;
            }
            const folder = document.createElement('div'); folder.className = 'xfolder';
            const open = document.createElement('div'); open.className = 'xn';
            open.innerHTML = `<span class="xfold">&#9660;</span><span class="xt">&lt;${tag}</span>${attrs}<span class="xt">&gt;</span>`;
            folder.appendChild(open);
            const childEl = document.createElement('div'); childEl.className = 'xchildren';
            kids.forEach(c => renderNode(c, childEl));
            folder.appendChild(childEl);
            const close = document.createElement('div'); close.className = 'xn';
            close.innerHTML = `<span class="xt">&lt;/${tag}&gt;</span>`;
            folder.appendChild(close);
            open.querySelector('.xfold').addEventListener('click', e => {
                e.stopPropagation(); folder.classList.toggle('xcollapsed');
            });
            parentEl.appendChild(folder);
        }
        for (const c of doc.childNodes) renderNode(c, container);
    }
    function xmlExpandAll()   { document.querySelectorAll('#xmlViewerContent .xfolder').forEach(f => f.classList.remove('xcollapsed')); }
    function xmlCollapseAll() { document.querySelectorAll('#xmlViewerContent .xfolder').forEach(f => f.classList.add('xcollapsed'));    }

    // ── Vista Documento ─────────────────────────────────────────────
    async function openDocViewer(docId) {
        const modalEl = document.getElementById('docViewerModal');
        const modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
        const body    = document.getElementById('docViewerBody');
        const titleEl = document.getElementById('docViewerTitle');
        const subEl   = document.getElementById('docViewerSubtitle');

        body.innerHTML = `<div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2" style="color:#a5b4fc">Cargando documento...</p>
        </div>`;
        modal.show();

        try {
            const r = await eiFetch(`/api/electronicinvoice/${docId}`);
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            const d = await r.json();

            // ── Catálogos ──────────────────────────────────────────
            const SALE = {'01':'Contado','02':'Crédito','03':'Consignación',
                          '04':'Apartado','05':'Arrendamiento c/opción','06':'Arrendamiento s/opción',
                          '07':'Cobro a favor','08':'Pago serv. prestado','99':'Otros'};
            const PAY  = {'01':'Efectivo','02':'Tarjeta','03':'Cheque',
                          '04':'Transferencia','05':'Recaudado por terceros','99':'Otros'};
            const SIT  = {'1':'Normal','2':'Contingencia','3':'Sin internet'};
            const REFA = {'01':'Anula doc. referenciado','02':'Corrige doc. referenciado',
                          '03':'Sustituye doc. referenciado','04':'Ahorro en factura compra',
