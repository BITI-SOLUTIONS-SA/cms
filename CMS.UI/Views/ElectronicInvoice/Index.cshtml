@{
    ViewData["Title"] = "Comprobantes Electrónicos";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken   = ViewBag.ApiToken   as string ?? "";
}
@*
    VISTA: ElectronicInvoice/Index.cshtml — Listado de comprobantes emitidos.
    AUTOR: EAMR, BITI SOLUTIONS S.A
*@
<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .ei-card { background-color: #16213e; border: 1px solid #24304f; }

    /* Filas clickeables */
    #docsBody tr.doc-row { cursor: pointer; transition: background .15s; }
    #docsBody tr.doc-row:hover { background: #1e2d4a; }

    /* Modal detalle */
    #docDetailModal { z-index: 1060 !important; }
    #docDetailModal .modal-content {
        background: #1a2340; color: #e2e8f0;
        border: 1px solid #2a3a5c; border-radius: 16px;
        max-height: calc(100vh - 4rem);
        display: flex; flex-direction: column;
    }
    #docDetailModal .modal-header { border-bottom: 1px solid #2a3a5c; }
    #docDetailModal .modal-footer { border-top: 1px solid #2a3a5c; }
    #docDetailModal .modal-body   { overflow-y: auto; flex: 1 1 auto; }
    #docDetailModal .detail-label { color: #94a3b8; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
    #docDetailModal .detail-value { font-size: .925rem; font-weight: 600; }
    #docDetailModal .section-title {
        font-size: .78rem; text-transform: uppercase; letter-spacing: .06em;
        color: #6c63ff; border-bottom: 1px solid #2a3a5c; padding-bottom: .3rem; margin: 1rem 0 .6rem;
    }
    #docDetailModal .rejection-box {
        background: #3b0f0f; border: 1px solid #ef4444; border-radius: 8px;
        padding: .75rem 1rem; color: #fca5a5;
    }
    #docDetailModal .xml-box {
        background: #111827; border: 1px solid #2a3a5c; border-radius: 8px;
        padding: .6rem; font-size: .72rem; color: #94a3b8;
        max-height: 200px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;
    }
    #docDetailModal table thead th { background: #111827; color: #94a3b8; font-size: .72rem; }
    #docDetailModal table tbody td { font-size: .82rem; border-color: #2a3a5c; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>Comprobantes Electrónicos</h4>
        <div>
            <a asp-action="Issuers" class="btn btn-outline-light btn-sm"><i class="bi bi-building"></i> Emisores</a>
            <a asp-action="Emit" class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> Emitir</a>
        </div>
    </div>

    <div class="card ei-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-sm">
                    <thead>
                        <tr>
                            <th>Fecha</th><th>Tipo</th><th>Clave</th><th>Consecutivo</th>
                            <th>Estado</th><th>Hacienda</th><th class="text-end">Total</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="docsBody">
                        <tr><td colspan="8" class="text-center py-3" style="color:#a5b4fc;font-weight:500"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Cargando comprobantes...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: DETALLE DEL COMPROBANTE
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="docDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docDetailTitle">
                    <i class="bi bi-receipt-cutoff me-2"></i>Detalle del Comprobante
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="docDetailBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-info" role="status"></div>
                    <p class="mt-2 text-muted">Cargando detalle...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="detailXmlSignedBtn" class="btn btn-outline-info btn-sm d-none">
                    <i class="bi bi-filetype-xml"></i> XML Firmado
                </button>
                <button id="detailXmlRespBtn" class="btn btn-outline-secondary btn-sm d-none">
                    <i class="bi bi-code-slash"></i> XML Respuesta Hacienda
                </button>
                <button id="detailPdfBtn" class="btn btn-outline-danger btn-sm d-none">
                    <i class="bi bi-filetype-pdf"></i> Ver PDF
                </button>
                <button id="detailReprocessBtn" class="btn btn-outline-warning btn-sm d-none">
                    <i class="bi bi-arrow-repeat"></i> Reprocesar
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: VISOR XML — árbol interactivo estilo Edge
══════════════════════════════════════════════════════════ -->
<style>
/* ── XML Tree Viewer (estilo Edge) ─────────────────────────── */
.xml-tree {
    font-family: 'Cascadia Code','Fira Code','Consolas',monospace;
    font-size: .82rem; line-height: 1.7;
    background: #111827; color: #e2e8f0;
    padding: 1rem 1rem 1rem 1.5rem;
    border-radius: 10px; overflow: auto;
    max-height: 75vh; border: 1px solid #1e3a5c;
}
.xml-tree .xn       { display: block; white-space: nowrap; }
.xml-tree .xn:hover { background: rgba(108,99,255,.08); border-radius:4px; }
.xml-tree .xt       { color: #7dd3fc; }          /* <Tag>           azul */
.xml-tree .xa       { color: #86efac; }          /* atrib name      verde */
.xml-tree .xv       { color: #fca5a5; }          /* "attr value"    rosa */
.xml-tree .xval     { color: #fde68a; }          /* >texto<         amarillo */
.xml-tree .xpi      { color: #c084fc; }          /* <?xml?>         violeta */
.xml-tree .xcom     { color: #6b7280; font-style:italic; } /* comentario */
.xml-tree .xns      { color: #64748b; }          /* xmlns           gris */
/* Botón colapsar ▶ / ▼ */
.xml-tree .xfold {
    display: inline-block; width: 14px; text-align: center;
    cursor: pointer; user-select: none;
    color: #6b7280; font-size: .7rem; margin-right: 2px;
    transition: transform .15s;
}
.xml-tree .xfold:hover { color: #e2e8f0; }
.xml-tree .xchildren  { margin-left: 1.4rem; }
.xml-tree .xcollapsed > .xchildren { display: none; }
.xml-tree .xcollapsed > .xn > .xfold { transform: rotate(-90deg); }
.xml-tree .xellipsis  { color: #6b7280; font-size:.75rem; }
</style>
<div class="modal fade" id="xmlViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered" style="max-width:92vw">
        <div class="modal-content" style="background:#0f1629;color:#e2e8f0;border:1px solid #2a3a5c;border-radius:16px;">
            <div class="modal-header" style="border-bottom:1px solid #2a3a5c;background:#1a2340">
                <h5 class="modal-title" id="xmlViewerTitle"><i class="bi bi-code-slash me-2 text-info"></i>XML</h5>
                <div class="ms-auto d-flex gap-2 me-3">
                    <button class="btn btn-sm btn-outline-secondary" id="xmlExpandAllBtn" title="Expandir todo">
                        <i class="bi bi-arrows-expand"></i> Expandir todo
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="xmlCollapseAllBtn" title="Colapsar todo">
                        <i class="bi bi-arrows-collapse"></i> Colapsar
                    </button>
                    <button class="btn btn-sm btn-outline-light" id="xmlCopyBtn">
                        <i class="bi bi-clipboard"></i> Copiar
                    </button>
                    <button class="btn btn-sm btn-outline-info" id="xmlDownloadBtn">
                        <i class="bi bi-download"></i> Descargar
                    </button>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:.75rem;background:#0f1629">
                <div id="xmlViewerSpinner" class="text-center py-4">
                    <div class="spinner-border text-info" role="status"></div>
                    <p class="mt-2 text-muted">Cargando XML...</p>
                </div>
                <div id="xmlViewerContent" class="xml-tree d-none"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #2a3a5c;background:#1a2340">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: VISTA DOCUMENTO (encabezado legible + líneas)
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="docViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="background:#1a2340;color:#e2e8f0;border:1px solid #2a3a5c;border-radius:16px">
            <div class="modal-header" style="background:#111827;border-bottom:1px solid #2a3a5c">
                <div>
                    <h5 class="modal-title mb-0" id="docViewerTitle"><i class="bi bi-file-earmark-text me-2 text-success"></i>Vista del Documento</h5>
                    <small class="text-muted" id="docViewerSubtitle"></small>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="docViewerBody" style="padding:1.25rem">
                <div class="text-center py-4">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2 text-muted">Cargando documento...</p>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #2a3a5c;background:#111827">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: VISOR PDF
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered" style="max-width:90vw">
        <div class="modal-content" style="background:#1a2340;color:#e2e8f0;border:1px solid #2a3a5c;border-radius:16px;height:90vh">
            <div class="modal-header" style="border-bottom:1px solid #2a3a5c">
                <h5 class="modal-title"><i class="bi bi-filetype-pdf me-2 text-danger"></i>PDF del Comprobante</h5>
                <button class="btn btn-sm btn-outline-danger ms-auto me-3" id="pdfDownloadBtn">
                    <i class="bi bi-download"></i> Descargar PDF
                </button>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:.5rem;overflow:hidden;display:flex;flex-direction:column">
                <div id="pdfViewerSpinner" class="text-center py-4">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="mt-2 text-muted">Cargando PDF...</p>
                </div>
                <iframe id="pdfViewerFrame" class="d-none" style="flex:1;width:100%;height:100%;border:none;border-radius:8px;"></iframe>
            </div>
            <div class="modal-footer" style="border-top:1px solid #2a3a5c">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: BITÁCORA DE EMISIÓN (consola estilo CMD)
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="logViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="background:#1a2340;color:#e2e8f0;border:1px solid #2a3a5c;border-radius:16px;">
            <div class="modal-header" style="border-bottom:1px solid #2a3a5c;background:#0d1117">
                <h5 class="modal-title"><i class="bi bi-terminal me-2 text-info"></i>Bitácora de emisión</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:0;">
                <div id="logViewerConsole" style="background:#0b0e14;color:#c9d1d9;font-family:'Cascadia Code','Consolas',monospace;font-size:.82rem;line-height:1.6;padding:1rem;min-height:200px;max-height:65vh;overflow-y:auto;white-space:pre-wrap;border-radius:0 0 16px 16px;">
                    <div class="text-center py-4">
                        <div class="spinner-border text-info" role="status"></div>
                        <p class="mt-2 text-muted">Cargando bitácora...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #2a3a5c">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.EI_API   = '@Html.Raw(apiBaseUrl)';
    window.EI_TOKEN = '@Html.Raw(apiToken)';
</script>
<script>
(function () {
    const EI = { api: window.EI_API || '', token: window.EI_TOKEN || '' };

    // ── fetch helper con Bearer token ──────────────────────────────
    async function eiFetch(path, options = {}) {
        const url  = EI.api + path;
        const opts = Object.assign({ headers: {} }, options);
        if (EI.token) opts.headers['Authorization'] = `Bearer ${EI.token}`;
        return fetch(url, opts);
    }

    // ── Catálogos locales ──────────────────────────────────────────
    const TYPE = { '01':'Factura Electrónica','02':'Nota de Débito','03':'Nota de Crédito',
                   '04':'Tiquete Electrónico','08':'Factura de Compra','10':'Recibo de Pago' };
    const SALE = { '01':'Contado','02':'Crédito','03':'Consignación','04':'Apartado',
                   '05':'Arrendamiento c/op','06':'Arrendamiento s/op','07':'Cobro a favor','08':'Pago serv. prestado','99':'Otros' };
    const PAY  = { '01':'Efectivo','02':'Tarjeta','03':'Cheque','04':'Transferencia',
                   '05':'Recaudado por terceros','99':'Otros' };

    function badge(status) {
        const map = { 'Aceptado':'success','Rechazado':'danger','Contingencia':'warning',
            'Pendiente':'secondary','Procesando':'info','Firmado':'primary','Enviado':'info','Borrador':'secondary' };
        return `<span class="badge bg-${map[status] || 'secondary'} fs-6 px-3 py-2">${status}</span>`;
    }
    function badgeSm(status) {
        const map = { 'Aceptado':'success','Rechazado':'danger','Contingencia':'warning',
            'Pendiente':'secondary','Procesando':'info','Firmado':'primary','Enviado':'info','Borrador':'secondary' };
        return `<span class="badge bg-${map[status] || 'secondary'}">${status}</span>`;
    }
    function fmt(n) { return (n||0).toFixed(2); }
    function fmtDate(d) { return d ? new Date(d).toLocaleString('es-CR') : '—'; }

    // ── Cargar lista ───────────────────────────────────────────────
    async function load() {
        try {
            const r = await eiFetch('/api/electronicinvoice?limit=200');
            const list = r.ok ? await r.json() : [];
            const body = document.getElementById('docsBody');
            if (!list.length) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted">Sin comprobantes</td></tr>';
                return;
            }
            body.innerHTML = list.map(d => `
                <tr class="doc-row" data-id="${d.id}" style="cursor:pointer">
                    <td>${fmtDate(d.issueDate)}</td>
                    <td><span class="badge bg-secondary">${TYPE[d.documentType] || d.documentType}</span></td>
                    <td><code class="text-info" style="font-size:.75rem">${d.clave ? d.clave.substring(0,20)+'…' : '—'}</code></td>
                    <td>${d.consecutive || '—'}</td>
                    <td>${badgeSm(d.status)}</td>
                    <td>${d.haciendaStatus
                        ? `<span class="badge bg-${d.haciendaStatus==='aceptado'?'success':'danger'}">${d.haciendaStatus}</span>`
                        : '<span class="text-muted">—</span>'}
                        ${d.haciendaDetail ? `<i class="bi bi-info-circle text-warning ms-1" title="${(d.haciendaDetail||'').replace(/"/g,'&quot;')}"></i>` : ''}
                    </td>
                    <td class="text-end fw-bold">${fmt(d.total)} <small class="text-muted">${d.currency}</small></td>
                    <td onclick="event.stopPropagation()" class="text-nowrap">
                        <button class="btn btn-sm btn-outline-success ei-doc-btn" data-id="${d.id}" title="Vista Documento"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-outline-info    ei-xml-btn"  data-id="${d.id}" data-type="signed"   title="Ver XML Firmado"><i class="bi bi-filetype-xml"></i></button>
                        <button class="btn btn-sm btn-outline-secondary ei-xml-btn" data-id="${d.id}" data-type="response" title="XML Respuesta Hacienda"><i class="bi bi-code-slash"></i></button>
                        <button class="btn btn-sm btn-outline-danger   ei-pdf-btn" data-id="${d.id}"                      title="Ver PDF"><i class="bi bi-filetype-pdf"></i></button>
                        <button class="btn btn-sm btn-outline-light    ei-log-btn" data-id="${d.id}"                     title="Ver bitácora de emisión"><i class="bi bi-terminal"></i></button>
                        <button class="btn btn-sm btn-outline-primary  ei-backfill-btn" data-id="${d.id}" title="Sincronizar campos desde XML (BD)"><i class="bi bi-database-down"></i></button>
                        ${((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && ['01','04','08'].includes(d.documentType) && d.clave && !d.fullyReversed)
                            ? `<button class="btn btn-sm btn-outline-warning ei-nc-btn" data-id="${d.id}" data-clave="${d.clave}" data-type="${d.documentType}" data-date="${d.issueDate}" title="Crear Nota de Crédito sobre este documento"><i class="bi bi-arrow-return-left"></i> NC</button>`
                            : ((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && ['01','04','08'].includes(d.documentType) && d.clave && d.fullyReversed)
                                ? `<span class="badge bg-secondary ms-1" title="Este documento ya fue reversado en su totalidad (100%). No admite más notas de crédito."><i class="bi bi-check2-all"></i> Reversado</span>`
                                : ''}
                        ${((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && d.documentType==='03' && d.clave && !d.fullyReversed)
                            ? `<button class="btn btn-sm btn-outline-warning ei-nd-btn" data-id="${d.id}" data-clave="${d.clave}" data-type="${d.documentType}" data-date="${d.issueDate}" title="Crear Nota de Débito sobre esta Nota de Crédito"><i class="bi bi-arrow-return-right"></i> ND</button>`
                            : ((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && d.documentType==='03' && d.clave && d.fullyReversed)
                                ? `<span class="badge bg-secondary ms-1" title="Esta Nota de Crédito ya fue reversada en su totalidad (100%). No admite más notas de débito."><i class="bi bi-check2-all"></i> Reversado</span>`
                                : ''}
                        ${((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && ['01','08'].includes(d.documentType) && d.clave && d.saleCondition==='02' && !d.fullyPaid)
                            ? `<button class="btn btn-sm btn-outline-success ei-rep-btn" data-id="${d.id}" data-clave="${d.clave}" data-type="${d.documentType}" data-date="${d.issueDate}" title="Generar Recibo Electrónico de Pago (REP) sobre esta factura a crédito"><i class="bi bi-cash-coin"></i> REP</button>`
                            : ((d.haciendaStatus==='aceptado' || d.status==='Aceptado') && ['01','08'].includes(d.documentType) && d.clave && d.saleCondition==='02' && d.fullyPaid)
                                ? `<span class="badge bg-secondary ms-1" title="Esta factura ya fue pagada en su totalidad (100%) mediante Recibos Electrónicos de Pago. No admite más REP."><i class="bi bi-check2-all"></i> Pagada</span>`
                                : ''}
                        ${['Procesando','Enviado'].includes(d.status)
                            ? `<button class="btn btn-sm btn-outline-info ei-poll-btn" data-id="${d.id}" title="Consultar estado en Hacienda"><i class="bi bi-cloud-check"></i></button>`
                            : ''}
                        ${['Pendiente','Contingencia'].includes(d.status)
                            ? `<button class="btn btn-sm btn-outline-info ei-poll-btn" data-id="${d.id}" title="Reenviar a Hacienda y consultar el estado real del comprobante"><i class="bi bi-cloud-arrow-up"></i> Consultar</button>`
                            : ''}
                    </td>
                </tr>`).join('');

            // Click en fila → abrir modal detalle
            body.querySelectorAll('.doc-row').forEach(tr =>
                tr.addEventListener('click', () => openDetail(parseInt(tr.dataset.id)))
            );
            // Botón Vista Documento
            body.querySelectorAll('.ei-doc-btn').forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                console.log('[EI] Click ei-doc-btn → id=', b.dataset.id);
                await openDocViewer(parseInt(b.dataset.id));
            }));
            // Botón XML
            const xmlBtns = body.querySelectorAll('.ei-xml-btn');
            const pdfBtns = body.querySelectorAll('.ei-pdf-btn');
            console.log(`[EI] load() → registrando listeners: ${xmlBtns.length} botones XML, ${pdfBtns.length} botones PDF`);
            xmlBtns.forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                console.log('[EI] Click ei-xml-btn → id=', b.dataset.id, 'type=', b.dataset.type);
                await openXmlForDoc(parseInt(b.dataset.id), b.dataset.type);
            }));
            // Botón PDF
            pdfBtns.forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                console.log('[EI] Click ei-pdf-btn → id=', b.dataset.id);
                await openPdfForDoc(parseInt(b.dataset.id));
            }));
            // Botón bitácora
            body.querySelectorAll('.ei-log-btn').forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                await openLogsForDoc(parseInt(b.dataset.id));
            }));
            // Botón crear Nota de Crédito → navega a Emit con la referencia precargada
            body.querySelectorAll('.ei-nc-btn').forEach(b => b.addEventListener('click', e => {
                e.stopPropagation();
                const qs = new URLSearchParams({
                    ncFrom: b.dataset.id,
                    refClave: b.dataset.clave || '',
                    refType: b.dataset.type || '01',
                    refDate: (b.dataset.date || '').substring(0, 10)
                });
                window.location.href = `/ElectronicInvoice/Emit?${qs.toString()}`;
            }));
            // Botón crear Nota de Débito → navega a Emit referenciando una NC aceptada
            body.querySelectorAll('.ei-nd-btn').forEach(b => b.addEventListener('click', e => {
                e.stopPropagation();
                const qs = new URLSearchParams({
                    ndFrom: b.dataset.id,
                    refClave: b.dataset.clave || '',
                    refType: b.dataset.type || '03',
                    refDate: (b.dataset.date || '').substring(0, 10)
                });
                window.location.href = `/ElectronicInvoice/Emit?${qs.toString()}`;
            }));
            // Botón generar Recibo Electrónico de Pago → navega a Emit referenciando la FE/FEC
            body.querySelectorAll('.ei-rep-btn').forEach(b => b.addEventListener('click', e => {
                e.stopPropagation();
                const qs = new URLSearchParams({
                    repFrom: b.dataset.id,
                    refClave: b.dataset.clave || '',
                    refType: b.dataset.type || '01',
                    refDate: (b.dataset.date || '').substring(0, 10)
                });
                window.location.href = `/ElectronicInvoice/Emit?${qs.toString()}`;
            }));
            // Botón consultar estado en Hacienda
            body.querySelectorAll('.ei-poll-btn').forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                const originalHtml = b.innerHTML;
                b.disabled = true;
                b.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                try {
                    const r = await eiFetch(`/api/electronicinvoice/${b.dataset.id}/poll-status`, { method: 'POST' });
                    const s = await r.json().catch(() => ({}));
                    if (r.ok) {
                        if (s.resolved) {
                            load(); // refrescar la lista con el estado final
                        } else {
                            alert(s.message || 'Hacienda aún está procesando el comprobante. Intente nuevamente en unos momentos.');
                            load(); // refrescar por si el estado cambió (p. ej. Pendiente → Procesando)
                        }
                    } else {
                        alert(s.message || 'No se pudo consultar el estado.');
                        b.disabled = false;
                        b.innerHTML = originalHtml;
                    }
                } catch (err) {
                    alert('Error al consultar el estado: ' + err.message);
                    b.disabled = false;
                    b.innerHTML = originalHtml;
                }
            }));
            // Botón reprocesar
            body.querySelectorAll('.reprocess').forEach(b => b.addEventListener('click', async () => {
                b.disabled = true;
                await eiFetch(`/api/electronicinvoice/${b.dataset.id}/process`, { method: 'POST' });
                load();
            }));
            // Botón Sincronizar (backfill) — lee XML de BD y actualiza campos fiscales
            body.querySelectorAll('.ei-backfill-btn').forEach(b => b.addEventListener('click', async e => {
                e.stopPropagation();
                const originalHtml = b.innerHTML;
                b.disabled = true;
                b.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                try {
                    const r = await eiFetch(`/api/electronicinvoice/${b.dataset.id}/backfill`, { method: 'POST' });
                    const result = await r.json().catch(() => ({}));
                    if (r.ok) {
                        b.innerHTML = '<i class="bi bi-check-lg"></i>';
                        b.classList.remove('btn-outline-primary');
                        b.classList.add('btn-success');
                        console.log('[EI] Backfill OK:', result.message, result.updated);
                    } else {
                        b.innerHTML = '<i class="bi bi-x-lg"></i>';
                        b.classList.add('btn-outline-danger');
                        console.error('[EI] Backfill error:', result.message || r.status);
                    }
                } catch (err) {
                    b.innerHTML = '<i class="bi bi-x-lg"></i>';
                    console.error('[EI] Backfill excepción:', err);
                } finally {
                    setTimeout(() => {
                        b.disabled = false;
                        b.innerHTML = originalHtml;
                        b.classList.remove('btn-success','btn-outline-danger');
                        b.classList.add('btn-outline-primary');
                    }, 2500);
                }
            }));
        } catch (e) {
            console.error('Error cargando comprobantes:', e);
        }
    }

