    async function openXml(type) {
        const id = EI.activeDocId;
        if (!id) return;
        const modalEl = document.getElementById('xmlViewerModal');
        const modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
        const spinner = document.getElementById('xmlViewerSpinner');
        const content = document.getElementById('xmlViewerContent');
        const titleEl = document.getElementById('xmlViewerTitle');

        spinner.classList.remove('d-none');
        content.classList.add('d-none');
        _xmlContent = '';

        if (type === 'response') {
            titleEl.innerHTML = '<i class="bi bi-code-slash me-2"></i>XML Respuesta de Hacienda';
            _xmlFilename = `respuesta_hacienda_${id}.xml`;
        } else {
            titleEl.innerHTML = '<i class="bi bi-filetype-xml me-2 text-info"></i>XML Firmado del Comprobante';
            _xmlFilename = `comprobante_${id}.xml`;
        }

        modal.show();

        try {
            if (type === 'response') {
                // El XML de respuesta ya viene en el detalle del doc
                const r = await eiFetch(`/api/electronicinvoice/${id}`);
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const d = await r.json();
                if (!d.xmlResponse) throw new Error('Sin respuesta XML de Hacienda');
                _xmlContent = d.xmlResponse;
            } else {
                const r = await eiFetch(`/api/electronicinvoice/${id}/xml`);
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                _xmlContent = await r.text();
            }
            // Formatear XML con indentación visual básica
            // Renderizar árbol XML interactivo
            buildXmlTree(_xmlContent);
            spinner.classList.add('d-none');
            content.classList.remove('d-none');
        } catch (e) {
            content.textContent = `Error al cargar XML: ${e.message}`;
            content.style.color = '#ef4444';
            spinner.classList.add('d-none');
            content.classList.remove('d-none');
        }
    }

