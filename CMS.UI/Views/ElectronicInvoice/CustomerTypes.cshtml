@{
    ViewData["Title"] = "Tipos de Cliente";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .ct-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    .ct-table { color: #1e293b; background-color: #ffffff; }
    .ct-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .ct-table td, .ct-table th { border-color: #cbd5e1; vertical-align: middle; }
    .ct-table td { color: #1e293b; }
    .ct-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
    .ct-table td small, .ct-table .text-muted { color: #475569 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-people me-2"></i>Tipos de Cliente</h4>
        <div>
            <a asp-action="IdentificationTypes" class="btn btn-outline-light btn-sm"><i class="bi bi-person-vcard"></i> Tipos de Identificación</a>
            <button id="ctNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo tipo</button>
        </div>
    </div>

    <div class="card ct-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central de <strong>tipos de cliente</strong> (<code>admin.customer_type</code>).
                Es compartido por todas las compañías y se referencia desde
                <code>customer.id_customer_type</code>. Los indicadores <em>Emisor</em> / <em>Receptor</em>
                determinan si un cliente puede actuar como emisor o receptor de documentos electrónicos.
            </p>

            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-light">Buscar (código o nombre)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="ctSearch" class="form-control" placeholder="Ej: Emisor..." />
                        <button class="btn btn-outline-info" type="button" id="ctSearchBtn"><i class="bi bi-search"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="ctSearchClear" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="ctOnlyActive" />
                        <label class="form-check-label" for="ctOnlyActive">Solo activos</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table ct-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center" style="width: 90px;">Emisor</th>
                            <th class="text-center" style="width: 90px;">Receptor</th>
                            <th class="text-center" style="width: 80px;">Orden</th>
                            <th class="text-center" style="width: 90px;">Activo</th>
                            <th class="text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="ctTableBody">
                        <tr><td colspan="8" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-light" id="ctInfo"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-light" id="ctPrev"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-light" id="ctNext"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="ctModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="ctModalTitle">Editar tipo</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="f_id" />
                <div class="row g-2">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Código</label>
                        <input type="text" id="f_code" class="form-control" maxlength="30" placeholder="Ej: Issuer" />
                        <small class="form-text">Código único (ej: Issuer, Receptor, Issuer-Receptor).</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="f_sortOrder" class="form-control" min="0" max="999" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" id="f_name" class="form-control" maxlength="100" placeholder="Ej: Emisor" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="f_description" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="f_isIssuer" />
                            <label class="form-check-label" for="f_isIssuer">Puede ser Emisor</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="f_isReceptor" />
                            <label class="form-check-label" for="f_isReceptor">Puede ser Receptor</label>
                        </div>
                    </div>
                </div>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="f_isActive" checked />
                    <label class="form-check-label" for="f_isActive">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="ctSaveBtn"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const CT = { api: '@Html.Raw(apiBaseUrl)', token: '@Html.Raw(apiToken)' };
    let ctPage = 1, ctPageSize = 50, ctTotal = 0;

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    async function ctFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (CT.token) opts.headers['Authorization'] = `Bearer ${CT.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(CT.api + path, opts);
    }

    function boolBadge(v) {
        return v
            ? '<span class="badge bg-success badge-flag">Sí</span>'
            : '<span class="badge bg-secondary badge-flag">No</span>';
    }

    async function loadTypes() {
        const body = document.getElementById('ctTableBody');
        body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Cargando...</td></tr>';
        const search = document.getElementById('ctSearch').value.trim();
        const onlyActive = document.getElementById('ctOnlyActive').checked;
        const qs = new URLSearchParams({ page: ctPage, pageSize: ctPageSize, onlyActive });
        if (search) qs.set('search', search);
        try {
            const r = await ctFetch('/api/customertype?' + qs.toString());
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            ctTotal = data.total;
            const rows = data.items || [];
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Sin resultados.</td></tr>';
            } else {
                body.innerHTML = rows.map(a => `
                    <tr>
                        <td><span class="ct-code">${escapeHtml(a.code)}</span></td>
                        <td>${escapeHtml(a.name)}</td>
                        <td>${a.description ? escapeHtml(a.description) : '<span class="text-muted">—</span>'}</td>
                        <td class="text-center">${boolBadge(a.isIssuer)}</td>
                        <td class="text-center">${boolBadge(a.isReceptor)}</td>
                        <td class="text-center">${a.sortOrder ?? 0}</td>
                        <td class="text-center">${boolBadge(a.isActive)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick='ctEdit(${JSON.stringify(a).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="ctDelete(${a.id})"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`).join('');
            }
            const from = ctTotal === 0 ? 0 : (ctPage - 1) * ctPageSize + 1;
            const to = Math.min(ctPage * ctPageSize, ctTotal);
            document.getElementById('ctInfo').textContent = `Mostrando ${from}-${to} de ${ctTotal}`;
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    function ctOpenModal(title) {
        document.getElementById('ctModalTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('ctModal')).show();
    }

    function ctNew() {
        document.getElementById('f_id').value = '';
        document.getElementById('f_code').value = '';
        document.getElementById('f_name').value = '';
        document.getElementById('f_description').value = '';
        document.getElementById('f_sortOrder').value = '0';
        document.getElementById('f_isIssuer').checked = false;
        document.getElementById('f_isReceptor').checked = true;
        document.getElementById('f_isActive').checked = true;
        document.getElementById('f_code').disabled = false;
        ctOpenModal('Nuevo tipo de cliente');
    }

    function ctEdit(a) {
        document.getElementById('f_id').value = a.id;
        document.getElementById('f_code').value = a.code;
        document.getElementById('f_name').value = a.name;
        document.getElementById('f_description').value = a.description || '';
        document.getElementById('f_sortOrder').value = a.sortOrder ?? 0;
        document.getElementById('f_isIssuer').checked = a.isIssuer;
        document.getElementById('f_isReceptor').checked = a.isReceptor;
        document.getElementById('f_isActive').checked = a.isActive;
        document.getElementById('f_code').disabled = false;
        ctOpenModal('Editar tipo de cliente');
    }

    async function ctSave() {
        const id = document.getElementById('f_id').value;
        const payload = {
            code: document.getElementById('f_code').value.trim(),
            name: document.getElementById('f_name').value.trim(),
            description: document.getElementById('f_description').value.trim() || null,
            isIssuer: document.getElementById('f_isIssuer').checked,
            isReceptor: document.getElementById('f_isReceptor').checked,
            sortOrder: parseInt(document.getElementById('f_sortOrder').value, 10) || 0,
            isActive: document.getElementById('f_isActive').checked
        };
        if (!payload.code || !payload.name) {
            alert('Código y nombre son obligatorios.');
            return;
        }
        try {
            const r = id
                ? await ctFetch('/api/customertype/' + id, { method: 'PUT', body: JSON.stringify(payload) })
                : await ctFetch('/api/customertype', { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al guardar.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('ctModal')).hide();
            await loadTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    async function ctDelete(id) {
        if (!confirm('¿Eliminar este tipo de cliente?')) return;
        try {
            const r = await ctFetch('/api/customertype/' + id, { method: 'DELETE' });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al eliminar.');
                return;
            }
            await loadTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Mover modal al body para evitar problemas de z-index con el sidebar
        ['ctModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        document.getElementById('ctNewBtn').addEventListener('click', ctNew);
        document.getElementById('ctSaveBtn').addEventListener('click', ctSave);
        document.getElementById('ctSearchBtn').addEventListener('click', () => { ctPage = 1; loadTypes(); });
        document.getElementById('ctSearch').addEventListener('keyup', e => { if (e.key === 'Enter') { ctPage = 1; loadTypes(); } });
        document.getElementById('ctSearchClear').addEventListener('click', () => { document.getElementById('ctSearch').value = ''; ctPage = 1; loadTypes(); });
        document.getElementById('ctOnlyActive').addEventListener('change', () => { ctPage = 1; loadTypes(); });
        document.getElementById('ctPrev').addEventListener('click', () => { if (ctPage > 1) { ctPage--; loadTypes(); } });
        document.getElementById('ctNext').addEventListener('click', () => { if (ctPage * ctPageSize < ctTotal) { ctPage++; loadTypes(); } });

        loadTypes();
    });
</script>
}
