@{
    ViewData["Title"] = "Tipo Doc. Exoneración";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .dea-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    .dea-table { color: #1e293b; background-color: #ffffff; }
    .dea-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .dea-table td, .dea-table th { border-color: #cbd5e1; vertical-align: middle; }
    .dea-table td { color: #1e293b; }
    .dea-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
    .dea-table td small, .dea-table .text-muted { color: #475569 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-patch-check me-2"></i>Tipo de documento de exoneración</h4>
        <div>
            <a asp-action="TaxTypes" class="btn btn-outline-light btn-sm"><i class="bi bi-percent-square"></i> Tipos de Impuesto</a>
            <a asp-action="TaxRates" class="btn btn-outline-light btn-sm"><i class="bi bi-percent"></i> Códigos de Tarifa</a>
            <button id="deaNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo tipo</button>
        </div>
    </div>

    <div class="card dea-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central de <strong>tipos de documento de exoneración o de autorización</strong>
                (<code>TipoDocumentoEX</code>, formato <code>00</code>) del Ministerio de Hacienda.
                Es compartido por todas las compañías. Los tipos marcados como <strong>activos</strong>
                aparecen en el selector "Tipo de documento de exoneración o de autorización" del modal
                de impuesto en la pantalla de emisión <em>"/ElectronicInvoice/Emit"</em>.
            </p>

            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-light">Buscar (código o nombre)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="deaSearch" class="form-control" placeholder="Ej: diplomáticos..." />
                        <button class="btn btn-outline-info" type="button" id="deaSearchBtn"><i class="bi bi-search"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="deaSearchClear" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="deaOnlyActive" />
                        <label class="form-check-label" for="deaOnlyActive">Solo activos</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table dea-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Código</th>
                            <th>Nombre</th>
                            <th class="text-center" style="width: 90px;">Orden</th>
                            <th class="text-center" style="width: 80px;">Activo</th>
                            <th class="text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="deaTableBody">
                        <tr><td colspan="5" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-light" id="deaInfo"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-light" id="deaPrev"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-light" id="deaNext"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="deaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="deaModalTitle">Editar tipo</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="fa_id" />
                <div class="row g-2">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Código</label>
                        <input type="text" id="fa_code" class="form-control" maxlength="2" placeholder="00" />
                        <small class="form-text">Formato Hacienda: 00</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="fa_displayOrder" class="form-control" min="0" max="999" value="0" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="fa_isActive" checked />
                            <label class="form-check-label" for="fa_isActive">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" id="fa_name" class="form-control" maxlength="300" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="fa_description" class="form-control" rows="2" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="deaSaveBtn"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const DEA = { api: '@Html.Raw(apiBaseUrl)', token: '@Html.Raw(apiToken)' };
    let deaPage = 1, deaPageSize = 50, deaTotal = 0;

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    async function deaFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (DEA.token) opts.headers['Authorization'] = `Bearer ${DEA.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(DEA.api + path, opts);
    }

    function boolBadge(v) {
        return v
            ? '<span class="badge bg-success badge-flag">Sí</span>'
            : '<span class="badge bg-secondary badge-flag">No</span>';
    }

    async function loadTypes() {
        const body = document.getElementById('deaTableBody');
        body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Cargando...</td></tr>';
        const search = document.getElementById('deaSearch').value.trim();
        const onlyActive = document.getElementById('deaOnlyActive').checked;
        const qs = new URLSearchParams({ page: deaPage, pageSize: deaPageSize, onlyActive });
        if (search) qs.set('search', search);
        try {
            const r = await deaFetch('/api/electronicdocumentexemptionauthorizationtype?' + qs.toString());
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            deaTotal = data.total;
            const rows = data.items || [];
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Sin resultados.</td></tr>';
            } else {
                body.innerHTML = rows.map(a => `
                    <tr>
                        <td><span class="dea-code">${escapeHtml(a.code)}</span></td>
                        <td>${escapeHtml(a.name)}</td>
                        <td class="text-center">${a.displayOrder ?? 0}</td>
                        <td class="text-center">${boolBadge(a.isActive)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick='deaEdit(${JSON.stringify(a).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deaDelete(${a.id})"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`).join('');
            }
            const from = deaTotal === 0 ? 0 : (deaPage - 1) * deaPageSize + 1;
            const to = Math.min(deaPage * deaPageSize, deaTotal);
            document.getElementById('deaInfo').textContent = `Mostrando ${from}-${to} de ${deaTotal}`;
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    function deaOpenModal(title) {
        document.getElementById('deaModalTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deaModal')).show();
    }

    function deaNew() {
        document.getElementById('fa_id').value = '';
        document.getElementById('fa_code').value = '';
        document.getElementById('fa_name').value = '';
        document.getElementById('fa_description').value = '';
        document.getElementById('fa_displayOrder').value = '0';
        document.getElementById('fa_isActive').checked = true;
        document.getElementById('fa_code').disabled = false;
        deaOpenModal('Nuevo tipo');
    }

    function deaEdit(a) {
        document.getElementById('fa_id').value = a.id;
        document.getElementById('fa_code').value = a.code;
        document.getElementById('fa_name').value = a.name;
        document.getElementById('fa_description').value = a.description ?? '';
        document.getElementById('fa_displayOrder').value = a.displayOrder ?? 0;
        document.getElementById('fa_isActive').checked = a.isActive;
        document.getElementById('fa_code').disabled = false;
        deaOpenModal('Editar tipo');
    }

    async function deaSave() {
        const id = document.getElementById('fa_id').value;
        const payload = {
            code: document.getElementById('fa_code').value.trim(),
            name: document.getElementById('fa_name').value.trim(),
            description: document.getElementById('fa_description').value.trim(),
            displayOrder: parseInt(document.getElementById('fa_displayOrder').value, 10) || 0,
            isActive: document.getElementById('fa_isActive').checked
        };
        if (!payload.code || !payload.name) {
            alert('Código y nombre son obligatorios.');
            return;
        }
        try {
            const r = id
                ? await deaFetch('/api/electronicdocumentexemptionauthorizationtype/' + id, { method: 'PUT', body: JSON.stringify(payload) })
                : await deaFetch('/api/electronicdocumentexemptionauthorizationtype', { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al guardar.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('deaModal')).hide();
            await loadTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    async function deaDelete(id) {
        if (!confirm('¿Eliminar este tipo de documento de exoneración?')) return;
        try {
            const r = await deaFetch('/api/electronicdocumentexemptionauthorizationtype/' + id, { method: 'DELETE' });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al eliminar.');
                return;
            }
            await loadTypes();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Mover modal al body para evitar problemas de z-index con el sidebar
        ['deaModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        document.getElementById('deaNewBtn').addEventListener('click', deaNew);
        document.getElementById('deaSaveBtn').addEventListener('click', deaSave);
        document.getElementById('deaSearchBtn').addEventListener('click', () => { deaPage = 1; loadTypes(); });
        document.getElementById('deaSearch').addEventListener('keyup', e => { if (e.key === 'Enter') { deaPage = 1; loadTypes(); } });
        document.getElementById('deaSearchClear').addEventListener('click', () => { document.getElementById('deaSearch').value = ''; deaPage = 1; loadTypes(); });
        document.getElementById('deaOnlyActive').addEventListener('change', () => { deaPage = 1; loadTypes(); });
        document.getElementById('deaPrev').addEventListener('click', () => { if (deaPage > 1) { deaPage--; loadTypes(); } });
        document.getElementById('deaNext').addEventListener('click', () => { if (deaPage * deaPageSize < deaTotal) { deaPage++; loadTypes(); } });

        loadTypes();
    });
</script>
}
