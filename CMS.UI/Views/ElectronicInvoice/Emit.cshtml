                <!-- Error alert -->
                <div id="receptorError" class="alert alert-danger d-none" role="alert"></div>

                <!-- Resultados -->
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-dark table-hover">
                        <thead class="sticky-top bg-dark">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Cédula</th>
                                <th>Tipo</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="receptorResults">
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    Click en "Buscar" para ver resultados
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================= MODAL: SELECCIONAR ÍTEM ============================= -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h5 class="modal-title" id="itemModalLabel"><i class="bi bi-box-seam"></i> Seleccionar ítem</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input id="itemSearchTerm" type="text" class="form-control" placeholder="Buscar por código o nombre..." onkeydown="if(event.key==='Enter'){searchItems();return false;}" />
                    <button class="btn btn-primary" type="button" onclick="searchItems()"><i class="bi bi-search"></i> Buscar</button>
                </div>
                <div id="itemError" class="alert alert-danger d-none" role="alert"></div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">IVA %</th>
                                <th>CAByS</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="itemResults">
                            <tr><td colspan="6" class="text-center text-muted">Escriba y presione "Buscar"</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.EMIT_API   = '@Html.Raw(apiBaseUrl)';
    window.EMIT_TOKEN = '@Html.Raw(apiToken)';
</script>
<script>
console.log('%c✅ EMIT.CSHTML SCRIPT V3.0 CARGADO', 'background: #00ff00; color: #000; font-size: 20px; font-weight: bold;');
(function () {
    // ── Config ─────────────────────────────────────────────────────────────
    const EMIT = {
        api:   window.EMIT_API   || '',
        token: window.EMIT_TOKEN || ''
    };

    // ── Fetch helper (igual que inventoryMovements) ─────────────────────────
    async function emitFetch(path, options = {}) {
        const url  = EMIT.api + path;
        const opts = Object.assign({ headers: {} }, options);
        if (EMIT.token) opts.headers['Authorization'] = `Bearer ${EMIT.token}`;
        if (!opts.headers['Content-Type'] && opts.method !== 'GET' && opts.method !== undefined) {
            opts.headers['Content-Type'] = 'application/json';
        }
        const res = await fetch(url, opts);
        return res;
    }

    // ---------------- Validadores frontend (guards) ----------------
    const EMAIL_RE = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
    const CABYS_RE = /^\d{13}$/;

    function isValidCabys(v) { return CABYS_RE.test((v || '').trim()); }
    function isValidEmail(v) { return !v || EMAIL_RE.test(v.trim()); }
    function escapeHtml(text) {
        const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'};
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // ---------------- Cargar emisores y receptores ----------------
    async function searchIssuers() {
        const searchTerm = document.getElementById('issuerSearchTerm').value;
        const identificationType = document.getElementById('issuerIdentificationType').value;
        const errorDiv = document.getElementById('issuerError');
        const tbody = document.getElementById('issuerResults');

        // Limpiar errores previos
        errorDiv.classList.add('d-none');
        tbody.innerHTML = '<tr><td colspan="7" class="text-center"><div class="spinner-border spinner-border-sm" role="status"></div> Buscando...</td></tr>';

        try {
            const params = new URLSearchParams();
            if (searchTerm) params.append('searchTerm', searchTerm);
            if (identificationType) params.append('identificationType', identificationType);

            const response = await emitFetch(`/api/CustomerBillingCredential/search-issuers?${params}`);

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({ message: response.statusText }));
                throw new Error(errorData.message || `HTTP ${response.status}: ${response.statusText}`);
            }

            const issuers = await response.json();

            if (issuers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No se encontraron emisores</td></tr>';
                return;
            }

            tbody.innerHTML = issuers.map(issuer => `
                <tr>
                    <td>
                        ${issuer.name}
