@{
    ViewData["Title"] = "Emitir Comprobante Electrónico";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken   = ViewBag.ApiToken   as string ?? "";
}

@*
    ============================================================================
    VISTA: ElectronicInvoice/Emit.cshtml
    PROPÓSITO: Formulario de emisión de comprobantes electrónicos CR v4.4 con
               validadores frontend (guards): CAByS 13 díg., regex correo,
               cálculo inverso I.V.I.
    AUTOR: EAMR, BITI SOLUTIONS S.A
    ============================================================================
*@

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .ei-card { background-color: #16213e; border: 1px solid #24304f; }
    /* Resumen del documento electrónico: textos claros y legibles sobre fondo oscuro. */
    .ei-doc-action-link { color: #93c5fd !important; text-decoration: none; font-size: .9rem; }
    .ei-doc-action-link:hover { color: #bfdbfe !important; text-decoration: underline; }
    .ei-summary-card { background-color: #16213e; }
    .ei-summary-card .ei-sum-label { color: #e2e8f0; }
    .ei-summary-card .ei-sum-val { color: #f8fafc; font-weight: 600; }
    .ei-summary-card .ei-sum-sep { border-top: 1px solid #334155; margin: .5rem 0; }
    .ei-summary-card .ei-sum-total-label { color: #ffffff; font-weight: 700; }
    .ei-summary-card .ei-sum-total-val { color: #38bdf8; font-weight: 700; }
    .ei-line-table th, .ei-line-table td { vertical-align: middle; }
    .cabys-valid { border-color: #16a34a !important; }
    .cabys-invalid { border-color: #dc2626 !important; }
    .ei-line-exon { background-color: rgba(234, 179, 8, 0.12) !important; }
    /* Descripción de línea como texto plano (no editable). */
    .ei-detail-text { color: #e2e8f0; padding: .25rem 0; min-height: 1.4rem; word-break: break-word; }
    /* "CAByS manual" como título del campo de código. */
    .ei-code-title { display: flex; align-items: center; gap: .35rem; margin-bottom: .35rem; }
    .ei-code-title label { color: #cbd5e1; font-size: .78rem; margin: 0; cursor: pointer; }
    /* Autocompletado de código de ítem / CAByS. */
    .ei-code-cell { position: relative; }
    .ei-ac-list {
        position: absolute; z-index: 1080; left: 0; right: 0; top: 100%;
        background: #0f172a; border: 1px solid #334155; border-radius: .375rem;
        max-height: 220px; overflow-y: auto; margin-top: 2px;
        box-shadow: 0 6px 18px rgba(0,0,0,.45);
    }
    .ei-ac-item { padding: .35rem .5rem; cursor: pointer; font-size: .8rem; color: #e2e8f0; border-bottom: 1px solid #1e293b; }
    .ei-ac-item:last-child { border-bottom: 0; }
    .ei-ac-item:hover, .ei-ac-item.active { background: #1d4ed8; color: #fff; }
    .ei-ac-item .ei-ac-code { font-family: monospace; font-weight: 700; color: #60a5fa; }
    .ei-ac-item:hover .ei-ac-code, .ei-ac-item.active .ei-ac-code { color: #dbeafe; }
    .ei-ac-item .ei-ac-name { color: #94a3b8; }
    .ei-ac-item:hover .ei-ac-name, .ei-ac-item.active .ei-ac-name { color: #e0e7ff; }
    .ei-ac-empty { padding: .35rem .5rem; font-size: .78rem; color: #94a3b8; }

    /* ── Edición inline (lápiz) en columnas Descuentos e Impuestos ── */
    .ei-inline-cell { white-space: nowrap; }
    .ei-inline-edit { color: #60a5fa; text-decoration: none; padding: 0 .15rem; }
    .ei-inline-edit:hover { color: #93c5fd; }
    .ei-inline-editor { margin-top: .25rem; }
    .ei-line-idx { color: #94a3b8; }
    /* Botón lápiz circular gris (como en la referencia) */
    .ei-pencil-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border-radius: 50%;
        border: 1px solid #3b4a6b;
        background-color: #2a3555;
        color: #cbd5e1;
        margin-left: .35rem;
    }
    .ei-pencil-btn:hover { background-color: #374472; color: #fff; }
    .discDisplay, .rateDisplay { color: #e2e8f0; }

    /* ── Tarjetas resumen Emisor / Receptor ── */
    .party-label { font-size: .75rem; color: #94a3b8; margin-bottom: .1rem; }
    .party-value { font-size: .95rem; color: #e2e8f0; word-break: break-word; }
    .party-editable { position: relative; }
    .party-edit-btn { color: #60a5fa; text-decoration: none; vertical-align: baseline; }
    .party-edit-btn:hover { color: #93c5fd; }

    /* ── Modales: forzar por encima del sidebar/navbar ── */
    #issuerModal,
    #receptorModal {
        z-index: 1060 !important;
    }
    #issuerModal .modal-dialog,
    #receptorModal .modal-dialog {
        margin-top: 4rem;          /* espacio para el navbar */
        max-height: calc(100vh - 5rem);
    }
    #issuerModal .modal-content,
    #receptorModal .modal-content {
        max-height: calc(100vh - 6rem);
        display: flex;
        flex-direction: column;
    }
    #issuerModal .modal-body,
    #receptorModal .modal-body {
        overflow-y: auto;
        flex: 1 1 auto;
    }
    /* Tabla interna con scroll propio */
    #issuerModal  .table-responsive,
    #receptorModal .table-responsive {
        max-height: 55vh;
        overflow-y: auto;
    }
    /* Thead fijo dentro del scroll */
    #issuerModal  thead th,
    #receptorModal thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #1a2340;
    }
    /* Selectores/inputs largos: texto más pequeño para que el dato seleccionado
       se vea completo sin cortarse (emisor, receptor, consecutivo, actividades,
       condición de venta). No aplica el ellipsis del navegador al truncar. */
    #issuerDisplay,
    #receptorDisplay,
    #consecutiveId,
    #issuerActivityCode,
    #receptorActivityCode,
    #saleCondition {
        font-size: 0.82rem;
        text-overflow: ellipsis;
    }

    /* Grilla de métodos de pago (checkboxes) */
    .ei-payment-methods {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .35rem 1rem;
        padding: .6rem .75rem;
        background: rgba(255,255,255,.03);
        border: 1px solid #23305c;
        border-radius: .5rem;
    }
    .ei-payment-methods .form-check-label { color: #e0e0e0; }
    @@media (max-width: 992px) { .ei-payment-methods { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 576px) { .ei-payment-methods { grid-template-columns: 1fr; } }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Emitir Comprobante Electrónico</h4>
        <a asp-action="Index" class="btn btn-outline-light btn-sm"><i class="bi bi-list"></i> Comprobantes</a>
    </div>

    <div class="card ei-card mb-3">
        <div class="card-body">
            <div class="row g-3 mb-1">
                <div class="col-md-6">
                    <label class="form-label fw-bold"><i class="bi bi-file-earmark-text me-1"></i>Tipo de Documento Electrónico</label>
                    <select id="documentType" class="form-select form-select-lg">
                        <option value="">Cargando tipos...</option>
                    </select>
                    <small id="documentTypeHelp" class="form-text">Seleccione el tipo de comprobante a emitir.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Emisor</label>
                    <div class="input-group">
                        <input id="issuerDisplay" type="text" class="form-control form-control-lg" readonly placeholder="Click para seleccionar emisor..." />
                        <button class="btn btn-outline-info" type="button" data-bs-toggle="modal" data-bs-target="#issuerModal">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <input id="issuerId" type="hidden" />
                    <small class="form-text">Cliente/empresa en cuyo nombre se factura.</small>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold"><i class="bi bi-123 me-1"></i>Consecutivo</label>
                    <select id="consecutiveId" class="form-select form-select-lg">
                        <option value="">Seleccione emisor y tipo...</option>
                    </select>
                    <small id="consecutiveHelp" class="form-text">Consecutivo con el que se numerará el comprobante. Se preselecciona el predefinido.</small>
                </div>
                <div class="col-md-6" id="receptorField">
                    <label class="form-label fw-bold">Receptor</label>
                    <div class="input-group">
                        <input id="receptorDisplay" type="text" class="form-control form-control-lg" readonly placeholder="Click para seleccionar receptor..." />
                        <button class="btn btn-outline-info" type="button" data-bs-toggle="modal" data-bs-target="#receptorModal">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <input id="receptorId" type="hidden" />
                    <small class="form-text">Proveedor al que se emite la factura.</small>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6" id="issuerActivityField">
                    <label class="form-label fw-bold"><i class="bi bi-briefcase me-1"></i>Actividad económica del Emisor</label>
                    <select id="issuerActivityCode" class="form-select">
                        <option value="">Seleccione un emisor...</option>
                    </select>
                    <small class="form-text">Actividad económica (CodigoActividad) del emisor. Se preselecciona la predeterminada.</small>
                </div>
                <div class="col-md-6" id="receptorActivityField">
                    <label class="form-label fw-bold"><i class="bi bi-briefcase me-1"></i>Actividad económica del Receptor</label>
                    <select id="receptorActivityCode" class="form-select">
                        <option value="">Seleccione un receptor...</option>
                    </select>
                    <small class="form-text">Actividad económica (CodigoActividad) del receptor. Se preselecciona la predeterminada.</small>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-5">
                    <label class="form-label">Condición venta</label>
                    <select id="saleCondition" class="form-select">
                        <option value="">Cargando...</option>
                    </select>
                </div>
                <div class="col-md-3 d-none" id="creditTermWrapper">
                    <label class="form-label">Plazo crédito (días)</label>
                    <input type="number" id="creditTerm" class="form-control" min="1" max="999" value="30" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Moneda</label>
                    <select id="currency" class="form-select">
                        <option value="CRC">CRC</option>
                        <option value="USD">USD</option>
                    </select>
                </div>
            </div>

            <!-- ============================================================= -->
            <!-- Métodos de pago (MedioPago Hacienda v4.4). Se pueden elegir    -->
            <!-- uno o varios. El catálogo se carga desde el API central.       -->
            <!-- ============================================================= -->
            <div class="row g-3 mt-2">
                <div class="col-12">
                    <label class="form-label">Métodos de pago</label>
                    <div id="paymentMethodsContainer" class="ei-payment-methods">
                        <span class="text-muted">Cargando métodos de pago...</span>
                    </div>
                    <small class="form-text">Seleccione uno o varios medios de pago (MedioPago de Hacienda).</small>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- Resumen Emisor / Receptor (tarjetas de datos)                         -->
    <!-- Se pobla dinámicamente al seleccionar emisor/receptor. El correo y    -->
    <!-- el teléfono son editables SOLO para este comprobante (no persisten).  -->
    <!-- ===================================================================== -->
    <div class="row g-3 mb-3" id="partySummarySection">
        <!-- Datos del emisor -->
        <div class="col-lg-6">
            <div class="card ei-card h-100" id="issuerSummaryCard">
                <div class="card-body">
                    <h6 class="text-light mb-3"><i class="bi bi-building"></i> Datos del emisor</h6>
                    <div id="issuerSummaryEmpty" class="text-muted small">Seleccione un emisor para ver sus datos.</div>
                    <div id="issuerSummaryBody" class="d-none">
                        <div class="row g-3">
                            <div class="col-8">
                                <div class="party-label">Nombre o Razón social</div>
                                <div class="party-value fw-bold" id="issuerSummaryName">—</div>
                            </div>
                            <div class="col-4">
                                <div class="party-label">Cédula</div>
                                <div class="party-value" id="issuerSummaryId">—</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="party-label">Dirección fiscal</div>
                            <div class="party-value" id="issuerSummaryAddress">—</div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-7">
                                <div class="party-label">Correo electrónico</div>
                                <div class="party-editable" id="issuerEmailWrapper">
                                    <span class="party-value" id="issuerEmailText">—</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2 party-edit-btn"
                                            title="Editar correo (solo para este comprobante)"
                                            onclick="toggleInlineEdit('issuer','Email')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <div class="input-group input-group-sm mt-1 d-none" id="issuerEmailEdit">
                                        <input type="email" class="form-control" id="issuerEmailInput" />
                                        <button type="button" class="btn btn-success" onclick="saveInlineEdit('issuer','Email')"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="cancelInlineEdit('issuer','Email')"><i class="bi bi-x"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="party-label">Teléfono</div>
                                <div class="party-editable" id="issuerPhoneWrapper">
                                    <span class="party-value" id="issuerPhoneText">—</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2 party-edit-btn"
                                            title="Editar teléfono (solo para este comprobante)"
                                            onclick="toggleInlineEdit('issuer','Phone')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <div class="input-group input-group-sm mt-1 d-none" id="issuerPhoneEdit">
                                        <input type="text" class="form-control" id="issuerPhoneInput" />
                                        <button type="button" class="btn btn-success" onclick="saveInlineEdit('issuer','Phone')"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="cancelInlineEdit('issuer','Phone')"><i class="bi bi-x"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Datos del receptor -->
        <div class="col-lg-6">
            <div class="card ei-card h-100" id="receptorSummaryCard">
                <div class="card-body">
                    <h6 class="text-light mb-3"><i class="bi bi-person-vcard"></i> Datos del receptor</h6>
                    <div id="receptorSummaryEmpty" class="text-muted small">Seleccione un receptor para ver sus datos.</div>
                    <div id="receptorSummaryBody" class="d-none">
                        <div class="row g-3">
                            <div class="col-8">
                                <div class="party-label">Nombre o Razón social</div>
                                <div class="party-value fw-bold" id="receptorSummaryName">—</div>
                            </div>
                            <div class="col-4">
                                <div class="party-label">Cédula</div>
                                <div class="party-value" id="receptorSummaryId">—</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="party-label">Dirección fiscal</div>
                            <div class="party-value" id="receptorSummaryAddress">—</div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-7">
                                <div class="party-label">Correo electrónico</div>
                                <div class="party-editable" id="receptorEmailWrapper">
                                    <span class="party-value" id="receptorEmailText">—</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2 party-edit-btn"
                                            title="Editar correo (solo para este comprobante)"
                                            onclick="toggleInlineEdit('receptor','Email')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <div class="input-group input-group-sm mt-1 d-none" id="receptorEmailEdit">
                                        <input type="email" class="form-control" id="receptorEmailInput" />
                                        <button type="button" class="btn btn-success" onclick="saveInlineEdit('receptor','Email')"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="cancelInlineEdit('receptor','Email')"><i class="bi bi-x"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="party-label">Teléfono</div>
                                <div class="party-editable" id="receptorPhoneWrapper">
                                    <span class="party-value" id="receptorPhoneText">—</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2 party-edit-btn"
                                            title="Editar teléfono (solo para este comprobante)"
                                            onclick="toggleInlineEdit('receptor','Phone')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <div class="input-group input-group-sm mt-1 d-none" id="receptorPhoneEdit">
                                        <input type="text" class="form-control" id="receptorPhoneInput" />
                                        <button type="button" class="btn btn-success" onclick="saveInlineEdit('receptor','Phone')"><i class="bi bi-check"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="cancelInlineEdit('receptor','Phone')"><i class="bi bi-x"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Referencia (NC/ND/REP) -->
    <div class="card ei-card mb-3 d-none" id="referenceCard">
        <div class="card-body">
            <h6 class="text-light"><i class="bi bi-link-45deg"></i> Referencia al documento previo (obligatorio)</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Clave del documento referenciado (50 díg.)</label>
                    <input id="refClave" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo doc. ref.</label>
                    <select id="refDocType" class="form-select">
                        <option value="">Cargando…</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha emisión ref.</label>
                    <input id="refDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Código referencia</label>
                    <select id="refCode" class="form-select">
                        <option value="01">Anula documento</option>
                        <option value="02">Corrige monto</option>
                        <option value="04">Referencia a otro documento</option>
                        <option value="12">Comprobante de pago (REP)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Razón</label>
                    <input id="refReason" class="form-control" maxlength="180" />
                </div>
            </div>
        </div>
    </div>

    <!-- Líneas -->
    <div class="card ei-card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-light mb-0"><i class="bi bi-card-list"></i> Detalle</h6>
                <div class="d-flex gap-3 align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="docExonerated">
                        <label class="form-check-label" for="docExonerated">Documento exonerado</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="priceIncludesTax">
                        <label class="form-check-label" for="priceIncludesTax">Precios con IVA incluido (I.V.I.)</label>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-sm ei-line-table">
                    <thead>
                        <tr>
                            <th style="width:3%">#</th>
                            <th style="width:15%">Ítem</th>
                            <th style="width:18%">Descripción</th>
                            <th style="width:8%" class="text-end">Cantidad</th>
                            <th style="width:9%" class="text-end">Precio unitario</th>
                            <th style="width:8%" class="text-end">Monto total</th>
                            <th style="width:8%" class="text-end">Descuentos</th>
                            <th style="width:8%" class="text-end">Subtotal</th>
                            <th style="width:11%" class="text-end">Impuestos</th>
                            <th style="width:8%" class="text-end">Total</th>
                            <th style="width:4%"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody"></tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button class="btn btn-sm btn-outline-warning" type="button" id="selectItemBtn"><i class="bi bi-box-seam"></i> Seleccionar ítem</button>
                <button class="btn btn-sm btn-outline-info" type="button" id="addLineBtn"><i class="bi bi-plus-lg"></i> Añadir línea</button>
                <button type="button" class="btn btn-sm btn-outline-info" id="addOtherChargeBtn"><i class="bi bi-plus-lg"></i> Añadir otro cargo</button>
                <button type="button" class="btn btn-sm btn-outline-info" id="addReferenceBtn"><i class="bi bi-plus-lg"></i> Añadir información de referencia</button>
            </div>
        </div>
    </div>

    <!-- Sección "Otros cargos" del documento (nodo OtrosCargos v4.4) -->
    <div id="otherChargesSection" class="card ei-card mb-3 d-none">
        <div class="card-body">
            <h6 class="text-light mb-2"><i class="bi bi-cash-coin"></i> Otros cargos</h6>
            <div class="table-responsive">
                <table class="table table-dark table-sm ei-line-table mb-2">
                    <thead>
                        <tr>
                            <th style="width:18%">Documento</th>
                            <th style="width:22%">Descripción</th>
                            <th style="width:25%">Identificación tercero</th>
                            <th style="width:12%" class="text-end">Monto</th>
                            <th style="width:10%" class="text-end">Porcentaje (%)</th>
                            <th style="width:9%" class="text-end">Total</th>
                            <th style="width:8%" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="otherChargesBody"></tbody>
                </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="addOtherChargeBtn2"><i class="bi bi-plus-lg"></i> Añadir otro cargo</button>
        </div>
    </div>

    <!-- Sección "Información de referencia" del documento (nodo InformacionReferencia v4.4).
         Se llena desde el modal emergente (botón "Añadir información de referencia"). -->
    <div id="referencesSection" class="card ei-card mb-3 d-none">
        <div class="card-body">
            <h6 class="text-light mb-2"><i class="bi bi-link-45deg"></i> Información de referencia</h6>
            <div class="table-responsive">
                <table class="table table-dark table-sm ei-line-table mb-2">
                    <thead>
                        <tr>
                            <th style="width:18%">Tipo documento</th>
                            <th style="width:34%">Clave / número</th>
                            <th style="width:14%">Fecha</th>
                            <th style="width:14%">Código ref.</th>
                            <th style="width:12%">Razón</th>
                            <th style="width:8%" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="referencesBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Totales -->
    <div class="card ei-card ei-summary-card mb-3">
        <div class="card-body">
            <div class="row text-end">
                <div class="col-md-5 ms-auto">
                    <div class="d-flex justify-content-between mb-2"><span class="ei-sum-label">Venta</span><span class="ei-sum-val" id="tSale">0.00</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="ei-sum-label">Descuentos</span><span class="ei-sum-val" id="tDiscount">0.00</span></div>
                    <div class="ei-sum-sep"></div>
                    <div class="d-flex justify-content-between mb-2"><span class="ei-sum-label">Subtotal (venta neta)</span><span class="ei-sum-val fw-bold" id="tSubtotalNet">0.00</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="ei-sum-label">Impuestos</span><span class="ei-sum-val" id="tTax">0.00</span></div>
                    <div class="d-flex justify-content-between mb-2 d-none" id="tExoneradoRow"><span class="ei-sum-label">Exonerado (IVA)</span><span class="ei-sum-val" id="tExonerado">0.00</span></div>
                    <div class="ei-sum-sep"></div>
                    <div class="d-flex justify-content-between fs-5"><span class="ei-sum-total-label">Total</span><span class="ei-sum-total-val" id="tTotal">0.00</span></div>
                    <span id="tSubtotal" class="d-none">0.00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Datos de exoneración: visible solo cuando hay al menos una línea exonerada -->
    <div class="card ei-card mb-3 d-none" id="exonCard">
        <div class="card-body">
            <h6 class="text-light mb-3"><i class="bi bi-patch-check"></i> Datos de la exoneración</h6>
            <div class="alert alert-warning py-2 small mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Estos datos deben corresponder a la <strong>autorización de exoneración real</strong> del cliente.
                Hacienda los valida contra su registro. Los valores por defecto solo evitan errores de esquema en pruebas.
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo de documento</label>
                    <select id="exonDocType" class="form-select">
                        <option value="01">01 - Compras autorizadas por la DGT</option>
                        <option value="02">02 - Ventas exentas a diplomáticos</option>
                        <option value="03">03 - Autorizado por Ley especial</option>
                        <option value="04">04 - Exenciones DGH autorización local genérica</option>
                        <option value="05">05 - Transitorio V (servicios de ingeniería/arquitectura)</option>
                        <option value="06">06 - Transitorio IX (recolección/reciclaje)</option>
                        <option value="07">07 - Transitorio XVII (Régimen de zona franca)</option>
                        <option value="08">08 - Exoneración a Zonas Francas</option>
                        <option value="09">09 - Exoneración de servicios complementarios ZF</option>
                        <option value="10">10 - Órdenes especiales (contratación pública)</option>
                        <option value="11">11 - Exoneración Instituciones/Órganos públicos</option>
                        <option value="99" selected>99 - Otros</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de documento / autorización</label>
                    <input id="exonDocNumber" class="form-control" maxlength="40" value="000"
                           placeholder="N.º de la autorización de exoneración">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Institución que emite</label>
                    <select id="exonInstitution" class="form-select">
                        <option value="01">01 - Ministerio de Hacienda</option>
                        <option value="02">02 - Ministerio de Relaciones Exteriores y Culto</option>
                        <option value="03">03 - Ministerio de Agricultura y Ganadería</option>
                        <option value="04">04 - Ministerio de Economía, Industria y Comercio</option>
                        <option value="05">05 - Cruz Roja Costarricense</option>
                        <option value="06">06 - Benemérito Cuerpo de Bomberos de Costa Rica</option>
                        <option value="07">07 - Asociación Obras del Espíritu Santo</option>
                        <option value="08">08 - Federación Cruzada Nacional protección Ancianos (Fecrunapa)</option>
                        <option value="09">09 - Escuela de Agricultura de la Región Húmeda (EARTH)</option>
                        <option value="10">10 - Instituto Centroamericano de Administración de Empresas (INCAE)</option>
                        <option value="11">11 - Junta de Protección Social (JPS)</option>
                        <option value="12">12 - Autoridad Reguladora de los Servicios Públicos (Aresep)</option>
                        <option value="99" selected>99 - Otros</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de emisión de la exoneración</label>
                    <input id="exonDate" type="date" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Porcentaje de exoneración (%)</label>
                    <input id="exonPercent" type="number" class="form-control" min="1" max="100" step="1" value="100">
                    <small class="form-text">100 = exoneración total del IVA de la línea.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-success" id="emitBtn"><i class="bi bi-send-check"></i> Emitir y enviar a Hacienda</button>
    </div>

    <div id="emitResult" class="mt-3"></div>

    <!-- Consola de progreso estilo CMD -->
    <div id="emitConsoleCard" class="card ei-card mt-3 d-none">
        <div class="card-header d-flex align-items-center justify-content-between" style="background:#0d1117;border-bottom:1px solid #24304f;">
            <span class="text-light"><i class="bi bi-terminal me-2"></i>Consola de emisión</span>
            <span id="emitConsoleStatus" class="badge bg-secondary">En espera</span>
        </div>
        <div id="emitConsole" style="background:#0b0e14;color:#c9d1d9;font-family:'Cascadia Code','Consolas',monospace;font-size:.82rem;line-height:1.5;padding:1rem;max-height:340px;overflow-y:auto;white-space:pre-wrap;border-radius:0 0 .375rem .375rem;"></div>
    </div>
</div>

