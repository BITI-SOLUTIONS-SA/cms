    /**
     * Busca un emisor/receptor por número de identificación y lo autoselecciona
     * (llena el hidden input y el campo visible). Se usa en la precarga de NC/ND
     * para fijar el mismo emisor/receptor del documento origen que se va a reversar.
     * kind: 'issuer' o 'receptor'. identification: número de identificación a buscar.
     */
    async function autoSelectParty(kind, identification) {
        try {
            const url = kind === 'issuer'
                ? '/api/CustomerBillingCredential/search-issuers'
                : '/api/Supplier/search-receptors';
            const params = new URLSearchParams({ searchTerm: identification });
            const resp = await emitFetch(`${url}?${params}`);
            if (!resp.ok) return false;
            const list = await resp.json();
            if (!Array.isArray(list) || list.length === 0) return false;

            // Coincidencia exacta por identificación; si no, el primer resultado.
            const norm = s => (s || '').toString().trim();
            const match = list.find(x => norm(x.identification) === norm(identification)) || list[0];
            const id = kind === 'issuer' ? match.idCredential : match.idSupplier;
            const ident = match.identification || match.foreignIdentification || '';
            const display = `${match.name} (${ident})`;
            if (kind === 'issuer') {
                document.getElementById('issuerId').value = id;
                document.getElementById('issuerDisplay').value = display;
                document.getElementById('issuerDisplay')?.classList.remove('cabys-invalid');
            } else {
                document.getElementById('receptorId').value = id;
                document.getElementById('receptorDisplay').value = display;
            }
            return true;
        } catch (e) {
            console.warn(`[Reversa] No se pudo autoseleccionar ${kind} por identificación ${identification}:`, e);
            return false;
        }
    }
    window.autoSelectParty = autoSelectParty;

    /**
     * Fija directamente el emisor/receptor a partir del ID de catálogo persistido en
     * el documento origen (IdCustomerIssuer / IdCustomerReceptor) y del objeto con sus
     * datos (nombre + identificación) que ya viene en el JSON del documento. No hace
     * ninguna búsqueda: es la vía preferida en la precarga de REP/NC/ND porque no
     * depende de que el receptor siga apareciendo en el catálogo de proveedores.
     * kind: 'issuer' | 'receptor'. id: entero del catálogo. party: { Nombre, Identificacion* }.
     */
    function setParty(kind, id, party) {
        if (!id) return false;
        const p = party || {};
        const nombre = p.nombre ?? p.Nombre ?? '';
        const ident = p.identificacionNumero ?? p.IdentificacionNumero
                    ?? p.identificacionExtranjero ?? p.IdentificacionExtranjero ?? '';
        const display = ident ? `${nombre} (${ident})` : nombre;
        if (kind === 'issuer') {
            document.getElementById('issuerId').value = id;
            document.getElementById('issuerDisplay').value = display;
            document.getElementById('issuerDisplay')?.classList.remove('cabys-invalid');
        } else {
            document.getElementById('receptorId').value = id;
            document.getElementById('receptorDisplay').value = display;
        }
        return true;
    }
    window.setParty = setParty;

    // Mapea el porcentaje de IVA al CodigoTarifaIVA v4.4.
    //  13% → 08 (tarifa general) | 0% → 01 (exento) | otros según tabla Hacienda.
    function mapTaxRateCode(ratePct) {
        switch (Math.round((parseFloat(ratePct) || 0) * 100) / 100) {
            case 0: return '01';
            case 1: return '02';
            case 2: return '03';
            case 4: return '04';
            case 0.5: return '11';
            case 13: return '08';
            default: return '08';
        }
    }

    // Función helper para escapar HTML
    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // ---------------- Estado ----------------
    let lineSeq = 0;

    function addLine(prefill) {
        lineSeq++;
        const tr = document.createElement('tr');
        tr.dataset.id = lineSeq;
        tr.innerHTML = `
            <td><input class="form-control form-control-sm cabys" maxlength="13" placeholder="0000000000000"></td>
            <td><input class="form-control form-control-sm detail" placeholder="Descripción"></td>
            <td><input class="form-control form-control-sm text-end qty" type="number" value="1" min="0" step="0.001"></td>
            <td><input class="form-control form-control-sm text-end price" type="number" value="0" min="0" step="0.00001"></td>
            <td><input class="form-control form-control-sm text-end rate" type="number" value="13" min="0" step="0.01"></td>
            <td><input class="form-control form-control-sm text-end disc" type="number" value="0" min="0" step="0.00001"></td>
            <td>
                <select class="form-select form-select-sm nature">
                    <option value="">—</option>
                    <option value="04">Volumen</option>
                    <option value="05">Temporada</option>
                    <option value="06">Promoción</option>
                </select>
            </td>
            <td class="text-center align-middle">
                <input class="form-check-input exon" type="checkbox" title="Exonerar esta línea">
            </td>
            <td class="text-end lineTotal">0.00</td>
            <td><button class="btn btn-sm btn-outline-danger removeLine"><i class="bi bi-x"></i></button></td>`;
        document.getElementById('linesBody').appendChild(tr);

        const cabys = tr.querySelector('.cabys');
        cabys.addEventListener('blur', async () => {
            if (!isValidCabys(cabys.value)) {
                cabys.classList.add('cabys-invalid'); cabys.classList.remove('cabys-valid');
                return;
            }
            // Autocompletar tarifa/descripcion desde el catálogo CAByS.
            try {
                const r = await emitFetch(`/api/cabys/${cabys.value}`);
                if (r.ok) {
                    const d = await r.json();
                    if (d && d.taxRate != null) tr.querySelector('.rate').value = d.taxRate;
                    if (d && d.description && !tr.querySelector('.detail').value) tr.querySelector('.detail').value = d.description;
                    cabys.classList.add('cabys-valid'); cabys.classList.remove('cabys-invalid');
                }
            } catch { /* offline: solo validación de formato */ }
            recalc();
        });

        tr.querySelectorAll('.qty,.price,.rate,.disc').forEach(el => el.addEventListener('input', recalc));
        tr.querySelector('.exon').addEventListener('change', recalc);
        tr.querySelector('.removeLine').addEventListener('click', () => { tr.remove(); recalc(); });

        if (prefill) {
            tr.querySelector('.cabys').value = prefill.cabys || '';
            tr.querySelector('.detail').value = prefill.detail || '';
            if (prefill.quantity != null) tr.querySelector('.qty').value = prefill.quantity;
            if (prefill.unitPrice != null) tr.querySelector('.price').value = prefill.unitPrice;
            if (prefill.taxRate != null) tr.querySelector('.rate').value = prefill.taxRate;
            if (prefill.discount != null) tr.querySelector('.disc').value = prefill.discount;
            if (prefill.nature) tr.querySelector('.nature').value = prefill.nature;
            if (prefill.exonerated) tr.querySelector('.exon').checked = true;

            // Modo "reversar factura": la línea proviene del documento origen.
            // Se bloquea CAByS, detalle y tarifa para impedir alterar/inventar líneas.
            if (prefill.locked) {
                tr.classList.add('nc-source-line');
                ['cabys', 'detail', 'rate'].forEach(cls => {
                    const el = tr.querySelector('.' + cls);
                    el.setAttribute('readonly', 'readonly');
                    el.classList.add('cabys-valid');
                });
                // Naturaleza de descuento también bloqueada (viene del origen)
                tr.querySelector('.nature').setAttribute('disabled', 'disabled');
            }
        }
        recalc();
    }

    // ---------------- Cálculo (incluye IVI inverso) ----------------
    function recalc() {
        const ivi = document.getElementById('priceIncludesTax').checked;
        const docExon = document.getElementById('docExonerated').checked;
        // Porcentaje de exoneración configurado en la tarjeta de datos (default 100).
        let exonPct = parseFloat(document.getElementById('exonPercent')?.value) || 100;
        if (exonPct < 1) exonPct = 1; if (exonPct > 100) exonPct = 100;
        let sub = 0, disc = 0, tax = 0, total = 0, exon = 0;
        let anyExon = false;
        document.querySelectorAll('#linesBody tr').forEach(tr => {
            const qty = parseFloat(tr.querySelector('.qty').value) || 0;
            const price = parseFloat(tr.querySelector('.price').value) || 0;
            const rate = (parseFloat(tr.querySelector('.rate').value) || 0) / 100;
            const d = parseFloat(tr.querySelector('.disc').value) || 0;
            const exonChk = tr.querySelector('.exon');
            // Documento exonerado → todas las líneas se marcan y bloquean.
            if (docExon) { exonChk.checked = true; exonChk.setAttribute('disabled', 'disabled'); }
            else { exonChk.removeAttribute('disabled'); }
            const lineExon = exonChk.checked;
            if (lineExon) anyExon = true;

            const unitBase = (ivi && rate > 0) ? price / (1 + rate) : price;
            const gross = unitBase * qty;
            let base = gross - d; if (base < 0) base = 0;
            const fullTax = base * rate;
            const exonAmount = lineExon ? (fullTax * exonPct / 100) : 0;   // % exoneración por línea (UI)
            const netTax = fullTax - exonAmount;
            const lineTotal = base + netTax;

            tr.classList.toggle('ei-line-exon', lineExon);
            tr.querySelector('.lineTotal').textContent = lineTotal.toFixed(2);
            sub += gross; disc += d; tax += netTax; exon += exonAmount; total += lineTotal;
        });
        document.getElementById('tSubtotal').textContent = sub.toFixed(2);
        document.getElementById('tDiscount').textContent = disc.toFixed(2);
        document.getElementById('tTax').textContent = tax.toFixed(2);
        document.getElementById('tTotal').textContent = total.toFixed(2);
        const tExon = document.getElementById('tExonerado');
        if (tExon) tExon.textContent = exon.toFixed(2);

        // Mostrar la tarjeta de datos de exoneración solo cuando hay al menos una línea exonerada.
        // Al mostrarse por primera vez se preseleccionan los valores por defecto.
        const exonCard = document.getElementById('exonCard');
        if (exonCard) {
            const wasHidden = exonCard.classList.contains('d-none');
            exonCard.classList.toggle('d-none', !anyExon);
            if (anyExon && wasHidden) ensureExonDefaults();
        }
    }

    // Preselecciona los valores por defecto de la exoneración cuando aún no se han fijado.
    // Siempre deja datos default cuando hay al menos una línea exonerada en el documento.
    function ensureExonDefaults() {
        const dt = document.getElementById('exonDocType');
        const inst = document.getElementById('exonInstitution');
        const num = document.getElementById('exonDocNumber');
        const date = document.getElementById('exonDate');
        const pct = document.getElementById('exonPercent');
        if (dt && !dt.value) dt.value = '99';
        if (inst && !inst.value) inst.value = '99';
        if (num && !num.value.trim()) num.value = '0';
        if (pct && (!pct.value || parseFloat(pct.value) < 1)) pct.value = '100';
        if (date && !date.value) {
            const now = new Date();
            date.value = now.toISOString().slice(0, 10); // yyyy-MM-dd
        }
    }

