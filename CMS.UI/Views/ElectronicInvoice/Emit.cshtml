                            <label class="form-check-label small" for="ltmExonStandard">Exoneración estándar (exonera el 100% del impuesto)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="ltmExonMode" id="ltmExonFull" value="full" onchange="onExonModeChange()">
                            <label class="form-check-label small" for="ltmExonFull">Exoneración completa (tarifa exonerada específica)</label>
                        </div>
