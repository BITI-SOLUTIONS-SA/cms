    /**
     * Busca un emisor/receptor por número de identificación y lo autoselecciona
     * (llena el hidden input y el campo visible). Se usa en la precarga de NC/ND
     * para fijar el mismo emisor/receptor del documento origen que se va a reversar.
     * kind: 'issuer' o 'receptor'. identification: número de identificación a buscar.
     */
    async function autoSelectParty(kind, identification) {
        try {
            const url = kind === 'issuer'
                ? '/api/CustomerBillingCredential/search-issuers'
                : '/api/Customer/search-receptors';
            const params = new URLSearchParams({ searchTerm: identification });
            const resp = await emitFetch(`${url}?${params}`);
            if (!resp.ok) return false;
            const list = await resp.json();
            if (!Array.isArray(list) || list.length === 0) return false;

            // Coincidencia exacta por identificación; si no, el primer resultado.
            const norm = s => (s || '').toString().trim();
            const match = list.find(x => norm(x.identification) === norm(identification)) || list[0];
            const id = kind === 'issuer' ? match.idCredential : match.idCustomer;
            const ident = match.identification || match.foreignIdentification || '';
            const display = `${match.name} (${ident})`;
            if (kind === 'issuer') {
                document.getElementById('issuerId').value = id;
                document.getElementById('issuerDisplay').value = display;
                document.getElementById('issuerDisplay')?.classList.remove('cabys-invalid');
                loadConsecutives();
                loadIssuerActivities(id);
                loadPartyDetail('issuer', id);
                updateLineButtonsState();
            } else {
                document.getElementById('receptorId').value = id;
                document.getElementById('receptorDisplay').value = display;
                loadReceptorActivities(id);
                loadPartyDetail('receptor', id);
            }
            return true;
        } catch (e) {
            console.warn(`[Reversa] No se pudo autoseleccionar ${kind} por identificación ${identification}:`, e);
            return false;
        }
    }
    window.autoSelectParty = autoSelectParty;

    /**
     * Fija directamente el emisor/receptor a partir del ID de catálogo persistido en
     * el documento origen (IdCustomerIssuer / IdCustomerReceptor) y del objeto con sus
     * datos (nombre + identificación) que ya viene en el JSON del documento. No hace
     * ninguna búsqueda: es la vía preferida en la precarga de REP/NC/ND porque no
     * depende de que el receptor siga apareciendo en el catálogo de proveedores.
     * kind: 'issuer' | 'receptor'. id: entero del catálogo. party: { Nombre, Identificacion* }.
     */
    function setParty(kind, id, party) {
        if (!id) return false;
        const p = party || {};
        const nombre = p.nombre ?? p.Nombre ?? '';
        const ident = p.identificacionNumero ?? p.IdentificacionNumero
                    ?? p.identificacionExtranjero ?? p.IdentificacionExtranjero ?? '';
        const display = ident ? `${nombre} (${ident})` : nombre;
        if (kind === 'issuer') {
            document.getElementById('issuerId').value = id;
            document.getElementById('issuerDisplay').value = display;
            document.getElementById('issuerDisplay')?.classList.remove('cabys-invalid');
            loadConsecutives();
            loadIssuerActivities(id);
            loadPartyDetail('issuer', id);
            updateLineButtonsState();
        } else {
            document.getElementById('receptorId').value = id;
            document.getElementById('receptorDisplay').value = display;
            loadReceptorActivities(id);
            loadPartyDetail('receptor', id);
        }
        return true;
    }
    window.setParty = setParty;

    // ---------------- Tarjetas resumen Emisor / Receptor ----------------
    // Estado en memoria del correo/teléfono efectivos (posiblemente editados
    // inline). Solo aplican a ESTE comprobante; no persisten en la credencial.
    const partyState = {
        issuer:   { email: '', phone: '', phoneCode: '' },
        receptor: { email: '', phone: '', phoneCode: '' }
    };
    window.partyState = partyState;

    const partyEndpoint = {
        issuer:   id => `/api/CustomerBillingCredential/${id}/emit-detail`,
        receptor: id => `/api/Customer/${id}/emit-detail`
    };

    function formatPhone(code, phone) {
        if (!phone) return '—';
        return code ? `(${code}) ${phone}` : phone;
    }

    // Carga el detalle de la parte (emisor/receptor) y puebla su tarjeta.
    async function loadPartyDetail(kind, id) {
        const emptyEl = document.getElementById(`${kind}SummaryEmpty`);
        const bodyEl = document.getElementById(`${kind}SummaryBody`);
        if (!emptyEl || !bodyEl) return;

        if (!id) {
            bodyEl.classList.add('d-none');
            emptyEl.classList.remove('d-none');
            partyState[kind] = { email: '', phone: '', phoneCode: '' };
            return;
        }

        try {
            const r = await emitFetch(partyEndpoint[kind](id));
            if (!r.ok) throw new Error('No se pudo cargar el detalle');
            const d = await r.json();

            document.getElementById(`${kind}SummaryName`).textContent = d.name || '—';
            document.getElementById(`${kind}SummaryId`).textContent = d.identification || '—';
            document.getElementById(`${kind}SummaryAddress`).textContent = d.addressText || '—';

            partyState[kind] = {
                email: d.email || '',
                phone: d.phone || '',
                phoneCode: d.phoneCode || ''
            };
            document.getElementById(`${kind}EmailText`).textContent = d.email || '—';
            document.getElementById(`${kind}PhoneText`).textContent = formatPhone(d.phoneCode, d.phone);

            // Cerrar cualquier edición inline abierta previamente.
            cancelInlineEdit(kind, 'Email');
            cancelInlineEdit(kind, 'Phone');

            emptyEl.classList.add('d-none');
            bodyEl.classList.remove('d-none');
        } catch (e) {
            console.error(`Error al cargar detalle de ${kind}:`, e);
            emptyEl.textContent = 'No se pudo cargar el detalle.';
            emptyEl.classList.remove('d-none');
            bodyEl.classList.add('d-none');
        }
    }
    window.loadPartyDetail = loadPartyDetail;

    // Abre el input de edición inline y precarga el valor actual.
    function toggleInlineEdit(kind, field) {
        const editEl = document.getElementById(`${kind}${field}Edit`);
        const input = document.getElementById(`${kind}${field}Input`);
        if (!editEl || !input) return;
        input.value = field === 'Email' ? partyState[kind].email : partyState[kind].phone;
        editEl.classList.remove('d-none');
        input.focus();
    }
    window.toggleInlineEdit = toggleInlineEdit;

    // Confirma la edición inline: actualiza el estado y el texto mostrado.
    function saveInlineEdit(kind, field) {
        const input = document.getElementById(`${kind}${field}Input`);
        if (!input) return;
        const val = (input.value || '').trim();
        if (field === 'Email') {
            partyState[kind].email = val;
            document.getElementById(`${kind}EmailText`).textContent = val || '—';
        } else {
            partyState[kind].phone = val;
            document.getElementById(`${kind}PhoneText`).textContent = formatPhone(partyState[kind].phoneCode, val);
        }
        document.getElementById(`${kind}${field}Edit`).classList.add('d-none');
    }
    window.saveInlineEdit = saveInlineEdit;

    // Cancela la edición inline sin aplicar cambios.
    function cancelInlineEdit(kind, field) {
        const editEl = document.getElementById(`${kind}${field}Edit`);
        if (editEl) editEl.classList.add('d-none');
    }
    window.cancelInlineEdit = cancelInlineEdit;

    // Mapea el porcentaje de IVA al CodigoTarifaIVA v4.4.
    //  13% → 08 (tarifa general) | 0% → 01 (exento) | otros según tabla Hacienda.
    function mapTaxRateCode(ratePct) {
        switch (Math.round((parseFloat(ratePct) || 0) * 100) / 100) {
            case 0: return '01';
            case 1: return '02';
            case 2: return '03';
            case 4: return '04';
            case 0.5: return '11';
            case 13: return '08';
            default: return '08';
        }
    }

    // Función helper para escapar HTML
    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // ---------------- Estado ----------------
    let lineSeq = 0;

    // Fila actualmente en edición desde los modales de descuento/impuesto.
    let editingLineTr = null;

    // ── Modal Descuento de línea (múltiples descuentos por línea) ──
    function openDiscountModal(tr) {
        editingLineTr = tr;
        // Cargar la lista existente desde el hidden JSON de la fila.
        let list = [];
        try { list = JSON.parse(tr.querySelector('.discList')?.value || '[]') || []; } catch { list = []; }
        // Compatibilidad: si aún no hay lista pero hay un escalar antiguo, migrarlo.
        if (list.length === 0) {
            const legacyAmt = parseFloat(tr.querySelector('.disc')?.value) || 0;
            const legacyNat = tr.querySelector('.nature')?.value || '';
            if (legacyAmt > 0) list.push({ nature: legacyNat, amount: legacyAmt });
        }
        // Monto bruto de la línea (cantidad × precio, o base sin IVA si IVI).
        document.getElementById('ldmLineGross').textContent = lineGrossAmount(tr).toFixed(2);
        hideDiscountError();
        // Filtrar naturalezas de descuento según el CAByS de la línea, luego renderizar.
        loadAllowedDiscountsForCabys(getLineCabysCode(tr)).finally(() => renderDiscountRows(list));
        bootstrap.Modal.getOrCreateInstance(document.getElementById('lineDiscountModal')).show();
    }
    window.openDiscountModal = openDiscountModal;

    // Calcula el monto bruto de la línea en edición (respeta IVI).
    function lineGrossAmount(tr) {
        const ivi = document.getElementById('priceIncludesTax')?.checked;
        const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
        const price = parseFloat(tr.querySelector('.price')?.value) || 0;
        const ratePct = parseFloat(tr.querySelector('.rate')?.value) || 0;
        const rate = ratePct / 100;
        const unitBase = (ivi && rate > 0) ? price / (1 + rate) : price;
        return unitBase * qty;
    }

    function discountRowTemplate(idx, nature, amount) {
        return `
            <div class="d-flex gap-2 align-items-end mb-2 discount-row">
                <div class="flex-grow-1">
                    <label class="form-label small mb-1">Código de Descuento</label>
                    <select class="form-select form-select-sm ldmRowNature">${buildNatureOptions(nature)}</select>
                </div>
                <div style="width:170px;">
                    <label class="form-label small mb-1">Monto</label>
                    <input type="number" class="form-control form-control-sm text-end ldmRowAmount"
                           min="0" step="1" value="${amount != null ? amount : ''}" placeholder="0.00"
                           oninput="onDiscountAmountInput(this)">
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                            onclick="removeDiscountRow(this)"><i class="bi bi-trash"></i></button>
                </div>
            </div>`;
    }

    function renderDiscountRows(list) {
        const container = document.getElementById('ldmRows');
        container.innerHTML = '';
        (list || []).forEach((d, i) => {
            container.insertAdjacentHTML('beforeend', discountRowTemplate(i, d.nature || '', d.amount));
        });
        // Enlazar recálculo del total al cambiar la naturaleza.
        container.querySelectorAll('.ldmRowNature').forEach(sel =>
            sel.addEventListener('change', updateDiscountTotal));
        toggleDiscountEmpty();
        updateDiscountTotal();
    }

    function addDiscountRow() {
        const container = document.getElementById('ldmRows');
        container.insertAdjacentHTML('beforeend', discountRowTemplate(container.children.length, '', ''));
        const sel = container.lastElementChild.querySelector('.ldmRowNature');
        if (sel) sel.addEventListener('change', updateDiscountTotal);
        toggleDiscountEmpty();
        updateDiscountTotal();
    }
    window.addDiscountRow = addDiscountRow;

    function removeDiscountRow(btn) {
        btn.closest('.discount-row')?.remove();
        toggleDiscountEmpty();
        updateDiscountTotal();
    }
    window.removeDiscountRow = removeDiscountRow;

    // Impide montos negativos mientras se digita.
    function onDiscountAmountInput(input) {
        if (parseFloat(input.value) < 0) input.value = 0;
        updateDiscountTotal();
    }
    window.onDiscountAmountInput = onDiscountAmountInput;

    function toggleDiscountEmpty() {
        const hasRows = document.querySelectorAll('#ldmRows .discount-row').length > 0;
        document.getElementById('ldmEmpty').classList.toggle('d-none', hasRows);
    }

    function updateDiscountTotal() {
        let total = 0;
        document.querySelectorAll('#ldmRows .discount-row').forEach(r => {
            total += parseFloat(r.querySelector('.ldmRowAmount').value) || 0;
        });
        const totalEl = document.getElementById('ldmTotal');
        totalEl.textContent = total.toFixed(2);
        const gross = parseFloat(document.getElementById('ldmLineGross').textContent) || 0;
        totalEl.classList.toggle('text-danger', total > gross + 0.0001);
    }

    function showDiscountError(msg) {
        const el = document.getElementById('ldmError');
        el.textContent = msg;
        el.classList.remove('d-none');
    }
    function hideDiscountError() {
        document.getElementById('ldmError').classList.add('d-none');
    }

    function saveLineDiscount() {
        if (!editingLineTr) return;
        hideDiscountError();
        const rows = [...document.querySelectorAll('#ldmRows .discount-row')];
        const list = [];
        for (const r of rows) {
            const nature = r.querySelector('.ldmRowNature').value;
            const amount = parseFloat(r.querySelector('.ldmRowAmount').value) || 0;
            // Si el usuario agregó una fila de descuento debe seleccionar un código
            // y el monto debe ser mayor a 0.
            if (!nature) {
                showDiscountError('Es obligatorio seleccionar un código de descuento para cada descuento.');
                return;
            }
            if (amount <= 0) {
                showDiscountError('El monto de cada descuento debe ser mayor a 0.');
                return;
            }
            list.push({ nature: nature, amount: amount });
        }
        // Cap: la suma de descuentos no puede superar el monto bruto de la línea.
        const total = list.reduce((s, d) => s + d.amount, 0);
        const gross = lineGrossAmount(editingLineTr);
        if (total > gross + 0.0001) {
            showDiscountError(`La suma de descuentos (${total.toFixed(2)}) no puede superar el monto total de la línea (${gross.toFixed(2)}).`);
            return;
        }
        // Persistir en la fila: lista JSON + escalares (suma y naturaleza principal).
        editingLineTr.querySelector('.discList').value = JSON.stringify(list);
        editingLineTr.querySelector('.disc').value = total;
        editingLineTr.querySelector('.nature').value = list.length > 0 ? list[0].nature : '';
        bootstrap.Modal.getInstance(document.getElementById('lineDiscountModal'))?.hide();
        recalc();
    }
    window.saveLineDiscount = saveLineDiscount;

    function clearLineDiscount() {
        if (!editingLineTr) return;
        editingLineTr.querySelector('.discList').value = '[]';
        editingLineTr.querySelector('.disc').value = 0;
        editingLineTr.querySelector('.nature').value = '';
        bootstrap.Modal.getInstance(document.getElementById('lineDiscountModal'))?.hide();
        recalc();
    }
    window.clearLineDiscount = clearLineDiscount;

    // ── Modal Impuesto de línea ──
    // ════════════════════════════════════════════════════════════════════
    //  MODAL DE IMPUESTOS (multi-impuesto por línea)
    //  Modelo de trabajo: ltmTaxes = array de objetos impuesto:
    //    { taxTypeId, taxCode, rate, rateCode, exonMode, exonPercent,
    //      exonAuthType, exonDate, exonDocNumber, exonArticle,
    //      exonSubsection, exonInstitution }
    //  Se persiste por línea en el hidden .taxList (JSON). Para
    //  retrocompatibilidad, el primer impuesto también se refleja en los
    //  campos planos (.rate/.taxType/.exon*) que consumen recalc()/emit().
    // ════════════════════════════════════════════════════════════════════
    let ltmTaxes = [];        // impuestos de la línea en edición (copia de trabajo)
    let ltmEditIndex = -1;    // índice que se edita en el editor (-1 = alta)

    // Devuelve la lista de impuestos de una fila. Si existe .taxList la usa;
    // si no, reconstruye un único impuesto desde los campos planos (líneas viejas).
    function getLineTaxes(tr) {
        const raw = tr.querySelector('.taxList')?.value;
        if (raw) {
            try { const arr = JSON.parse(raw); if (Array.isArray(arr) && arr.length) return arr; } catch { }
        }
        const exonMode = tr.querySelector('.exonMode')?.value
            || ((tr.querySelector('.exon')?.value === '1') ? 'standard' : 'none');
        return [{
            taxTypeId: tr.querySelector('.taxType')?.value || '1',
            taxCode: '01',
            rate: parseFloat(tr.querySelector('.rate')?.value) || 0,
            rateCode: tr.querySelector('.taxRateCode')?.value || '',
            exonMode: exonMode,
            exonPercent: parseFloat(tr.querySelector('.exonPercent')?.value) || (exonMode === 'full' ? 0 : 100),
            exonAuthType: tr.querySelector('.exonAuthType')?.value || '',
            exonDate: tr.querySelector('.exonDate')?.value || '',
            exonDocNumber: tr.querySelector('.exonDocNumber')?.value || '',
            exonArticle: tr.querySelector('.exonArticle')?.value || '',
            exonSubsection: tr.querySelector('.exonSubsection')?.value || '',
            exonInstitution: tr.querySelector('.exonInstitution')?.value || ''
        }];
    }

    // Código de impuesto (01, 02, …) para el tipo id seleccionado.
    function taxCodeForType(taxTypeId) {
        const t = (taxTypes || []).find(x => String(x.id) === String(taxTypeId));
        return t ? t.code : '01';
    }
    // Descripción del tipo de impuesto.
    function taxDescForType(taxTypeId) {
        const t = (taxTypes || []).find(x => String(x.id) === String(taxTypeId));
        return t ? (t.code + ' - ' + t.description) : (taxTypeId || '');
    }
    function exonAuthLabel(code) {
        const t = (exonAuthTypes || []).find(x => String(x.code) === String(code));
        return t ? (t.code + ' - ' + t.name) : code;
    }

    // Calcula el importe de impuesto y exoneración de un impuesto sobre la base de la línea.
    function ltmTaxAmounts(tax) {
        const ivi = document.getElementById('priceIncludesTax')?.checked;
        const qty = parseFloat(editingLineTr?.querySelector('.qty')?.value) || 0;
        const price = parseFloat(editingLineTr?.querySelector('.price')?.value) || 0;
        const d = parseFloat(editingLineTr?.querySelector('.disc')?.value) || 0;
        // La base imponible usa la tarifa COMBINADA de todos los impuestos (I.V.I.).
        const combinedRate = ltmTaxes.reduce((s, t) => s + (parseFloat(t.rate) || 0), 0) / 100;
        const ratePct = parseFloat(tax.rate) || 0;
        const rate = ratePct / 100;
        const unitBase = (ivi && combinedRate > 0) ? price / (1 + combinedRate) : price;
        const gross = unitBase * qty;
        let base = gross - d; if (base < 0) base = 0;
        const taxAmount = base * rate;
        let exonAmount = 0;
        if (tax.exonMode === 'standard') {
            exonAmount = taxAmount;
        } else if (tax.exonMode === 'full') {
            let ep = parseFloat(tax.exonPercent) || 0;
            if (ep < 0) ep = 0; if (ep > ratePct) ep = ratePct;
            exonAmount = base * ep / 100;
        }
        return { taxAmount, exonAmount, netTax: taxAmount - exonAmount };
    }

    // Abre el modal en modo LISTA con las tarjetas de impuestos de la línea.
    function openTaxModal(tr) {
        editingLineTr = tr;
        ltmTaxes = getLineTaxes(tr).map(t => Object.assign({}, t));
        ltmEditIndex = -1;
        showTaxListView();
        // Filtrar tipos de impuesto según el CAByS de la línea, luego renderizar.
        loadAllowedTaxesForCabys(getLineCabysCode(tr)).finally(() => renderTaxCards());
        bootstrap.Modal.getOrCreateInstance(document.getElementById('lineTaxModal')).show();
    }
    window.openTaxModal = openTaxModal;

    function showTaxListView() {
        document.getElementById('ltmListView')?.classList.remove('d-none');
        document.getElementById('ltmEditorView')?.classList.add('d-none');
        document.getElementById('ltmAddTaxBtn')?.classList.remove('d-none');
        document.getElementById('ltmOkBtn')?.classList.remove('d-none');
    }
    function showTaxEditorView() {
        document.getElementById('ltmListView')?.classList.add('d-none');
        document.getElementById('ltmEditorView')?.classList.remove('d-none');
        document.getElementById('ltmAddTaxBtn')?.classList.add('d-none');
        document.getElementById('ltmOkBtn')?.classList.add('d-none');
    }

    // Dibuja las tarjetas de impuestos y el resumen de totales.
    function renderTaxCards() {
        const cont = document.getElementById('ltmCardList');
        const empty = document.getElementById('ltmEmptyHint');
        if (!cont) return;
        cont.innerHTML = '';
        let sumTax = 0, sumExon = 0;
        ltmTaxes.forEach((tax, i) => {
            const a = ltmTaxAmounts(tax);
            sumTax += a.taxAmount; sumExon += a.exonAmount;
            const exonBlock = (tax.exonMode !== 'none') ? `
                <div class="row ltm-exon-row">
                    <div class="col-7">
                        <div class="ltm-lbl">Exoneración</div>
                        <div class="ltm-val">${escapeHtmlNature(exonAuthLabel(tax.exonAuthType) || 'Exoneración')}${tax.exonDate ? ' (' + escapeHtmlNature(tax.exonDate) + ')' : ''}</div>
                    </div>
                    <div class="col-3 text-end">
                        <div class="ltm-lbl">% tarifa exonerada</div>
                        <div class="ltm-val">${(tax.exonMode === 'standard' ? (parseFloat(tax.rate) || 0) : (parseFloat(tax.exonPercent) || 0)).toFixed(2)} %</div>
                    </div>
                    <div class="col-2 text-end">
                        <div class="ltm-lbl">Monto</div>
                        <div class="ltm-val">${a.exonAmount.toFixed(2)}</div>
                    </div>
                </div>` : '';
            const card = document.createElement('div');
            card.className = 'ltm-card';
            card.innerHTML = `
                <div class="row align-items-start">
                    <div class="col-7">
                        <div class="ltm-lbl">Impuesto</div>
                        <div class="ltm-val">${escapeHtmlNature(taxDescForType(tax.taxTypeId))}</div>
                    </div>
                    <div class="col-2 text-end">
                        <div class="ltm-lbl">Tarifa</div>
                        <div class="ltm-val">${(parseFloat(tax.rate) || 0).toFixed(2)}%</div>
                    </div>
                    <div class="col-2 text-end">
                        <div class="ltm-lbl">Monto</div>
                        <div class="ltm-val">${a.taxAmount.toFixed(2)}</div>
                    </div>
                    <div class="col-1 text-end">
                        <button type="button" class="ltm-icon-btn" title="Editar" onclick="ltmEditTax(${i})"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="ltm-icon-btn" title="Eliminar" onclick="ltmRemoveTax(${i})"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
                ${exonBlock}`;
            cont.appendChild(card);
        });
        if (empty) empty.classList.toggle('d-none', ltmTaxes.length > 0);

        const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        setTxt('ltmSumTax', sumTax.toFixed(2));
        setTxt('ltmSumAsumido', sumTax.toFixed(2));
        setTxt('ltmSumExon', sumExon.toFixed(2));
        setTxt('ltmSumNet', (sumTax - sumExon).toFixed(2));
    }
    window.ltmEditTax = function (i) { ltmEditIndex = i; loadTaxEditor(ltmTaxes[i]); showTaxEditorView(); };
    window.ltmRemoveTax = function (i) { ltmTaxes.splice(i, 1); renderTaxCards(); };

    // Botón "+ Añadir impuesto": abre el editor en modo alta.
    function ltmAddTax() {
        ltmEditIndex = -1;
        const defaultRate = editingLineTr ? (parseFloat(editingLineTr.querySelector('.rate')?.value) || 13) : 13;
        loadTaxEditor({ taxTypeId: '', taxCode: '01', rate: defaultRate, rateCode: '', byAmount: false, taxAmount: 0, exonMode: 'none', exonPercent: defaultRate });
        showTaxEditorView();
    }
    window.ltmAddTax = ltmAddTax;

    function ltmCancelEditor() { showTaxListView(); renderTaxCards(); }
    window.ltmCancelEditor = ltmCancelEditor;

    // Carga los controles del editor con un impuesto dado.
    function loadTaxEditor(tax) {
        const ttSel = document.getElementById('ltmTaxType');
        ttSel.innerHTML = buildTaxTypeOptions(tax.taxTypeId);
        if (tax.taxTypeId) ttSel.value = tax.taxTypeId;

        const rateSel = document.getElementById('ltmTaxRate');
        rateSel.innerHTML = buildTaxRateOptions(tax.rateCode || '');
        if (tax.rateCode) rateSel.value = tax.rateCode;

        document.getElementById('ltmRate').value = parseFloat(tax.rate) || 0;
        const rateLocked = editingLineTr?.querySelector('.rate')?.hasAttribute('readonly');
        document.getElementById('ltmRate').toggleAttribute('readonly', !!rateLocked);

        const mode = tax.exonMode || 'none';
        const rNone = document.getElementById('ltmExonNone');
        const rStd = document.getElementById('ltmExonStandard');
        const rFull = document.getElementById('ltmExonFull');
        if (rNone) rNone.checked = (mode === 'none');
        if (rStd) rStd.checked = (mode === 'standard');
        if (rFull) rFull.checked = (mode === 'full');

        const exonSel = document.getElementById('ltmExonAuthType');
        if (exonSel) { exonSel.innerHTML = buildExonAuthTypeOptions(tax.exonAuthType || ''); if (tax.exonAuthType) exonSel.value = tax.exonAuthType; }
        const exonInstSel = document.getElementById('ltmExonInstitution');
        if (exonInstSel) { exonInstSel.innerHTML = buildExonInstitutionOptions(tax.exonInstitution || ''); if (tax.exonInstitution) exonInstSel.value = tax.exonInstitution; }
        document.getElementById('ltmExonDate').value = tax.exonDate || '';
        document.getElementById('ltmExonDocNumber').value = tax.exonDocNumber || '';
        document.getElementById('ltmExonArticle').value = tax.exonArticle || '';
        document.getElementById('ltmExonSubsection').value = tax.exonSubsection || '';
        const epi = document.getElementById('ltmExonPercent');
        if (epi) epi.value = (mode === 'full' && tax.exonPercent) ? tax.exonPercent : (parseFloat(tax.rate) || 13);

        // Restaurar estado del modo "por monto" (solo aplica a código 02).
        const byAmountChk = document.getElementById('ltmByAmount');
        if (byAmountChk) byAmountChk.checked = !!tax.byAmount;
        const amtInput = document.getElementById('ltmTaxAmount');
        if (amtInput) amtInput.value = tax.byAmount ? (tax.taxAmount || 0) : 0;

        // Restaurar campos de impuestos específicos (03/04/05/06) desde tax.spec.
        const sp = tax.spec || {};
        const setV = (id, v) => { const el = document.getElementById(id); if (el && v !== undefined && v !== null) el.value = v; };
        setV('ltm03Qty', sp.unitQty); setV('ltm03PerUnit', sp.perUnit);
        setV('ltm04UnitQty', sp.unitQty); setV('ltm04Percent', sp.percent); setV('ltm04PerUnit', sp.perUnit);
        setV('ltm05Volume', sp.volume); setV('ltm05PerUnit', sp.perUnit);
        setV('ltm06UnitQty', sp.unitQty); setV('ltm06PerUnit', sp.perUnit);

        // Restaurar campos del código 07 (base especial + fábrica) y 99 (descripción).
        setV('ltm07Base', tax.specialBase);
        const factChk = document.getElementById('ltm07Factory');
        if (factChk) factChk.checked = !!tax.isFactoryTax;
        setV('ltm99Desc', tax.description);

        onExonModeChange();
        toggleTaxRateSelector();
        toggleByAmountControls();
        toggleSpecificTaxControls();
        // Si venía en modo por monto, re-aplicar el bloqueo/visibilidad.
        if (tax.byAmount && isTaxCode02(tax.taxTypeId)) {
            if (byAmountChk) byAmountChk.checked = true;
            document.getElementById('ltmAmountGroup')?.classList.remove('d-none');
            document.getElementById('ltmRate')?.setAttribute('readonly', 'readonly');
        }
    }

    // Muestra/oculta el selector de código de tarifa según el tipo de impuesto seleccionado.
    function toggleTaxRateSelector() {
        const taxTypeId = document.getElementById('ltmTaxType').value;
        const requires = taxTypeRequiresRate(taxTypeId);
        document.getElementById('ltmTaxRateGroup').classList.toggle('d-none', !requires);
        const rateInput = document.getElementById('ltmRate');
        if (rateInput) {
            const rateLocked = editingLineTr && editingLineTr.querySelector('.rate')?.hasAttribute('readonly');
            // Si el impuesto está en modo "por monto", la tarifa siempre queda bloqueada.
            const byAmount = document.getElementById('ltmByAmount')?.checked;
            rateInput.toggleAttribute('readonly', requires || byAmount || !!rateLocked);
        }
    }

    // ── Impuesto código 02 (selectivo de consumo): captura por monto ──────────
    // Devuelve true si el tipo de impuesto seleccionado es código 02.
    function isTaxCode02(taxTypeId) {
        return taxCodeForType(taxTypeId) === '02';
    }

    // ── Impuestos específicos por MONTO (códigos 03, 04, 05) ──────────────────
    // Estos impuestos no se capturan por tarifa; el usuario digita valores
    // físicos (cantidad, volumen, impuesto por unidad...) y el sistema calcula
    // un MONTO absoluto. Luego la tarifa (%) se deriva sobre la base imponible.
    //   03 (combustibles):        Monto = CantidadUnidadMedida × ImpuestoPorUnidad
    //   04 (bebidas alcohólicas): Proporción = CantUnidadMedida × Porcentaje/100
    //                             Monto = Cantidad × Proporción × ImpuestoPorUnidad
    //   05 (bebidas envasadas):   Monto = Cantidad × VolumenPorUnidad × ImpuestoPorUnidad
    const SPECIFIC_TAX_CODES = ['03', '04', '05', '06'];
    function isSpecificTaxCode(taxTypeId) {
        return SPECIFIC_TAX_CODES.includes(taxCodeForType(taxTypeId));
    }

    // Calcula el monto de un impuesto específico según su código, leyendo los
    // campos del editor. Devuelve { amount, proportion }.
    function computeSpecificTaxAmount(code) {
        const num = id => parseFloat(document.getElementById(id)?.value) || 0;
        // La "Cantidad" de la línea (04/05/06) se toma de la cantidad de la línea en edición.
        const lineQty = parseFloat(editingLineTr?.querySelector('.qty')?.value) || 1;
        if (code === '03') {
            const unitQty = num('ltm03Qty');
            const perUnit = num('ltm03PerUnit');
            return { amount: unitQty * perUnit, proportion: null };
        }
        if (code === '04') {
            const unitQty = num('ltm04UnitQty');
            const percent = num('ltm04Percent');
            const perUnit = num('ltm04PerUnit');
            const proportion = unitQty * percent / 100;
            return { amount: lineQty * proportion * perUnit, proportion };
        }
        if (code === '05') {
            const volume = num('ltm05Volume');
            const perUnit = num('ltm05PerUnit');
            return { amount: lineQty * volume * perUnit, proportion: null };
        }
        if (code === '06') {
            // Tabaco: Monto = Cantidad × CantidadUnidadMedida × ImpuestoPorUnidad
            const unitQty = num('ltm06UnitQty');
            const perUnit = num('ltm06PerUnit');
            return { amount: lineQty * unitQty * perUnit, proportion: null };
        }
        return { amount: 0, proportion: null };
    }

    // Muestra el bloque de campos correspondiente al impuesto específico y oculta
    // los controles de tarifa/monto genéricos.
    function toggleSpecificTaxControls() {
        const taxTypeId = document.getElementById('ltmTaxType').value;
        const code = taxCodeForType(taxTypeId);
        const isSpecific = isSpecificTaxCode(taxTypeId);

        ['ltmSpec03', 'ltmSpec04', 'ltmSpec05', 'ltmSpec06'].forEach(gid => {
            const want = ('ltmSpec' + code) === gid;
            document.getElementById(gid)?.classList.toggle('d-none', !want);
        });
        document.getElementById('ltmSpecCalc')?.classList.toggle('d-none', !isSpecific);

        // Código 07 (IVA cálculo especial): mantiene tarifa pero agrega base
        // imponible especial + check de impuesto de fábrica.
        document.getElementById('ltmSpec07')?.classList.toggle('d-none', code !== '07');
        // Código 99 (Otros): mantiene tarifa pero agrega descripción libre.
        document.getElementById('ltmSpec99')?.classList.toggle('d-none', code !== '99');

        // Código 08 (IVA régimen bienes usados): el campo "Tarifa (%)" se
        // reinterpreta como "Factor de IVA" y el monto = base × factor.
        const rateLbl = document.querySelector('#ltmRateRow label');
        if (rateLbl) rateLbl.textContent = (code === '08') ? 'Factor de IVA' : 'Tarifa (%)';

        // En impuestos específicos ocultamos la tarifa manual, el check "por monto"
        // y el grupo de monto genérico: la tarifa se deriva del cálculo físico.
        document.getElementById('ltmRateRow')?.classList.toggle('d-none', isSpecific);
        if (isSpecific) {
            document.getElementById('ltmByAmountRow')?.classList.add('d-none');
            document.getElementById('ltmAmountGroup')?.classList.add('d-none');
            const chk = document.getElementById('ltmByAmount');
            if (chk) chk.checked = false;
            // Sincroniza la "Cantidad" mostrada (04/05/06) con la cantidad de la línea.
            const lineQty = parseFloat(editingLineTr?.querySelector('.qty')?.value) || 1;
            const q04 = document.getElementById('ltm04Qty'); if (q04) q04.value = lineQty.toFixed(2);
            const q05 = document.getElementById('ltm05Qty'); if (q05) q05.value = lineQty.toFixed(2);
            const q06 = document.getElementById('ltm06Qty'); if (q06) q06.value = lineQty.toFixed(2);
            onSpecificTaxChange();
        } else if (code === '07' || code === '99') {
            // Recalcula el resumen del monto para 07/99 (dependen de la tarifa).
            recalcTaxModal();
        }
    }

    // Recalcula el monto de un impuesto específico y deriva la tarifa (%).
    function onSpecificTaxChange() {
        const taxTypeId = document.getElementById('ltmTaxType').value;
        const code = taxCodeForType(taxTypeId);
        if (!isSpecificTaxCode(taxTypeId)) return;
        const { amount, proportion } = computeSpecificTaxAmount(code);

        // Muestra la proporción (solo código 04).
        if (code === '04') {
            const propEl = document.getElementById('ltm04Prop');
            if (propEl) propEl.value = (proportion !== null && !isNaN(proportion)) ? proportion.toFixed(4) : '—';
        }

        // Tarifa derivada = monto / base × 100.
        const base = currentLineTaxableBase(0);
        const rateInput = document.getElementById('ltmRate');
        if (rateInput) rateInput.value = (base > 0 && amount > 0) ? (amount / base * 100).toFixed(4) : '0';

        // Muestra el monto y la fórmula usada.
        const formulas = {
            '03': 'Monto: Cant. unidad de medida × Impuesto por unidad',
            '04': 'Monto: Cantidad × Proporción × Impuesto por unidad',
            '05': 'Monto: Cantidad × Volumen por unidad × Impuesto por unidad',
            '06': 'Monto: Cantidad × Cant. unidad de medida × Impuesto por unidad'
        };
        const fEl = document.getElementById('ltmSpecFormula');
        if (fEl) fEl.textContent = formulas[code] || 'Monto del impuesto';
        const aEl = document.getElementById('ltmSpecAmount');
        if (aEl) aEl.textContent = amount.toFixed(2);

        recalcTaxModal();
    }
    window.onSpecificTaxChange = onSpecificTaxChange;

    // Muestra u oculta el bloque del check "por monto" según el código de impuesto.
    // Solo el código 02 permite indicar el monto en lugar de la tarifa.
    function toggleByAmountControls() {
        const taxTypeId = document.getElementById('ltmTaxType').value;
        const show02 = isTaxCode02(taxTypeId);
        document.getElementById('ltmByAmountRow')?.classList.toggle('d-none', !show02);
        if (!show02) {
            // Al cambiar a un impuesto que no es 02, se resetea el modo por monto.
            const chk = document.getElementById('ltmByAmount');
            if (chk) chk.checked = false;
            document.getElementById('ltmAmountGroup')?.classList.add('d-none');
        }
    }

    // Base imponible de la línea en edición (para derivar la tarifa desde el monto).
    // Usa la tarifa combinada de todos los impuestos guardados + el borrador actual.
    function currentLineTaxableBase(draftRate) {
        const ivi = document.getElementById('priceIncludesTax')?.checked;
        const qty = parseFloat(editingLineTr?.querySelector('.qty')?.value) || 0;
        const price = parseFloat(editingLineTr?.querySelector('.price')?.value) || 0;
        const d = parseFloat(editingLineTr?.querySelector('.disc')?.value) || 0;
        const others = ltmTaxes.filter((_, i) => i !== ltmEditIndex)
            .reduce((s, t) => s + (parseFloat(t.rate) || 0), 0);
        const combinedRate = (others + (parseFloat(draftRate) || 0)) / 100;
        const unitBase = (ivi && combinedRate > 0) ? price / (1 + combinedRate) : price;
        let base = unitBase * qty - d;
        return base < 0 ? 0 : base;
    }

    // Handler del check "por monto". Alterna entre capturar tarifa o monto.
    function onByAmountChange() {
        const byAmount = document.getElementById('ltmByAmount')?.checked;
        const rateInput = document.getElementById('ltmRate');
        document.getElementById('ltmAmountGroup')?.classList.toggle('d-none', !byAmount);
        if (byAmount) {
            // Modo MONTO: se bloquea la tarifa y se calcula desde el monto digitado.
            rateInput?.setAttribute('readonly', 'readonly');
            onTaxAmountChange();
        } else {
            // Modo TARIFA: se habilita la tarifa (salvo que requiera código de tarifa)
            // y se limpia el monto.
            const requires = taxTypeRequiresRate(document.getElementById('ltmTaxType').value);
            const rateLocked = editingLineTr?.querySelector('.rate')?.hasAttribute('readonly');
            rateInput?.toggleAttribute('readonly', requires || !!rateLocked);
            const amt = document.getElementById('ltmTaxAmount');
            if (amt) amt.value = '0';
            recalcTaxModal();
        }
    }
    window.onByAmountChange = onByAmountChange;

    // Al digitar el monto (modo código 02 por monto): tarifa = monto / base × 100.
    function onTaxAmountChange() {
        const amount = parseFloat(document.getElementById('ltmTaxAmount')?.value) || 0;
        const base = currentLineTaxableBase(0);
        const rateInput = document.getElementById('ltmRate');
        if (base > 0 && amount > 0) {
            const pct = amount / base * 100;
            if (rateInput) rateInput.value = pct.toFixed(4);
        } else if (rateInput) {
            rateInput.value = '0';
        }
        recalcTaxModal();
    }
    window.onTaxAmountChange = onTaxAmountChange;

    function getExonModeFromModal() {
        const r = document.querySelector('input[name="ltmExonMode"]:checked');
        return r ? r.value : 'none';
    }

    function onExonModeChange() {
        const mode = getExonModeFromModal();
        document.getElementById('ltmExonGroup')?.classList.toggle('d-none', mode !== 'full');
        document.getElementById('ltmExonCalc')?.classList.toggle('d-none', mode === 'none');
        recalcTaxModal();
    }
    window.onExonModeChange = onExonModeChange;

    // Recalcula el panel del editor para el impuesto en edición.
    function recalcTaxModal() {
        const calc = document.getElementById('ltmExonCalc');
        if (!calc || !editingLineTr) return;
        const mode = getExonModeFromModal();
        const draft = {
            rate: parseFloat(document.getElementById('ltmRate')?.value) || 0,
            exonMode: mode,
            exonPercent: parseFloat(document.getElementById('ltmExonPercent')?.value) || 0
        };
        // Considera el resto de impuestos ya guardados para la base combinada.
        const others = ltmTaxes.filter((_, i) => i !== ltmEditIndex);
        const saved = ltmTaxes;
        ltmTaxes = others.concat([draft]);
        const a = ltmTaxAmounts(draft);
        ltmTaxes = saved;

        const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        setTxt('ltmCalcTax', a.taxAmount.toFixed(2));
        setTxt('ltmCalcExon', '- ' + a.exonAmount.toFixed(2));
        setTxt('ltmCalcNet', a.netTax.toFixed(2));
    }
    window.recalcTaxModal = recalcTaxModal;

    function onTaxTypeChange() { toggleTaxRateSelector(); toggleByAmountControls(); toggleSpecificTaxControls(); recalcTaxModal(); }
    window.onTaxTypeChange = onTaxTypeChange;

    function onTaxRateChange() {
        const rateSel = document.getElementById('ltmTaxRate');
        const opt = rateSel.options[rateSel.selectedIndex];
        const pct = opt ? parseFloat(opt.dataset.rate) : NaN;
        if (!isNaN(pct)) document.getElementById('ltmRate').value = pct;
        recalcTaxModal();
    }
    window.onTaxRateChange = onTaxRateChange;

    // Guarda el impuesto del editor en ltmTaxes (alta o edición) y vuelve a la lista.
    function ltmSaveTaxEditor() {
        const taxTypeId = document.getElementById('ltmTaxType').value;
        if (!taxTypeId) { alert('El tipo de impuesto es obligatorio.'); return; }

        let rateCode = '';
        if (taxTypeRequiresRate(taxTypeId)) {
            rateCode = document.getElementById('ltmTaxRate').value;
            if (!rateCode) { alert('El código de la tarifa es obligatorio para este impuesto.'); return; }
        }

        // ── Validación tarifa / monto (código 02 admite captura por monto) ──
        const byAmount = isTaxCode02(taxTypeId) && document.getElementById('ltmByAmount')?.checked;
        const isSpecific = isSpecificTaxCode(taxTypeId);
        let taxAmountVal = 0;
        let specData = null;
        const rateVal0 = parseFloat(document.getElementById('ltmRate')?.value) || 0;
        if (isSpecific) {
            // Impuestos 03/04/05: se validan los campos físicos y el monto derivado.
            const code = taxCodeForType(taxTypeId);
            const num = id => parseFloat(document.getElementById(id)?.value) || 0;
            if (code === '03') {
                if (num('ltm03Qty') <= 0) { alert('La cantidad de la unidad de medida debe ser mayor que 0.'); return; }
                if (num('ltm03PerUnit') <= 0) { alert('El impuesto por unidad debe ser mayor que 0.'); return; }
                specData = { unitQty: num('ltm03Qty'), perUnit: num('ltm03PerUnit') };
            } else if (code === '04') {
                if (num('ltm04UnitQty') <= 0) { alert('La cantidad de la unidad de medida debe ser mayor que 0.'); return; }
                if (num('ltm04Percent') <= 0) { alert('El porcentaje debe ser mayor que 0.'); return; }
                if (num('ltm04PerUnit') <= 0) { alert('El impuesto por unidad debe ser mayor que 0.'); return; }
                specData = { unitQty: num('ltm04UnitQty'), percent: num('ltm04Percent'), perUnit: num('ltm04PerUnit'), proportion: num('ltm04UnitQty') * num('ltm04Percent') / 100 };
            } else if (code === '05') {
                if (num('ltm05Volume') <= 0) { alert('El volumen por unidad de consumo debe ser mayor que 0.'); return; }
                if (num('ltm05PerUnit') <= 0) { alert('El impuesto por unidad debe ser mayor que 0.'); return; }
                specData = { volume: num('ltm05Volume'), perUnit: num('ltm05PerUnit') };
            } else if (code === '06') {
                if (num('ltm06UnitQty') <= 0) { alert('La cantidad de la unidad de medida debe ser mayor que 0.'); return; }
                if (num('ltm06PerUnit') <= 0) { alert('El impuesto por unidad debe ser mayor que 0.'); return; }
                specData = { unitQty: num('ltm06UnitQty'), perUnit: num('ltm06PerUnit') };
            }
            const res = computeSpecificTaxAmount(code);
            taxAmountVal = res.amount;
            if (taxAmountVal <= 0) { alert('El monto del impuesto calculado debe ser mayor que 0.'); return; }
            if (rateVal0 <= 0) { alert('No se pudo derivar la tarifa. Verifique cantidad y precio de la línea.'); return; }
        } else if (byAmount) {
            taxAmountVal = parseFloat(document.getElementById('ltmTaxAmount')?.value) || 0;
            if (taxAmountVal <= 0) { alert('El monto del impuesto debe ser mayor que 0.'); return; }
            if (rateVal0 <= 0) { alert('No se pudo calcular la tarifa a partir del monto. Verifique cantidad y precio de la línea.'); return; }
        } else {
            // Las tarifas exentas / 0% (Tarifa Exenta, Reducida 0%, Transitorio 0%,
            // 0% sin derecho a crédito, etc.) son válidas con tarifa 0. Se permite 0
            // cuando el código de tarifa seleccionado es exento o de porcentaje 0.
            const rateInfo = (taxRates || []).find(r => String(r.code) === String(rateCode));
            const isZeroRateAllowed = rateInfo && (rateInfo.isExempt || (parseFloat(rateInfo.ratePercent) || 0) === 0);
            if (rateVal0 <= 0 && !isZeroRateAllowed) { alert('La tarifa del impuesto debe ser mayor que 0.'); return; }
        }

        // ── Código 07 (IVA cálculo especial): base imponible especial + fábrica ──
        const taxCode = taxCodeForType(taxTypeId);
        let specialBase = null, isFactoryTax = false, taxDescription = '';
        if (taxCode === '07') {
            specialBase = parseFloat(document.getElementById('ltm07Base')?.value) || 0;
            if (specialBase <= 0) { alert('La base imponible especial debe ser mayor que 0.'); return; }
            isFactoryTax = !!document.getElementById('ltm07Factory')?.checked;
            // El monto = Base imponible especial × Tarifa ÷ 100 (cálculo especial).
            taxAmountVal = Math.round(specialBase * rateVal0 / 100 * 100000) / 100000;
        } else if (taxCode === '99') {
            taxDescription = (document.getElementById('ltm99Desc')?.value || '').trim();
            if (!taxDescription) { alert('La descripción del impuesto es obligatoria para el código 99 - Otros.'); return; }
            if (taxDescription.length > 160) { alert('La descripción del impuesto no puede exceder 160 caracteres.'); return; }
        } else if (taxCode === '08') {
            // Código 08 (IVA régimen bienes usados): el valor de "Tarifa (%)" es un
            // FACTOR y el monto = base imponible × factor (sin dividir entre 100).
            if (rateVal0 <= 0) { alert('El factor de IVA debe ser mayor que 0.'); return; }
            const others08 = ltmTaxes.filter((_, i) => i !== ltmEditIndex);
            const savedT08 = ltmTaxes;
            ltmTaxes = others08.concat([{ rate: rateVal0, exonMode: 'none', exonPercent: 0 }]);
            const b08 = ltmTaxAmounts({ rate: 0, exonMode: 'none', exonPercent: 0 });
            ltmTaxes = savedT08;
            // b08.taxAmount es 0 (rate 0); recomputo la base a partir de la línea.
            const qty08 = parseFloat(editingLineTr?.querySelector('.qty')?.value) || 0;
            const price08 = parseFloat(editingLineTr?.querySelector('.price')?.value) || 0;
            const disc08 = parseFloat(editingLineTr?.querySelector('.disc')?.value) || 0;
            let base08 = qty08 * price08 - disc08; if (base08 < 0) base08 = 0;
            taxAmountVal = Math.round(base08 * rateVal0 * 100000) / 100000;
        }

        const exonMode = getExonModeFromModal();
        let exonAuthType = '', exonDate = '', exonDocNumber = '', exonArticle = '', exonSubsection = '', exonInstitution = '', exonPercent = '100';
        if (exonMode === 'full') {
            exonAuthType = document.getElementById('ltmExonAuthType')?.value || '';
            if (!exonAuthType) { alert('Debe seleccionar el tipo de documento de exoneración o de autorización.'); return; }
            exonDate = document.getElementById('ltmExonDate')?.value || '';
            if (!exonDate) { alert('La fecha de emisión del documento de exoneración es obligatoria.'); return; }
            exonDocNumber = (document.getElementById('ltmExonDocNumber')?.value || '').trim();
            if (!exonDocNumber) { alert('El número de documento de exoneración o de autorización es obligatorio.'); return; }
            if (exonDocNumber.length > 40) { alert('El número de documento de exoneración no puede exceder 40 caracteres.'); return; }
            exonArticle = (document.getElementById('ltmExonArticle')?.value || '').trim();
            if (exonArticle && (!/^\d{1,6}$/.test(exonArticle))) { alert('El número de artículo debe ser un entero de máximo 6 dígitos.'); return; }
            exonSubsection = (document.getElementById('ltmExonSubsection')?.value || '').trim();
            if (!exonSubsection) { alert('El número de inciso que establece la exoneración es obligatorio.'); return; }
            if (!/^\d{1,6}$/.test(exonSubsection)) { alert('El número de inciso debe ser un entero de máximo 6 dígitos.'); return; }
            exonInstitution = document.getElementById('ltmExonInstitution')?.value || '';
            if (!exonInstitution) { alert('Debe seleccionar el nombre de institución o dependencia que emitió la exoneración.'); return; }
            const rateVal = parseFloat(document.getElementById('ltmRate')?.value) || 0;
            const pctVal = parseFloat(document.getElementById('ltmExonPercent')?.value);
            if (isNaN(pctVal) || pctVal <= 0) { alert('El porcentaje tarifa exonerada debe ser mayor que 0.'); return; }
            if (pctVal > rateVal) { alert('El porcentaje tarifa exonerada no puede exceder la tarifa del impuesto (' + rateVal + '%).'); return; }
            exonPercent = String(pctVal);
        } else if (exonMode === 'standard') {
            exonPercent = '100';
        }

        const tax = {
            taxTypeId: taxTypeId,
            taxCode: taxCodeForType(taxTypeId),
            rate: parseFloat(document.getElementById('ltmRate').value) || 0,
            rateCode: rateCode,
            byAmount: !!byAmount || isSpecific || taxCode === '08',
            taxAmount: (byAmount || isSpecific || taxCode === '07' || taxCode === '08') ? taxAmountVal : 0,
            spec: isSpecific ? specData : null,
            specialBase: specialBase,
            isFactoryTax: isFactoryTax,
            description: taxDescription,
            exonMode: exonMode,
            exonPercent: parseFloat(exonPercent) || 0,
            exonAuthType: (exonMode === 'full') ? exonAuthType : '',
            exonDate: (exonMode === 'full') ? exonDate : '',
            exonDocNumber: (exonMode === 'full') ? exonDocNumber : '',
            exonArticle: (exonMode === 'full') ? exonArticle : '',
            exonSubsection: (exonMode === 'full') ? exonSubsection : '',
            exonInstitution: (exonMode === 'full') ? exonInstitution : ''
        };
        if (ltmEditIndex >= 0 && ltmEditIndex < ltmTaxes.length) ltmTaxes[ltmEditIndex] = tax;
        else ltmTaxes.push(tax);
        ltmEditIndex = -1;
        showTaxListView();
        renderTaxCards();
    }
    window.ltmSaveTaxEditor = ltmSaveTaxEditor;

    // OK: persiste ltmTaxes en la fila (.taxList) y sincroniza los campos planos.
    function ltmOk() {
        if (!editingLineTr) return;
        if (ltmTaxes.length === 0) { alert('Debe agregar al menos un impuesto a la línea.'); return; }

        editingLineTr.querySelector('.taxList').value = JSON.stringify(ltmTaxes);

        // Retrocompatibilidad: reflejar el primer impuesto (normalmente el IVA) en
        // los campos planos usados por recalc()/emit(). El backend recibe la lista
        // completa a través del payload; los planos son un respaldo.
        const primary = ltmTaxes.find(t => t.taxCode === '01') || ltmTaxes[0];
        const ttCell = editingLineTr.querySelector('.taxType');
        ttCell.innerHTML = buildTaxTypeOptions(primary.taxTypeId);
        ttCell.value = primary.taxTypeId;
        ttCell.dataset.selected = primary.taxTypeId;
        editingLineTr.querySelector('.taxRateCode').value = primary.rateCode || '';
        editingLineTr.querySelector('.rate').value = primary.rate || 0;
        const hasExon = ltmTaxes.some(t => t.exonMode !== 'none');
        editingLineTr.querySelector('.exon').value = hasExon ? '1' : '0';
        editingLineTr.querySelector('.exonMode').value = primary.exonMode || 'none';
        editingLineTr.querySelector('.exonAuthType').value = primary.exonAuthType || '';
        editingLineTr.querySelector('.exonDate').value = primary.exonDate || '';
        editingLineTr.querySelector('.exonDocNumber').value = primary.exonDocNumber || '';
        editingLineTr.querySelector('.exonArticle').value = primary.exonArticle || '';
        editingLineTr.querySelector('.exonSubsection').value = primary.exonSubsection || '';
        editingLineTr.querySelector('.exonInstitution').value = primary.exonInstitution || '';
        editingLineTr.querySelector('.exonPercent').value = primary.exonMode === 'full' ? (primary.exonPercent || 0) : '100';

        bootstrap.Modal.getInstance(document.getElementById('lineTaxModal'))?.hide();
        recalc();
    }
    window.ltmOk = ltmOk;



    // Lee/escribe la descripción de línea (texto plano, no editable).
    function getDetail(tr) {
        const el = tr.querySelector('.detail');
        return el ? (el.dataset.value || '') : '';
    }
    function setDetail(tr, value) {
        const el = tr.querySelector('.detail');
        if (!el) return;
        el.dataset.value = value || '';
        el.textContent = value || '';
    }

    function addLine(prefill) {
        lineSeq++;
        const tr = document.createElement('tr');
        tr.dataset.id = lineSeq;
        tr.innerHTML = `
            <td class="ei-line-idx text-center lineIdx"></td>
            <td>
                <div class="ei-code-title form-check form-check-sm">
                    <input class="form-check-input manualCabys" type="checkbox" id="mc-${lineSeq}">
                    <label class="form-check-label" for="mc-${lineSeq}">Usar CABYS</label>
                </div>
                <div class="ei-code-cell">
                    <input class="form-control form-control-sm itemCode mb-1" maxlength="20" placeholder="Código ítem" autocomplete="off">
                    <input class="form-control form-control-sm cabys d-none" maxlength="13" placeholder="0000000000000" autocomplete="off">
                    <div class="ei-ac-list d-none itemAcList"></div>
                </div>
                <div class="small itemHint" style="color:#cbd5e1"></div>
            </td>
            <td><div class="ei-detail-text detail" data-value=""></div></td>
            <td><input class="form-control form-control-sm text-end qty" type="number" value="1" min="0" step="1"></td>
            <td><input class="form-control form-control-sm text-end price" type="number" value="0" min="0" step="1"></td>
            <td class="text-end montoTotal">0.00</td>
            <td class="text-center ei-inline-cell">
                <span class="discDisplay">—</span>
                <button type="button" class="btn btn-sm ei-pencil-btn openDisc" title="Clique aquí para editar descuento de línea"><i class="bi bi-pencil"></i></button>
                <div class="d-none">
                    <input class="disc" type="hidden" value="0">
                    <input class="nature" type="hidden" value="">
                    <input class="discList" type="hidden" value="[]">
                </div>
            </td>
            <td class="text-end subtotalCell">0.00</td>
            <td class="text-center ei-inline-cell">
                <span class="rateDisplay">—</span>
                <button type="button" class="btn btn-sm ei-pencil-btn openRate" title="Clique aquí para editar impuesto de línea"><i class="bi bi-pencil"></i></button>
                <div class="d-none">
                    <input class="rate" type="hidden" value="13">
                    <input class="taxRateCode" type="hidden" value="">
                    <input class="exon" type="hidden" value="0">
                    <input class="exonMode" type="hidden" value="none">
                    <input class="exonAuthType" type="hidden" value="">
                    <input class="exonDate" type="hidden" value="">
                    <input class="exonDocNumber" type="hidden" value="">
                    <input class="exonArticle" type="hidden" value="">
                    <input class="exonSubsection" type="hidden" value="">
                    <input class="exonInstitution" type="hidden" value="">
                    <input class="exonPercent" type="hidden" value="100">
                    <input class="taxList" type="hidden" value="">
                    <select class="taxType" title="Tipo de impuesto (obligatorio)">
                        ${buildTaxTypeOptions()}
                    </select>
                </div>
            </td>
            <td class="text-end lineTotal">0.00</td>
            <td class="text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-info changeItem me-1" title="Cambiar artículo seleccionado"><i class="bi bi-arrow-repeat"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger removeLine" title="Eliminar línea"><i class="bi bi-x"></i></button>
            </td>`;
        document.getElementById('linesBody').appendChild(tr);

        const itemCodeInput = tr.querySelector('.itemCode');
        const cabys = tr.querySelector('.cabys');
        const manualChk = tr.querySelector('.manualCabys');
        const itemHint = tr.querySelector('.itemHint');

        // Alterna entre modo "por código de ítem" y "CAByS manual".
        function applyManualMode() {
            const manual = manualChk.checked;
            // Manual: se oculta el código de ítem y se muestra la caja de CAByS.
            itemCodeInput.classList.toggle('d-none', manual);
            cabys.classList.toggle('d-none', !manual);
            if (manual) {
                itemHint.textContent = 'CAByS manual: el código comercial de la factura será el mismo CAByS.';
            } else {
                itemHint.textContent = '';
            }
            // El botón "Cambiar" abre el selector adecuado según el modo.
            const changeBtn = tr.querySelector('.changeItem');
            if (changeBtn) {
                changeBtn.title = manual ? 'Seleccionar código CAByS' : 'Cambiar artículo seleccionado';
            }
        }
        manualChk.addEventListener('change', () => {
            applyManualMode();
            // Al activar/desactivar "Usar CABYS" se restauran los datos de la línea
            // hasta que el usuario digite o seleccione un código válido.
            resetLineData();
            if (manualChk.checked) {
                itemCodeInput.value = '';
                itemHint.textContent = 'Digite o seleccione un código CAByS válido.';
                setTimeout(() => cabys.focus(), 0);
            } else {
                cabys.value = '';
                cabys.classList.remove('cabys-valid', 'cabys-invalid');
                itemHint.textContent = '';
                setTimeout(() => itemCodeInput.focus(), 0);
            }
            recalc();
        });
        applyManualMode();

        // Restaura (limpia) los datos de la línea: descripción, precio, IVA, tipo de
        // impuesto, descuentos y exoneración. No toca el código ni la cantidad.
        function resetLineData() {
            setDetail(tr, '');
            tr.querySelector('.price').value = 0;
            tr.querySelector('.rate').value = 13;
            tr.querySelector('.taxRateCode').value = '';
            cabys.value = manualChk.checked ? cabys.value : '';
            const ttSel = tr.querySelector('.taxType');
            if (ttSel) { ttSel.dataset.selected = 1; ttSel.innerHTML = buildTaxTypeOptions(1); }
            // Descuentos
            tr.querySelector('.disc').value = 0;
            tr.querySelector('.nature').value = '';
            tr.querySelector('.discList').value = '[]';
            // Exoneración
            tr.querySelector('.exon').value = '0';
            tr.querySelector('.exonMode').value = 'none';
            tr.querySelector('.exonPercent').value = '100';
            tr.querySelector('.taxList').value = '';
            itemCodeInput.classList.remove('cabys-valid', 'cabys-invalid');
        }

        // ── Autocompletado en vivo del código ──────────────────────────────────
        // - Modo normal: sugiere por code de sinai.item (endpoint for-billing).
        // - Modo "Usar CABYS": sugiere por code de admin.electronic_document_cabys.
        const acList = tr.querySelector('.itemAcList');
        let acItems = [], acIndex = -1, acTimer = null;

        function acHide() {
            acList.classList.add('d-none');
            acList.innerHTML = '';
            acItems = []; acIndex = -1;
        }

        function acRender() {
            if (!acItems.length) {
                acList.innerHTML = '<div class="ei-ac-empty">Sin coincidencias</div>';
                acList.classList.remove('d-none');
                return;
            }
            acList.innerHTML = acItems.map((it, i) => `
                <div class="ei-ac-item${i === acIndex ? ' active' : ''}" data-idx="${i}">
                    <span class="ei-ac-code">${escapeHtml(it.code)}</span>
                    <span class="ei-ac-name"> — ${escapeHtml(it.name || '')}</span>
                </div>`).join('');
            acList.classList.remove('d-none');
            acList.querySelectorAll('.ei-ac-item').forEach(el => {
                el.addEventListener('mousedown', e => {   // mousedown para no perder foco antes del click
                    e.preventDefault();
                    acPick(parseInt(el.dataset.idx, 10));
                });
            });
        }

        async function acSearch(term, manual) {
            const q = (term || '').trim();
            if (q.length < 2) { acHide(); return; }
            try {
                let items = [];
                if (manual) {
                    const r = await emitFetch('/api/electronicdocumentcabys?onlyActive=true&pageSize=15&search=' + encodeURIComponent(q));
                    if (r.ok) {
                        const data = await r.json();
                        items = (data.items || []).map(a => ({ code: a.code, name: a.description }));
                    }
                } else {
                    const issuerId = getSelectedIssuerId();
                    let url = '/api/item/for-billing?search=' + encodeURIComponent(q);
                    if (issuerId) url += '&customerId=' + issuerId;
                    const r = await emitFetch(url);
                    if (r.ok) {
                        const data = await r.json();
                        items = (data || []).slice(0, 15).map(it => ({
                            code: it.code, name: it.name, _item: it
                        }));
                    }
                }
                acItems = items; acIndex = -1;
                acRender();
            } catch { acHide(); }
        }

        function acPick(idx) {
            if (idx < 0 || idx >= acItems.length) return;
            const sel = acItems[idx];
            if (manualChk.checked) {
                cabys.value = sel.code;
                cabys.dispatchEvent(new Event('blur'));
            } else {
                itemCodeInput.value = sel.code;
                itemCodeInput.dispatchEvent(new Event('blur'));
            }
            acHide();
        }

        function acAttach(input, manual) {
            input.addEventListener('input', () => {
                clearTimeout(acTimer);
                const term = input.value;
                acTimer = setTimeout(() => acSearch(term, manual), 200);
            });
            input.addEventListener('keydown', e => {
                if (acList.classList.contains('d-none') || !acItems.length) return;
                if (e.key === 'ArrowDown') { e.preventDefault(); acIndex = Math.min(acIndex + 1, acItems.length - 1); acRender(); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); acIndex = Math.max(acIndex - 1, 0); acRender(); }
                else if (e.key === 'Enter') { if (acIndex >= 0) { e.preventDefault(); acPick(acIndex); } }
                else if (e.key === 'Escape') { acHide(); }
            });
            input.addEventListener('blur', () => setTimeout(acHide, 150));
        }
        acAttach(itemCodeInput, false);
        acAttach(cabys, true);
        // ───────────────────────────────────────────────────────────────────────

        // Resolver el ítem por su código y autocompletar CAByS, descripción, precio, IVA y tipo de impuesto.
        itemCodeInput.addEventListener('blur', async () => {
            const code = itemCodeInput.value.trim();
            if (!code || manualChk.checked) return;
            try {
                const issuerId = getSelectedIssuerId();
                let url = '/api/item/code/' + encodeURIComponent(code);
                if (issuerId) url += '?customerId=' + issuerId;
                const r = await emitFetch(url);
                if (r.ok) {
                    const it = await r.json();
                    cabys.value = it.cabysCode || '';
                    if (it.name && !getDetail(tr)) setDetail(tr, it.name);
                    if (it.salePrice != null && !(parseFloat(tr.querySelector('.price').value) > 0)) tr.querySelector('.price').value = it.salePrice;
                    if (it.taxRate != null) tr.querySelector('.rate').value = it.taxRate;
                    // Preseleccionar el tipo de impuesto por defecto del ítem.
                    const ttSel = tr.querySelector('.taxType');
                    if (ttSel && it.idElectronicDocumentTaxType) {
                        ttSel.dataset.selected = it.idElectronicDocumentTaxType;
                        ttSel.innerHTML = buildTaxTypeOptions(it.idElectronicDocumentTaxType);
                    }
                    itemCodeInput.classList.add('cabys-valid'); itemCodeInput.classList.remove('cabys-invalid');
                    itemHint.textContent = it.name ? ('CAByS: ' + (it.cabysCode || '—')) : '';
                } else {
                    itemCodeInput.classList.add('cabys-invalid'); itemCodeInput.classList.remove('cabys-valid');
                    itemHint.textContent = 'Ítem no encontrado. Active "CAByS manual" para digitarlo.';
                    cabys.value = '';
                }
            } catch {
                itemHint.textContent = 'No se pudo consultar el ítem (sin conexión).';
            }
            recalc();
        });

        // Validación de CAByS manual + autocompletado de la línea desde
        // admin.electronic_document_cabys (descripción, tarifa de IVA, tipo de impuesto).
        cabys.addEventListener('blur', async () => {
            if (!manualChk.checked) return;
            const code = cabys.value.trim();
            if (!isValidCabys(code)) {
                cabys.classList.add('cabys-invalid'); cabys.classList.remove('cabys-valid');
                itemHint.textContent = 'Código CAByS inválido (13 dígitos).';
                resetLineData();
                recalc();
                return;
            }
            try {
                const r = await emitFetch('/api/electronicdocumentcabys/by-code/' + encodeURIComponent(code));
                if (r.ok) {
                    const c = await r.json();
                    cabys.classList.add('cabys-valid'); cabys.classList.remove('cabys-invalid');
                    setDetail(tr, c.description || '');
                    if (c.taxRatePercent != null) tr.querySelector('.rate').value = c.taxRatePercent;
                    if (c.taxRateCode) tr.querySelector('.taxRateCode').value = c.taxRateCode;
                    const ttSel = tr.querySelector('.taxType');
                    if (ttSel && c.idElectronicDocumentTaxType) {
                        ttSel.dataset.selected = c.idElectronicDocumentTaxType;
                        ttSel.innerHTML = buildTaxTypeOptions(c.idElectronicDocumentTaxType);
                    }
                    itemHint.textContent = c.description ? ('CAByS: ' + c.code) : '';
                } else {
                    cabys.classList.add('cabys-invalid'); cabys.classList.remove('cabys-valid');
                    itemHint.textContent = 'Código CAByS no encontrado en el catálogo.';
                    resetLineData();
                }
            } catch {
                itemHint.textContent = 'No se pudo consultar el CAByS (sin conexión).';
            }
            recalc();
        });

        tr.querySelectorAll('.qty,.price').forEach(el => el.addEventListener('input', recalc));
        tr.querySelector('.removeLine').addEventListener('click', () => { tr.remove(); recalc(); });
        // Cambiar el artículo seleccionado: abre el modal de "Seleccionar ítem" y
        // recarga esta misma línea con los datos del nuevo artículo elegido.
        tr.querySelector('.changeItem').addEventListener('click', () => openItemModalForRow(tr));

        // Edición vía modal para Descuentos e Impuestos.
        tr.querySelector('.openDisc').addEventListener('click', e => {
            e.preventDefault();
            openDiscountModal(tr);
        });
        tr.querySelector('.openRate').addEventListener('click', e => {
            e.preventDefault();
            openTaxModal(tr);
        });

        if (prefill) {
            if (prefill.itemCode) tr.querySelector('.itemCode').value = prefill.itemCode;
            if (prefill.manualCabys) { manualChk.checked = true; applyManualMode(); }
            tr.querySelector('.cabys').value = prefill.cabys || '';
            setDetail(tr, prefill.detail || '');
            // Mostrar el código CAByS debajo del campo de código (hint).
            if (prefill.cabys && !manualChk.checked) {
                itemHint.textContent = 'CAByS: ' + prefill.cabys;
                itemCodeInput.classList.add('cabys-valid');
            }
            if (prefill.quantity != null) tr.querySelector('.qty').value = prefill.quantity;
            if (prefill.unitPrice != null) tr.querySelector('.price').value = prefill.unitPrice;
            if (prefill.taxRate != null) tr.querySelector('.rate').value = prefill.taxRate;
            if (prefill.discount != null) tr.querySelector('.disc').value = prefill.discount;
            if (prefill.nature) tr.querySelector('.nature').value = prefill.nature;
            // Lista de descuentos (múltiples). Si viene, se usa; si no, se deriva del escalar.
            if (Array.isArray(prefill.discounts) && prefill.discounts.length > 0) {
                tr.querySelector('.discList').value = JSON.stringify(
                    prefill.discounts.map(d => ({ nature: d.nature, amount: d.amount })));
            } else if (prefill.discount != null && parseFloat(prefill.discount) > 0) {
                tr.querySelector('.discList').value = JSON.stringify([{ nature: prefill.nature || '', amount: parseFloat(prefill.discount) }]);
            }
            if (prefill.exonerated) {
                tr.querySelector('.exon').value = '1';
                const em = tr.querySelector('.exonMode');
                if (em) em.value = prefill.exonMode || 'standard';
            }
            if (prefill.exonDocumentType) tr.querySelector('.exonAuthType').value = prefill.exonDocumentType;
            // Preselección del tipo de impuesto del ítem.
            if (prefill.taxTypeId) {
                const ttSel = tr.querySelector('.taxType');
                if (ttSel) { ttSel.dataset.selected = prefill.taxTypeId; ttSel.innerHTML = buildTaxTypeOptions(prefill.taxTypeId); }
            }

            // Modo "reversar factura": la línea proviene del documento origen.
            // Se bloquea CAByS, detalle y tarifa para impedir alterar/inventar líneas.
            if (prefill.locked) {
                tr.classList.add('nc-source-line');
                // En documentos reversados se digita el CAByS directamente (modo manual).
                manualChk.checked = true; manualChk.setAttribute('disabled', 'disabled'); applyManualMode();
                ['cabys', 'detail', 'rate'].forEach(cls => {
                    const el = tr.querySelector('.' + cls);
                    el.setAttribute('readonly', 'readonly');
                    el.classList.add('cabys-valid');
                });
                // Naturaleza de descuento también bloqueada (viene del origen)
                tr.querySelector('.nature').setAttribute('disabled', 'disabled');
            }
        }
        recalc();
    }

    // ---------------- Cálculo (incluye IVI inverso) ----------------
    function recalc() {
        const ivi = document.getElementById('priceIncludesTax').checked;
        const docExon = document.getElementById('docExonerated').checked;
        // Porcentaje de exoneración configurado en la tarjeta de datos (default 100).
        let exonPct = parseFloat(document.getElementById('exonPercent')?.value) || 100;
        if (exonPct < 1) exonPct = 1; if (exonPct > 100) exonPct = 100;
        let sub = 0, disc = 0, tax = 0, total = 0, exon = 0;
        let anyExon = false;
        let idx = 0;
        document.querySelectorAll('#linesBody tr').forEach(tr => {
            idx++;
            const idxCell = tr.querySelector('.lineIdx');
            if (idxCell) idxCell.textContent = idx;

            const qty = parseFloat(tr.querySelector('.qty').value) || 0;
            const price = parseFloat(tr.querySelector('.price').value) || 0;
            const d = parseFloat(tr.querySelector('.disc').value) || 0;
            const exonChk = tr.querySelector('.exon');
            // Documento exonerado → todas las líneas se marcan y bloquean.
            if (docExon) { exonChk.value = '1'; }

            // ── Cálculo MULTI-IMPUESTO ────────────────────────────────────
            // Se recorren TODOS los impuestos de la línea (.taxList). La base
            // imponible usa la tarifa COMBINADA (I.V.I.), y cada impuesto grava
            // esa misma base con su propia tarifa y exoneración.
            const rowTaxes = getLineTaxes(tr);
            const combinedRate = rowTaxes.reduce((s, t) => s + (parseFloat(t.rate) || 0), 0) / 100;
            const unitBase = (ivi && combinedRate > 0) ? price / (1 + combinedRate) : price;
            const gross = unitBase * qty;
            let base = gross - d; if (base < 0) base = 0;

            let fullTax = 0, exonAmount = 0;
            rowTaxes.forEach(t => {
                const tRatePct = parseFloat(t.rate) || 0;
                const tTax = base * tRatePct / 100;
                fullTax += tTax;
                // Modo de exoneración por impuesto.
                let tExon = 0;
                if (docExon) {
                    tExon = tTax * exonPct / 100;
                } else if (t.exonMode === 'standard') {
                    tExon = tTax;
                } else if (t.exonMode === 'full') {
                    let ep = parseFloat(t.exonPercent) || 0;
                    if (ep < 0) ep = 0; if (ep > tRatePct) ep = tRatePct;
                    tExon = base * ep / 100;
                }
                exonAmount += tExon;
            });
            const lineExon = docExon || rowTaxes.some(t => (t.exonMode && t.exonMode !== 'none'));
            if (lineExon) anyExon = true;

            const netTax = fullTax - exonAmount;
            const lineTotal = base + netTax;

            // Displays de columnas (imagen de referencia)
            const montoCell = tr.querySelector('.montoTotal');
            if (montoCell) montoCell.textContent = gross.toFixed(2);
            const subCell = tr.querySelector('.subtotalCell');
            if (subCell) subCell.textContent = base.toFixed(2);
            const discDisp = tr.querySelector('.discDisplay');
            if (discDisp) {
                let dCount = 0;
                try { dCount = (JSON.parse(tr.querySelector('.discList')?.value || '[]') || []).length; } catch { dCount = 0; }
                if (d > 0) {
                    discDisp.textContent = dCount > 1 ? `${d.toFixed(2)} (${dCount})` : d.toFixed(2);
                } else {
                    discDisp.textContent = '—';
                }
            }
            // ── Columna Impuesto: mostrar el MONTO NETO total de impuestos ──
            // (antes mostraba el porcentaje). Este es el valor que suma al total.
            const rateDisp = tr.querySelector('.rateDisplay');
            if (rateDisp) {
                const nTax = rowTaxes.length;
                rateDisp.textContent = netTax > 0
                    ? (nTax > 1 ? `${netTax.toFixed(2)} (${nTax})` : netTax.toFixed(2))
                    : (rowTaxes.length > 0 ? netTax.toFixed(2) : '—');
            }

            tr.classList.toggle('ei-line-exon', lineExon);
            tr.querySelector('.lineTotal').textContent = lineTotal.toFixed(2);
            sub += gross; disc += d; tax += netTax; exon += exonAmount; total += lineTotal;
        });
        document.getElementById('tSubtotal').textContent = sub.toFixed(2);
        document.getElementById('tDiscount').textContent = disc.toFixed(2);
        document.getElementById('tTax').textContent = tax.toFixed(2);
        document.getElementById('tTotal').textContent = total.toFixed(2);
        const tSale = document.getElementById('tSale');
        if (tSale) tSale.textContent = sub.toFixed(2);
        const tSubtotalNet = document.getElementById('tSubtotalNet');
        if (tSubtotalNet) tSubtotalNet.textContent = (sub - disc).toFixed(2);
        const tExon = document.getElementById('tExonerado');
        if (tExon) tExon.textContent = exon.toFixed(2);
        const tExonRow = document.getElementById('tExoneradoRow');
        if (tExonRow) tExonRow.classList.toggle('d-none', exon <= 0);

        // Mostrar la tarjeta de datos de exoneración global SOLO cuando el documento
        // está marcado como exonerado ("Documento exonerado"). La exoneración por
        // línea se captura en el modal de impuestos y NO usa esta tarjeta.
        const exonCard = document.getElementById('exonCard');
        if (exonCard) {
            const wasHidden = exonCard.classList.contains('d-none');
            exonCard.classList.toggle('d-none', !docExon);
            if (docExon && wasHidden) ensureExonDefaults();
        }
    }

    // Preselecciona los valores por defecto de la exoneración cuando aún no se han fijado.
    // Siempre deja datos default cuando hay al menos una línea exonerada en el documento.
    function ensureExonDefaults() {
        const dt = document.getElementById('exonDocType');
        const inst = document.getElementById('exonInstitution');
        const num = document.getElementById('exonDocNumber');
        const date = document.getElementById('exonDate');
        const pct = document.getElementById('exonPercent');
        if (dt && !dt.value) dt.value = '99';
        if (inst && !inst.value) inst.value = '99';
        if (num && !num.value.trim()) num.value = '000';
        if (pct && (!pct.value || parseFloat(pct.value) < 1)) pct.value = '100';
        if (date && !date.value) {
            const now = new Date();
            date.value = now.toISOString().slice(0, 10); // yyyy-MM-dd
        }
    }

    // ---------------- Carga de emisores y receptores ----------------
    async function loadIssuers() {
        try {
            const r = await emitFetch('/api/Customer?includeInactive=false');

            if (!r.ok) {
                console.error('Error al cargar customers:', r.status);
                return;
            }

            const list = await r.json();

            // La API puede devolver un array directo o un objeto wrapper
            const customers = Array.isArray(list) ? list : (list.data || []);

            // Filtrar emisores (isIssuer = true)
            const issuers = customers.filter(c => c.isIssuer === true);
            const selIssuer = document.getElementById('issuerId');
            selIssuer.innerHTML = '<option value="">-- Seleccione emisor --</option>' +
                issuers.map(i =>
                    `<option value="${i.id}">${i.isCompanyOwner ? '★ ' : ''}${i.name} (${i.identification})</option>`
                ).join('');

            // Cargar receptores (todos los customers)
            const selReceptor = document.getElementById('receptorId');
            selReceptor.innerHTML = '<option value="">-- Seleccione receptor --</option>' +
                customers.map(c =>
                    `<option value="${c.id}">${c.name} (${c.identification})</option>`
                ).join('');

        } catch (err) {
            console.error('Error al cargar customers:', err);
        }
    }

    // ---------------- Catálogo "Tipo documento de referencia" ----------------
    // El selector refDocType se puebla desde el catálogo central
    // admin.electronic_document_reference_type (endpoint active). No hardcodear valores.
    async function loadReferenceTypes() {
        const targets = ['refDocType', 'refModalDocType']
            .map(id => document.getElementById(id))
            .filter(Boolean);
        if (!targets.length) return;
        try {
            const res = await emitFetch('/api/electronicdocumentreferencetype/active');
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const items = await res.json();
            const html = (items || [])
                .map(x => `<option value="${x.code}">${x.code} - ${x.description}</option>`)
                .join('') || '<option value="">(sin tipos)</option>';
            targets.forEach(sel => { sel.innerHTML = html; });
        } catch (e) {
            console.warn('No se pudo cargar el catálogo de tipos de referencia:', e);
            targets.forEach(sel => { sel.innerHTML = '<option value="01">01 - Factura electrónica</option>'; });
        }
    }

    // ---------------- Información de referencia (modal emergente) ----------------
    // Lista de referencias capturadas manualmente por el usuario mediante el modal.
    // Se combinan con la referencia automática (NC/ND/REP) al emitir.
    let manualReferences = [];

    function escapeRefHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    function renderReferences() {
        const section = document.getElementById('referencesSection');
        const body = document.getElementById('referencesBody');
        if (!body) return;
        if (!manualReferences.length) {
            body.innerHTML = '';
            section?.classList.add('d-none');
            return;
        }
        section?.classList.remove('d-none');
        body.innerHTML = manualReferences.map((r, i) => `
            <tr>
                <td>${escapeRefHtml(r.docTypeLabel || r.refDocumentType)}</td>
                <td class="text-break">${escapeRefHtml(r.refClave)}</td>
                <td>${escapeRefHtml((r.refDate || '').substring(0, 10))}</td>
                <td>${escapeRefHtml(r.refCode)}</td>
                <td>${escapeRefHtml(r.refReason)}</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="editReference(${i})"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeReference(${i})"><i class="bi bi-trash"></i></button>
                </td>
            </tr>`).join('');
    }

    function validateReferenceClave() {
        const input = document.getElementById('refModalClave');
        const err = document.getElementById('refModalClaveError');
        const val = (input?.value || '').trim();
        if (val && !/^\d{50}$/.test(val)) {
            err?.classList.remove('d-none');
            if (err) err.textContent = 'La clave debe tener exactamente 50 dígitos numéricos.';
            return false;
        }
        err?.classList.add('d-none');
        return true;
    }

    function openReferenceModal(index = -1) {
        document.getElementById('refModalIndex').value = String(index);
        document.getElementById('refModalClaveError')?.classList.add('d-none');
        if (index >= 0 && manualReferences[index]) {
            const r = manualReferences[index];
            document.getElementById('refModalDocType').value = r.refDocumentType;
            document.getElementById('refModalClave').value = r.refClave;
            document.getElementById('refModalDate').value = (r.refDate || '').substring(0, 10);
            document.getElementById('refModalCode').value = r.refCode;
            document.getElementById('refModalReason').value = r.refReason;
        } else {
            const dtSel = document.getElementById('refModalDocType');
            if (dtSel && dtSel.options.length) dtSel.selectedIndex = 0;
            document.getElementById('refModalClave').value = '';
            document.getElementById('refModalDate').value = '';
            document.getElementById('refModalCode').value = '01';
            document.getElementById('refModalReason').value = '';
        }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('referenceModal')).show();
    }

    function addReferenceFromModal() {
        const clave = document.getElementById('refModalClave').value.trim();
        if (!/^\d{50}$/.test(clave)) {
            validateReferenceClave();
            alert('La clave / número del documento referenciado debe tener 50 dígitos numéricos.');
            return;
        }
        const reason = document.getElementById('refModalReason').value.trim();
        if (!reason) { alert('Debe indicar la razón de la referencia.'); return; }

        const dtSel = document.getElementById('refModalDocType');
        const dateVal = document.getElementById('refModalDate').value;
        const ref = {
            refDocumentType: dtSel.value,
            docTypeLabel: dtSel.options[dtSel.selectedIndex]?.textContent || dtSel.value,
            refClave: clave,
            refDate: dateVal ? new Date(dateVal + 'T00:00:00').toISOString() : new Date().toISOString(),
            refCode: document.getElementById('refModalCode').value,
            refReason: reason
        };

        const index = parseInt(document.getElementById('refModalIndex').value, 10);
        if (index >= 0 && manualReferences[index]) {
            manualReferences[index] = ref;
        } else {
            manualReferences.push(ref);
        }
        renderReferences();
        bootstrap.Modal.getInstance(document.getElementById('referenceModal'))?.hide();
    }

    function editReference(index) { openReferenceModal(index); }
    function removeReference(index) {
        manualReferences.splice(index, 1);
        renderReferences();
    }
    window.editReference = editReference;
    window.removeReference = removeReference;

    // ---------------- Referencia según tipo ----------------
    function toggleReference() {
        const sel = document.getElementById('documentType');
        // poblado en loadDocumentTypes). Fallback a la lista histórica si no viene el dato.
        const opt = sel.options[sel.selectedIndex];
        let needs;
        if (opt && typeof opt.dataset.requiresReference !== 'undefined') {
            needs = opt.dataset.requiresReference === 'true';
        } else {
            needs = ['02', '03', '08', '10'].includes(sel.value);
        }
        document.getElementById('referenceCard').classList.toggle('d-none', !needs);
        toggleReceptor();
        return needs;
    }

    // ---------------- Receptor según tipo ----------------
    // El Tiquete Electrónico (TE, tipo "04") es para consumidor final: su XSD NO admite
    // el bloque Receptor. Se oculta el campo y se limpia cualquier receptor seleccionado.
    function toggleReceptor() {
        const dt = document.getElementById('documentType').value;
        const isTiquete = dt === '04';
        const field = document.getElementById('receptorField');
        if (field) field.classList.toggle('d-none', isTiquete);
        if (isTiquete) {
            const rid = document.getElementById('receptorId');
            const rdisp = document.getElementById('receptorDisplay');
            if (rid) rid.value = '';
            if (rdisp) rdisp.value = '';
        }
    }

    // ---------------- Emisión ----------------
    function logToConsole(step, message, level) {
        const consoleEl = document.getElementById('emitConsole');
        const ts = new Date().toLocaleTimeString('es-CR', { hour12: false });
        const colors = { INFO: '#c9d1d9', SUCCESS: '#3fb950', WARNING: '#d29922', ERROR: '#f85149' };
        const color = colors[level] || '#c9d1d9';
        const line = document.createElement('div');
        line.innerHTML = `<span style="color:#6e7681">[${ts}]</span> ` +
            `<span style="color:#58a6ff">${step.padEnd(12, ' ').replace(/ /g, '&nbsp;')}</span> ` +
            `<span style="color:${color}">${message}</span>`;
        consoleEl.appendChild(line);
        consoleEl.scrollTop = consoleEl.scrollHeight;
    }

    function setConsoleStatus(text, cls) {
        const badge = document.getElementById('emitConsoleStatus');
        badge.className = 'badge ' + cls;
        badge.textContent = text;
    }

    // Consulta el estado real en Hacienda varias veces (aceptación/rechazo es
    // asíncrono). Actualiza la consola y el badge con el desenlace final.
    async function pollHaciendaStatus(documentId) {
        const maxAttempts = 6;      // ~6 intentos
        const delayMs = 5000;       // cada 5s (total ~30s)
        setConsoleStatus('Consultando Hacienda...', 'bg-warning text-dark');
        logToConsole('CONSULTA', 'La aceptación de Hacienda es asíncrona. Consultando estado real...', 'INFO');

        for (let attempt = 1; attempt <= maxAttempts; attempt++) {
            await new Promise(res => setTimeout(res, delayMs));
            try {
                const r = await emitFetch(`/api/electronicinvoice/${documentId}/poll-status`, { method: 'POST' });
                if (!r.ok) { continue; }
                const s = await r.json();

                if (s.resolved) {
                    const accepted = /acept/i.test(s.status);
                    const lvl = accepted ? 'SUCCESS' : 'ERROR';
                    logToConsole('CONSULTA', `Hacienda resolvió el comprobante — Estado: ${s.status}. ${s.haciendaDetail || s.message || ''}`, lvl);
                    setConsoleStatus(s.status, accepted ? 'bg-success' : 'bg-danger');
                    document.getElementById('emitResult').innerHTML =
                        `<div class="alert ${accepted ? 'alert-success' : 'alert-danger'}">` +
                        `Estado final: <strong>${s.status}</strong>. ${s.haciendaDetail || s.message || ''}</div>`;
                    return;
                } else {
                    logToConsole('CONSULTA', `Intento ${attempt}/${maxAttempts}: Hacienda aún procesando...`, 'INFO');
                }
            } catch (e) {
                logToConsole('CONSULTA', `Intento ${attempt}/${maxAttempts}: no se pudo consultar (${e.message}).`, 'WARNING');
            }
        }

        // No resolvió dentro del tiempo de la consola: es normal, seguirá en background.
        logToConsole('CONSULTA', 'Hacienda continúa procesando. El sistema seguirá consultando automáticamente en segundo plano; podrá ver el resultado desde la lista de documentos (botón de bitácora).', 'WARNING');
        setConsoleStatus('Procesando (en background)', 'bg-info text-dark');
    }

    // Limita un input numérico a un máximo de dígitos. En inputs type="number"
    // maxlength no funciona, por eso se recorta el valor manualmente en oninput.
    function limitDigits(el, max) {
        if (!el) return;
        let v = (el.value || '').replace(/\D/g, '');
        if (v.length > max) v = v.slice(0, max);
        el.value = v;
    }
    window.limitDigits = limitDigits;

    // Construye la colección de impuestos (payload) de una línea desde el hidden
    // .taxList. Convierte cada impuesto del editor de tarjetas a EmitLineTaxDto.
    // exonPercent que se envía = % del IMPUESTO exonerado:
    //   standard → 100; full → (tarifaEfectiva / tarifaImpuesto) × 100.
    function buildLineTaxesPayload(tr, docExonChecked, cardPct, cardDocType, cardDocNumber, cardInstitution, cardDate) {
        let list = [];
        try { list = JSON.parse(tr.querySelector('.taxList')?.value || '[]') || []; } catch { list = []; }
        if (!Array.isArray(list) || list.length === 0) return [];
        return list.map(t => {
            const ratePct = parseFloat(t.rate) || 0;
            // Documento exonerado global fuerza exoneración estándar sobre cada impuesto.
            const effMode = docExonChecked ? 'standard' : (t.exonMode || 'none');
            const isExon = (effMode !== 'none');
            let exonPercent = 0;
            if (effMode === 'standard') {
                exonPercent = 100;
            } else if (effMode === 'full') {
                const effRate = parseFloat(t.exonPercent) || 0;
                exonPercent = (effRate > 0 && ratePct > 0) ? Math.min(effRate / ratePct * 100, 100) : 0;
            }
            const dateVal = docExonChecked ? cardDate : (t.exonDate || '');
            const dateIso = dateVal
                ? (typeof dateVal === 'string' && dateVal.length === 10
                    ? new Date(dateVal + 'T00:00:00').toISOString()
                    : dateVal)
                : null;
            return {
                idElectronicDocumentTaxType: parseInt(t.taxTypeId, 10) || 1,
                taxCode: t.taxCode || '01',
                taxRatePercent: ratePct,
                taxRateCode: t.rateCode || mapTaxRateCode(ratePct),
                // ── Datos físicos de impuestos específicos / cálculo especial ──
                unitMeasureQty: (t.spec && t.spec.unitQty != null) ? (parseFloat(t.spec.unitQty) || 0) : null,
                volumeUnit: (t.spec && t.spec.volume != null) ? (parseFloat(t.spec.volume) || 0) : null,
                specPercent: (t.spec && t.spec.percent != null) ? (parseFloat(t.spec.percent) || 0) : null,
                perUnitTax: (t.spec && t.spec.perUnit != null) ? (parseFloat(t.spec.perUnit) || 0) : null,
                proportion: (t.spec && t.spec.proportion != null) ? (parseFloat(t.spec.proportion) || 0) : null,
                specialTaxableBase: (t.specialBase != null) ? (parseFloat(t.specialBase) || 0) : null,
                isFactoryTax: !!t.isFactoryTax,
                taxAmount: (t.taxAmount != null) ? (parseFloat(t.taxAmount) || 0) : null,
                taxDescription: t.description || null,
                isExonerated: isExon,
                exonPercent: isExon ? exonPercent : 0,
                exonDocumentType: isExon ? ((docExonChecked ? cardDocType : t.exonAuthType) || null) : null,
                exonDocumentNumber: isExon ? ((docExonChecked ? cardDocNumber : t.exonDocNumber) || null) : null,
                exonInstitution: isExon ? ((docExonChecked ? cardInstitution : t.exonInstitution) || null) : null,
                exonDate: isExon ? dateIso : null,
                exonArticle: (isExon && !docExonChecked && t.exonArticle) ? (parseInt(t.exonArticle, 10) || null) : null,
                exonSubsection: (isExon && !docExonChecked && t.exonSubsection) ? (parseInt(t.exonSubsection, 10) || null) : null
            };
        });
    }
    window.buildLineTaxesPayload = buildLineTaxesPayload;

    async function emit() {
        // Acumuladores de validación y construcción de líneas del payload.
        let ok = true;
        const lines = [];
        const docExonChecked = document.getElementById('docExonerated').checked;
        const exDocType = (document.getElementById('exonDocType')?.value || '99');
        const exDocNumber = (document.getElementById('exonDocNumber')?.value || '').trim() || '000';
        const exInstitution = (document.getElementById('exonInstitution')?.value || '99');
        const exDateVal = document.getElementById('exonDate')?.value;
        const exDate = exDateVal ? new Date(exDateVal + 'T00:00:00').toISOString() : new Date().toISOString();
        let exPct = parseFloat(document.getElementById('exonPercent')?.value) || 100;
        if (exPct < 1) exPct = 1; if (exPct > 100) exPct = 100;
        document.querySelectorAll('#linesBody tr').forEach(tr => {
            const manual = tr.querySelector('.manualCabys')?.checked || false;
            const itemCode = (tr.querySelector('.itemCode')?.value || '').trim();
            const cabys = tr.querySelector('.cabys').value.trim();
            // En modo por código de ítem, el CAByS ya fue resuelto al hacer blur.
            if (!manual && !itemCode) { tr.querySelector('.itemCode').classList.add('cabys-invalid'); ok = false; return; }
            if (!isValidCabys(cabys)) {
                (manual ? tr.querySelector('.cabys') : tr.querySelector('.itemCode')).classList.add('cabys-invalid');
                ok = false; return;
            }
            const disc = parseFloat(tr.querySelector('.disc').value) || 0;
            const nature = tr.querySelector('.nature').value;
            let discountsList = [];
            try { discountsList = JSON.parse(tr.querySelector('.discList')?.value || '[]') || []; } catch { discountsList = []; }
            // Validación: cada descuento requiere código y monto > 0.
            for (const d of discountsList) {
                if (!d.nature || !(parseFloat(d.amount) > 0)) {
                    tr.querySelector('.discDisplay')?.classList.add('cabys-invalid');
                    ok = false; return;
                }
            }
            if (disc > 0 && discountsList.length === 0 && !nature) { tr.querySelector('.nature').classList.add('cabys-invalid'); ok = false; return; }
            const taxTypeSel = tr.querySelector('.taxType');
            const taxTypeId = parseInt(taxTypeSel?.value, 10) || 0;
            if (!taxTypeId) { taxTypeSel?.classList.add('cabys-invalid'); ok = false; return; }
            const ratePct = parseFloat(tr.querySelector('.rate').value) || 0;
            const lineExonMode = tr.querySelector('.exonMode')?.value
                || ((tr.querySelector('.exon')?.value === '1') ? 'standard' : 'none');
            const lineExon = (lineExonMode !== 'none') || docExonChecked;
            // Datos de exoneración por línea (capturados en el modal de impuesto).
            const lineExonAuthType = tr.querySelector('.exonAuthType')?.value || '';
            const lineExonInstitution = tr.querySelector('.exonInstitution')?.value || '';
            const lineExonDocNumber = (tr.querySelector('.exonDocNumber')?.value || '').trim();
            const lineExonDateVal = tr.querySelector('.exonDate')?.value || '';
            const lineExonDate = lineExonDateVal ? new Date(lineExonDateVal + 'T00:00:00').toISOString() : null;
            const lineExonArticleVal = (tr.querySelector('.exonArticle')?.value || '').trim();
            const lineExonArticle = lineExonArticleVal ? (parseInt(lineExonArticleVal, 10) || null) : null;
            const lineExonSubsectionVal = (tr.querySelector('.exonSubsection')?.value || '').trim();
            const lineExonSubsection = lineExonSubsectionVal ? (parseInt(lineExonSubsectionVal, 10) || null) : null;
            // exonPercent que se envía al backend = % del IMPUESTO exonerado.
            //  - standard: 100% del impuesto.
            //  - full: la tarifa efectiva exonerada (ej. 3%) se convierte a % del impuesto:
            //          %impuesto = tarifaEfectiva / tarifaIVA × 100.
            let lineExonPercent = null;
            if (lineExonMode === 'standard' || docExonChecked) {
                lineExonPercent = 100;
            } else if (lineExonMode === 'full') {
                const effRate = parseFloat(tr.querySelector('.exonPercent')?.value);
                if (!isNaN(effRate) && effRate > 0 && ratePct > 0) {
                    lineExonPercent = Math.min(effRate / ratePct * 100, 100);
                }
            }
            lines.push({
                cabysCode: cabys,
                // Cuando el CAByS es manual, el código comercial del ítem que se transmite
                // en la factura es el mismo CAByS; no se envía itemCode.
                itemCode: manual ? cabys : (itemCode || null),
                manualCabys: manual,
                idElectronicDocumentTaxType: taxTypeId,
                detail: getDetail(tr),
                quantity: parseFloat(tr.querySelector('.qty').value) || 0,
                unitPrice: parseFloat(tr.querySelector('.price').value) || 0,
                priceIncludesTax: document.getElementById('priceIncludesTax').checked,
                taxRatePercent: ratePct,
                taxRateCode: mapTaxRateCode(ratePct),
                discountAmount: disc,
                discountNature: nature || null,
                discounts: discountsList.map(d => ({ nature: d.nature, amount: parseFloat(d.amount) || 0 })),
                isExonerated: lineExon,
                exonPercent: lineExon ? (lineExonPercent ?? exPct) : 0,
                exonDocumentType: lineExon ? (lineExonAuthType || exDocType) : null,
                exonDocumentNumber: lineExon ? (lineExonDocNumber || exDocNumber) : null,
                exonInstitution: lineExon ? (lineExonInstitution || exInstitution) : null,
                exonDate: lineExon ? (lineExonDate || exDate) : null,
                exonArticle: lineExon ? lineExonArticle : null,
                exonSubsection: lineExon ? lineExonSubsection : null,
                // ── Lista de impuestos de la línea (multi-impuesto v4.4) ──────
                // Cada elemento describe un impuesto independiente con su propia
                // exoneración. Se construye desde el hidden .taxList (editor de
                // tarjetas). El backend usa esta colección cuando viene poblada.
                taxes: buildLineTaxesPayload(tr, docExonChecked, exPct, exDocType, exDocNumber, exInstitution, exDate)
            });
        });

        if (!ok || lines.length === 0) {
            alert('Corrija las líneas: código de ítem (o CAByS manual de 13 dígitos), tipo de impuesto y naturaleza de descuento son obligatorios.');
            return;
        }

        const issuerRaw = document.getElementById('issuerId').value;
        const issuerId = parseInt(issuerRaw, 10);
        if (!issuerRaw || Number.isNaN(issuerId)) {
            alert('Debe seleccionar un emisor antes de emitir el comprobante.');
            document.getElementById('issuerDisplay')?.classList.add('cabys-invalid');
            return;
        }

        const receptorRaw = document.getElementById('receptorId').value;
        // El Tiquete Electrónico (TE) no lleva receptor: forzamos null aunque hubiese
        // quedado un valor residual seleccionado antes de cambiar el tipo de documento.
        const docTypeVal = document.getElementById('documentType').value;
        const receptorId = (docTypeVal === '04')
            ? null
            : (receptorRaw ? (parseInt(receptorRaw, 10) || null) : null);

        const payload = {
            issuerId: issuerId,
            receptorId: receptorId,
            documentType: document.getElementById('documentType').value,
            consecutiveId: (parseInt(document.getElementById('consecutiveId').value, 10) || null),
            issuerEconomicActivity: (document.getElementById('issuerActivityCode')?.value || null),
            receptorEconomicActivity: (document.getElementById('receptorActivityCode')?.value || null),
            issuerEmailOverride: (window.partyState?.issuer.email || null),
            issuerPhoneOverride: (window.partyState?.issuer.phone || null),
            receptorEmailOverride: (window.partyState?.receptor.email || null),
            receptorPhoneOverride: (window.partyState?.receptor.phone || null),
            saleCondition: document.getElementById('saleCondition').value,
            currency: document.getElementById('currency').value,
            isExonerated: document.getElementById('docExonerated').checked,
            lines: lines,
            references: [],
            otherCharges: otherChargesList.map(c => ({
                typeCode: c.typeCode,
                otherTypeDescription: c.otherTypeDescription || null,
                detail: c.detail,
                amount: c.amount,
                percent: c.percent || null,
                thirdIdentType: c.thirdIdentType || null,
                thirdIdentNumber: c.thirdIdentNumber || null,
                thirdName: c.thirdName || null
            }))
        };

        // Métodos de pago: uno o varios (checkboxes). Se envía el primero como
        // `paymentMethod` (compatibilidad con el flujo actual de un solo medio) y la
        // lista completa como `paymentMethods` (CSV) para el desglose de <MedioPago>.
        const selectedPaymentMethods = getSelectedPaymentMethods();
        if (!selectedPaymentMethods.length) {
            alert('Debe seleccionar al menos un método de pago.');
            return;
        }
        payload.paymentMethod = selectedPaymentMethods[0];
        payload.paymentMethods = selectedPaymentMethods.join(',');

        // Consecutivo: debe seleccionarse uno activo antes de emitir.
        if (!payload.consecutiveId) {
            alert('Debe seleccionar el consecutivo del documento electrónico.');
            document.getElementById('consecutiveId')?.classList.add('cabys-invalid');
            return;
        }

        // Plazo de crédito: obligatorio cuando la condición de venta seleccionada es de
        // tipo crédito (requires_credit_term = true en el catálogo admin.electronic_document_sales_conditions).
        // Hacienda rechaza el comprobante (error -58) si falta el nodo <PlazoCredito>.
        if (saleConditionRequiresCreditTerm(payload.saleCondition)) {
            const creditTerm = parseInt(document.getElementById('creditTerm').value, 10);
            if (!creditTerm || creditTerm < 1) {
                alert('Para ventas a crédito debe indicar el plazo de crédito (en días).');
                return;
            }
            payload.creditTerm = creditTerm;
        }

        if (toggleReference()) {
            const refClave = document.getElementById('refClave').value.trim();
            if (refClave.length !== 50) { alert('La clave de referencia debe tener 50 dígitos.'); return; }
            const refReason = document.getElementById('refReason').value.trim();
            if (!refReason) { alert('Debe indicar la razón de la referencia.'); return; }
            const refDateVal = document.getElementById('refDate').value;
            // Si el usuario no indicó fecha, se intenta derivar del documento referenciado
            // (posiciones 7-12 de la clave = AAMMDD); si no, se usa la fecha actual.
            let refDateIso;
            if (refDateVal) {
                refDateIso = new Date(refDateVal + 'T00:00:00').toISOString();
            } else {
                refDateIso = new Date().toISOString();
            }
            payload.references.push({
                refDocumentType: document.getElementById('refDocType').value,
                refClave: refClave,
                refDate: refDateIso,
                refCode: document.getElementById('refCode').value,
                refReason: refReason
            });
        }

        // Referencias capturadas manualmente en el modal emergente.
        manualReferences.forEach(r => {
            payload.references.push({
                refDocumentType: r.refDocumentType,
                refClave: r.refClave,
                refDate: r.refDate,
                refCode: r.refCode,
                refReason: r.refReason
            });
        });

        const btn = document.getElementById('emitBtn');
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Emitiendo...';

        // Mostrar consola de progreso
        const consoleCard = document.getElementById('emitConsoleCard');
        const consoleEl = document.getElementById('emitConsole');
        consoleCard.classList.remove('d-none');
        consoleEl.innerHTML = '';
        document.getElementById('emitResult').innerHTML = '';
        setConsoleStatus('Procesando...', 'bg-warning text-dark');
        logToConsole('CLIENTE', 'Enviando solicitud de emisión al servidor...', 'INFO');
        consoleCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        try {
            const r = await emitFetch('/api/electronicinvoice/emit', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
                });
            const d = await r.json();

            // Reproducir la bitácora paso a paso devuelta por el servidor
            if (d.logs && d.logs.length) {
                for (const entry of d.logs) {
                    logToConsole(entry.step, entry.message, entry.level);
                    await new Promise(res => setTimeout(res, 220));
                }
            }

            if (r.ok) {
                const statusLevel = /acept/i.test(d.status) ? 'SUCCESS'
                    : /contingencia|proces/i.test(d.status) ? 'WARNING' : 'INFO';
                logToConsole('RESULTADO', `Comprobante ${d.clave} — Estado: ${d.status}. ${d.message || ''}`, statusLevel);
                document.getElementById('emitResult').innerHTML =
                    `<div class="alert alert-success">Comprobante <strong>${d.clave}</strong> — Estado: <strong>${d.status}</strong>. ${d.message || ''}</div>`;

                // Si Hacienda quedó "Procesando", la aceptación/rechazo es asíncrona.
                // Consultamos su estado real unas cuantas veces antes de dar por
                // terminada la consola, para que el usuario vea el desenlace.
                if (/proces/i.test(d.status) && d.documentId) {
                    await pollHaciendaStatus(d.documentId);
                } else {
                    setConsoleStatus(d.status || 'Completado', statusLevel === 'SUCCESS' ? 'bg-success' : 'bg-info text-dark');
                }
            } else {
                // Extraer el mensaje de error más específico disponible en la respuesta.
                // Backend: 400 → { message }, 500 → { message, error },
                // validación de modelo → { title, errors: { campo: [msgs] } }.
                let detail = d.message || d.title || 'Error al emitir';
                if (d.error) detail += `: ${d.error}`;
                if (d.errors) {
                    const flat = Object.values(d.errors).flat();
                    if (flat.length) detail += ' — ' + flat.join(' | ');
                }
                logToConsole('ERROR', detail, 'ERROR');
                setConsoleStatus('Error', 'bg-danger');
                document.getElementById('emitResult').innerHTML =
                    `<div class="alert alert-danger">${detail}</div>`;
            }
        } catch (e) {
            const msg = (e && e.message) ? e.message : 'Error de conexión con el servidor.';
            logToConsole('ERROR', `Error de conexión: ${msg}`, 'ERROR');
            setConsoleStatus('Error', 'bg-danger');
            document.getElementById('emitResult').innerHTML =
                `<div class="alert alert-danger">Error de conexión: ${msg}</div>`;
        } finally {
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-send-check"></i> Emitir y enviar a Hacienda';
        }
    }

    // ---------------- Otros cargos (OtroCargo Hacienda CR v4.4) ----------------
