    // ---------------- Catálogo de condiciones de venta ----------------
    // El selector de "Condición venta" se puebla desde la tabla central
    // admin.electronic_document_sales_conditions (solo condiciones activas). Cada opción
    // guarda si requiere plazo de crédito y su plazo por defecto (en días).
    const saleConditionMeta = {}; // code -> { requiresCreditTerm, defaultCreditTermDays }

    function saleConditionRequiresCreditTerm(code) {
        return !!(saleConditionMeta[code] && saleConditionMeta[code].requiresCreditTerm);
    }

    async function loadSaleConditions() {
        const sel = document.getElementById('saleCondition');
        try {
            const r = await emitFetch('/api/electronicdocumentsalescondition/active');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const items = await r.json();
            sel.innerHTML = '';
            for (const it of items) {
                saleConditionMeta[it.code] = {
                    requiresCreditTerm: !!it.requiresCreditTerm,
                    defaultCreditTermDays: it.defaultCreditTermDays || 30
                };
                const opt = document.createElement('option');
                opt.value = it.code;
                opt.textContent = it.description;
                sel.appendChild(opt);
            }
            // Seleccionar Contado (01) por defecto si existe
            if ([...sel.options].some(o => o.value === '01')) sel.value = '01';
        } catch (e) {
            console.error('No se pudo cargar el catálogo de condiciones de venta.', e);
            // Respaldo mínimo para no dejar el selector vacío
            sel.innerHTML = '<option value="01">Contado</option><option value="02">Crédito</option>';
            saleConditionMeta['01'] = { requiresCreditTerm: false, defaultCreditTermDays: 30 };
            saleConditionMeta['02'] = { requiresCreditTerm: true, defaultCreditTermDays: 30 };
        }
        toggleCreditTerm();
    }

    // Muestra/oculta el plazo de crédito según la condición de venta seleccionada.
    // Cuando la condición requiere plazo, autollena con el default del catálogo (p.ej. 30 días).
    function toggleCreditTerm() {
        const code = document.getElementById('saleCondition').value;
        const requires = saleConditionRequiresCreditTerm(code);
        document.getElementById('creditTermWrapper').classList.toggle('d-none', !requires);
        if (requires) {
            const inp = document.getElementById('creditTerm');
            const def = saleConditionMeta[code]?.defaultCreditTermDays || 30;
            if (!inp.value || parseInt(inp.value, 10) <= 0) inp.value = def;
        }
    }
    document.getElementById('saleCondition').addEventListener('change', toggleCreditTerm);

    // ---------------- Catálogo de métodos de pago ----------------
    // Los checkboxes de "Métodos de pago" se pueblan desde la tabla central
    // admin.electronic_document_payment_methods (solo medios activos). Se permite
    // seleccionar uno o varios (MedioPago de Hacienda v4.4).
    async function loadPaymentMethods() {
        const cont = document.getElementById('paymentMethodsContainer');
        try {
            const r = await emitFetch('/api/electronicdocumentpaymentmethod/active');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const items = await r.json();
            renderPaymentMethods(items);
        } catch (e) {
            console.error('No se pudo cargar el catálogo de métodos de pago.', e);
            // Respaldo mínimo con el catálogo oficial de Hacienda
            renderPaymentMethods([
                { code: '01', description: 'Efectivo' },
                { code: '02', description: 'Tarjeta' },
                { code: '03', description: 'Cheque' },
                { code: '04', description: 'Transferencia - depósito bancario' },
                { code: '05', description: 'Recaudado por terceros' },
                { code: '06', description: 'SINPE MÓVIL' },
                { code: '07', description: 'Plataforma digital' },
                { code: '99', description: 'Otros' }
            ]);
        }
    }

    function renderPaymentMethods(items) {
        const cont = document.getElementById('paymentMethodsContainer');
        cont.innerHTML = '';
        (items || []).forEach(it => {
            const wrap = document.createElement('div');
            wrap.className = 'form-check';
            const cb = document.createElement('input');
            cb.className = 'form-check-input pm-check';
            cb.type = 'checkbox';
            cb.value = it.code;
            cb.id = 'pm_' + it.code;
            const lbl = document.createElement('label');
            lbl.className = 'form-check-label';
            lbl.setAttribute('for', cb.id);
            lbl.textContent = it.description;
            wrap.appendChild(cb);
            wrap.appendChild(lbl);
            cont.appendChild(wrap);
        });
        // Preseleccionar Efectivo (01) por defecto si existe
        const def = document.getElementById('pm_01');
        if (def) def.checked = true;
    }

    // Devuelve los códigos de los métodos de pago seleccionados (en orden del DOM).
    function getSelectedPaymentMethods() {
        return [...document.querySelectorAll('.pm-check:checked')].map(c => c.value);
    }
    // ---------------- Carga dinámica del catálogo de tipos de documento ----------------
    // El selector de "Tipo de Documento Electrónico" se puebla desde la tabla central
    // admin.electronic_document_type (solo los tipos con show_in_emit=true). Así, agregar
    // o habilitar un nuevo tipo en el futuro es solo parametrizarlo en la BD, sin tocar código.
    async function loadDocumentTypes() {
        const sel = document.getElementById('documentType');
        try {
            const r = await emitFetch('/api/electronicdocumenttype/visible');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const types = await r.json();
            sel.innerHTML = '';
            types.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.code;
                opt.textContent = `${t.name} (${t.shortCode})`;
                opt.dataset.requiresReceptor = t.requiresReceptor;
                opt.dataset.requiresReference = t.requiresReference;
                sel.appendChild(opt);
            });
            if (!types.length) {
                sel.innerHTML = '<option value="">No hay tipos habilitados</option>';
            }
        } catch (e) {
            console.error('No se pudo cargar el catálogo de tipos de documento:', e);
            sel.innerHTML = '<option value="">Error al cargar tipos</option>';
        }
    }

    // ---------------- Carga de consecutivos fiscales del emisor + tipo de documento ----------------
    // Puebla el selector "Consecutivo" con los consecutivos ACTIVOS disponibles para el
    // emisor seleccionado y el tipo de documento actual. El registro predefinido (default)
    // viene primero desde el API y queda preseleccionado, pero el usuario puede elegir
    // cualquier otro que esté activo para ese tipo de documento electrónico.
    async function loadConsecutives() {
        const sel = document.getElementById('consecutiveId');
        const issuerId = parseInt(document.getElementById('issuerId').value, 10);
        const docType = document.getElementById('documentType').value;

        if (!issuerId || Number.isNaN(issuerId)) {
            sel.innerHTML = '<option value="">Seleccione un emisor...</option>';
            return;
        }
        if (!docType) {
            sel.innerHTML = '<option value="">Seleccione un tipo de documento...</option>';
            return;
        }

        sel.innerHTML = '<option value="">Cargando...</option>';
        try {
            const params = new URLSearchParams({ issuerCredentialId: issuerId, documentType: docType });
            const r = await emitFetch(`/api/electronicdocumentconsecutive/for-emit?${params}`);
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const list = await r.json();
            sel.innerHTML = '';
            if (!Array.isArray(list) || list.length === 0) {
                sel.innerHTML = '<option value="">No hay consecutivos activos configurados</option>';
                return;
            }
            list.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                const seq = String((c.consecutive ?? 0) + 1).padStart(10, '0');
                const desc = c.description ? ` - ${c.description}` : '';
                const def = c.isDefault ? ' ★ (predefinido)' : '';
                opt.textContent = `Suc ${c.branch} / Term ${c.terminal} · Próx ${seq}${desc}${def}`;
                if (c.isDefault) opt.selected = true;
                sel.appendChild(opt);
            });
        } catch (e) {
            console.error('No se pudieron cargar los consecutivos:', e);
            sel.innerHTML = '<option value="">Error al cargar consecutivos</option>';
        }
    }
    window.loadConsecutives = loadConsecutives;

    // Cargar catálogo de naturalezas de descuento y refrescar los selectores ya creados.
    loadDiscountNatures().then(refreshNatureSelectors);
    // Cargar catálogo de tipos de impuesto y refrescar los selectores ya creados.
    loadTaxTypes().then(refreshTaxTypeSelectors);
    // Cargar catálogo de códigos de tarifa del IVA (para el modal de impuesto).
    loadTaxRates();
    // Cargar catálogo de tipos de documento de exoneración (para el modal de impuesto).
    loadExonAuthTypes();
    loadExonInstitutions();

    // El detalle de líneas inicia vacío: el usuario debe agregar líneas
    // manualmente con "Seleccionar Ítem" / "Agregar línea".
    // (Las precargas de NC/duplicado agregan sus propias líneas más abajo.)

    // Estado inicial: ocultar receptor si el tipo por defecto fuese TE.
    toggleReceptor();

    // ---------------- Precarga de Nota de Crédito desde la lista ----------------
    // Si la URL trae ?ncFrom=... la pantalla se abre lista para emitir una NC
    // referenciando el documento origen (clave, tipo y fecha) y precargando
    // exactamente las mismas líneas de la factura a reversar.
    (async function prefillNoteCredit() {
        // Asegurar que el selector esté poblado desde el catálogo antes de precargar.
        await loadDocumentTypes();
        await loadSaleConditions();
        await loadPaymentMethods();
        toggleReceptor();

        const qp = new URLSearchParams(window.location.search);
        const refClave = qp.get('refClave');
        const ncFrom = qp.get('ncFrom');
        const ndFrom = qp.get('ndFrom');
        const repFrom = qp.get('repFrom');
        if (!refClave) return;

        // REP (10) documenta el pago de una FE/FEC a crédito.
        // ND (02) referencia una NC; NC (03) referencia una factura.
        const isRep = !!repFrom;
        const isNd = !!ndFrom;
        const targetType = isRep ? '10' : (isNd ? '02' : '03');
        const sourceId = repFrom || ndFrom || ncFrom;
        const docLabel = isRep ? 'Recibo Electrónico de Pago' : (isNd ? 'Nota de Débito' : 'Nota de Crédito');
        const sourceLabel = isRep ? 'factura a crédito' : (isNd ? 'Nota de Crédito' : 'factura');

        // Seleccionar tipo de documento y mostrar la tarjeta de referencia
        const dtSel = document.getElementById('documentType');
        dtSel.value = targetType;
        toggleReference();
        // La reversa/REP solo puede referenciar un documento existente: bloquear el cambio de tipo
        dtSel.setAttribute('disabled', 'disabled');

        // Precargar los datos de la referencia
        document.getElementById('refClave').value = refClave;
        const refType = qp.get('refType');
        if (refType) document.getElementById('refDocType').value = refType;
        const refDate = qp.get('refDate');
        if (refDate) document.getElementById('refDate').value = refDate;
        // Código por defecto: REP → 12 (Comprobante de pago); reversa → 01 (Anula documento)
        document.getElementById('refCode').value = isRep ? '12' : '01';
        document.getElementById('refReason').value = isRep
            ? 'Pago de factura a crédito'
            : (isNd ? 'Ajuste por Nota de Débito' : 'Anulación de documento');

        const result = document.getElementById('emitResult');

        // Cargar las líneas del documento origen y precargarlas bloqueadas
        let loadedLines = 0;
        if (sourceId) {
            try {
                const r = await emitFetch(`/api/electronicinvoice/${sourceId}`);
                if (r.ok) {
                    const doc = await r.json();

                    // Auto-seleccionar el emisor y receptor del documento origen.
                    // La reversa (NC/ND) DEBE emitirse con el mismo emisor del documento
                    // original; el backend lo valida. Se buscan por número de identificación.
                    const emisor = doc.emisor || doc.Emisor;
                    const receptor = doc.receptor || doc.Receptor;
                    // IDs directos de catálogo persistidos en el documento origen. Son la
                    // fuente más confiable: evitan depender de que el receptor siga
                    // existiendo/coincida en el catálogo de proveedores por identificación.
                    const idIssuerDirect   = doc.idCustomerIssuer   ?? doc.IdCustomerIssuer;
                    const idReceptorDirect = doc.idCustomerReceptor ?? doc.IdCustomerReceptor;

                    // Emisor: intentar ID directo; si no, buscar por identificación.
                    if (idIssuerDirect) {
                        setParty('issuer', idIssuerDirect, emisor);
                    } else if (emisor) {
                        const idNum = emisor.identificacionNumero ?? emisor.IdentificacionNumero;
                        if (idNum) await autoSelectParty('issuer', idNum);
                    }

                    // Receptor: intentar ID directo; si no, buscar por identificación.
                    // Nota: el REP/NC no lleva receptor solo cuando es TE (04), que no aplica aquí.
                    if (idReceptorDirect) {
                        setParty('receptor', idReceptorDirect, receptor);
                    } else if (receptor) {
                        const idNum = receptor.identificacionNumero ?? receptor.IdentificacionNumero;
                        if (idNum) await autoSelectParty('receptor', idNum);
                    }

                    // Precargar condiciones comerciales del documento origen para que el
                    // usuario solo tenga que ingresar/ajustar lo propio del recibo.
                    const srcCurrency = doc.currency ?? doc.Currency;
                    if (srcCurrency) {
                        const curSel = document.getElementById('currency');
                        if (curSel && [...curSel.options].some(o => o.value === srcCurrency)) {
                            curSel.value = srcCurrency;
                        }
                    }
                    const srcSaleCond = doc.saleCondition ?? doc.SaleCondition;
                    if (srcSaleCond) {
                        const scSel = document.getElementById('saleCondition');
                        // Un REP documenta el PAGO: la condición efectiva es Contado (01).
                        // Para NC/ND se conserva la condición del documento origen.
                        const valToSet = isRep ? '01' : srcSaleCond;
                        if (scSel && [...scSel.options].some(o => o.value === valToSet)) {
                            scSel.value = valToSet;
                            scSel.dispatchEvent(new Event('change'));
                        }
                    }

                    const srcLines = (doc.lines || doc.Lines || []);
                    if (srcLines.length) {
                        // Vaciar la línea vacía inicial
                        document.getElementById('linesBody').innerHTML = '';
                        for (const l of srcLines) {
                            // El backend persiste TaxRateIva como FRACCIÓN (0.13). El campo
                            // '.rate' de la pantalla trabaja en PORCENTAJE (13). Normalizamos:
                            // si el valor viene <= 1 se asume fracción y se multiplica por 100.
                            let rate = (l.taxRateIva ?? l.TaxRateIva);
                            if (rate == null) rate = 13;
                            else if (rate <= 1) rate = rate * 100;

                            // Para una N/C (reversa) precargamos la cantidad DISPONIBLE
                            // (original − lo ya acreditado por N/C previas). Para un REP
                            // precargamos el saldo PENDIENTE de pago (original − REP previos).
                            // Si una línea ya fue totalmente acreditada/pagada, se omite.
                            const fullQty = l.quantity ?? l.Quantity;
                            let qty = fullQty;
                            if (isRep) {
                                const availRep = (l.availableQuantityRep ?? l.AvailableQuantityRep);
                                qty = (availRep == null) ? fullQty : availRep;
                                if (qty <= 0) continue; // línea sin saldo por pagar → no precargar
                            } else {
                                const avail = (l.availableQuantity ?? l.AvailableQuantity);
                                qty = (avail == null) ? fullQty : avail;
                                if (qty <= 0) continue; // línea sin saldo disponible → no precargar
                            }

                            addLine({
                                cabys: l.cabysCode ?? l.CabysCode,
                                itemCode: l.itemCode ?? l.ItemCode ?? '',
                                manualCabys: true,
                                detail: l.detail ?? l.Detail,
                                quantity: qty,
                                unitPrice: l.unitPrice ?? l.UnitPrice,
                                taxRate: rate,
                                taxTypeId: l.idElectronicDocumentTaxType ?? l.IdElectronicDocumentTaxType ?? 1,
                                discount: l.discountAmount ?? l.DiscountAmount ?? 0,
                                nature: l.discountNature ?? l.DiscountNature ?? '',
                                locked: true
                            });
                            loadedLines++;
                        }
                        recalc();
                    }
                }
            } catch (e) {
                console.error('[Reversa] No se pudieron cargar las líneas del documento origen:', e);
            }
        }

        // Bloquear "Agregar línea": en una reversa/REP no se pueden inventar líneas nuevas.
        // El REP documenta el pago de la factura referenciada; sus líneas provienen de ella.
        const addBtn = document.getElementById('addLineBtn');
        if (addBtn && loadedLines > 0) {
            addBtn.setAttribute('disabled', 'disabled');
            addBtn.title = isRep
                ? `En un ${docLabel} no se pueden agregar líneas que no existan en la ${sourceLabel} referenciada.`
                : `En una ${docLabel} no se pueden agregar líneas que no existan en la ${sourceLabel} a reversar.`;
            // Marcar la pantalla en modo reversa para validaciones de emisión
            window.__ncMode = true;
        }

        // Aviso visual
        if (result) {
            if (loadedLines === 0) {
                result.innerHTML = '<div class="alert alert-warning">' +
                    '<i class="bi bi-exclamation-triangle me-1"></i> ' +
                    (isRep
                        ? 'Esta ' + sourceLabel + ' ya fue <strong>pagada en su totalidad</strong> ' +
                          'por Recibos Electrónicos de Pago previos. No queda saldo pendiente para emitir otro REP.'
                        : 'Esta ' + sourceLabel + ' ya fue <strong>totalmente acreditada</strong> por Notas de Crédito previas. ' +
                          'No queda saldo disponible para emitir otra Nota de Crédito.') +
                    '</div>';
            } else {
            result.innerHTML = '<div class="alert alert-info">' +
                (isRep
                    ? `<i class="bi bi-info-circle me-1"></i> <strong>${docLabel}</strong> precargado con las ` +
                      `${loadedLines} línea(s) de la ${sourceLabel} referenciada. ` +
                      `Este comprobante documenta el <strong>pago (total o parcial)</strong> de dicha factura. ` +
                      `Para un pago <strong>parcial</strong> ajuste las líneas/cantidades al monto efectivamente abonado. ` +
                      `Se emite un REP por cada abono recibido.`
                    : `<i class="bi bi-info-circle me-1"></i> <strong>${docLabel}</strong> precargada con las ` +
                      `${loadedLines} línea(s) de la ${sourceLabel} a reversar. ` +
                      `Para una reversa <strong>total</strong> deje todas las líneas; para una <strong>parcial</strong> elimine ` +
                      'las líneas que no desea reversar (debe quedar al menos una). No puede agregar ni alterar las líneas de origen.') +
                '</div>';
            }
        }
        dtSel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    })();
})();

// ── Mover modales al <body> DESPUÉS de que el DOM esté listo
//    (mismo patrón que InventoryMovements)
document.addEventListener('DOMContentLoaded', function () {
    ['issuerModal', 'receptorModal', 'itemModal', 'cabysModal', 'lineDiscountModal', 'lineTaxModal', 'otherChargeModal'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) document.body.appendChild(el);
    });

    var issuerModalEl   = document.getElementById('issuerModal');
    var receptorModalEl = document.getElementById('receptorModal');
    var itemModalEl     = document.getElementById('itemModal');
    var cabysModalEl    = document.getElementById('cabysModal');

    if (issuerModalEl)   issuerModalEl.addEventListener('shown.bs.modal',   () => window.searchIssuers());
    if (receptorModalEl) receptorModalEl.addEventListener('shown.bs.modal', () => window.searchReceptors());
    if (itemModalEl)     itemModalEl.addEventListener('shown.bs.modal',     () => window.searchItems());
    if (cabysModalEl)    cabysModalEl.addEventListener('shown.bs.modal',    () => window.searchCabys());

    // Inicializar tooltips (Bootstrap) para los botones de línea gateados por emisor.
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
    // Estado inicial: botones bloqueados hasta seleccionar emisor.
    if (window.updateLineButtonsState) window.updateLineButtonsState();

    // ── Comportamiento global de controles numéricos en /ElectronicInvoice/Emit ──
    // 1) Ningún control numérico admite valores menores a 0.
    // 2) Las flechas de subir/bajar (spinner) mueven las UNIDADES enteras, no los
    //    decimales: se fuerza step="1" en todos los inputs number (incluidos los
    //    que se generan dinámicamente por línea o dentro de los modales).
    function enforceNumericPolicy(root) {
        (root || document).querySelectorAll('input[type="number"]').forEach(function (inp) {
            if (!inp.hasAttribute('min')) inp.setAttribute('min', '0');
            inp.setAttribute('step', '1');
        });
    }
    // Aplicar a lo ya presente.
    enforceNumericPolicy(document);
    // Aplicar a lo que se agregue dinámicamente (líneas, filas de descuento…).
    var numObserver = new MutationObserver(function (muts) {
        muts.forEach(function (m) {
            m.addedNodes.forEach(function (n) {
                if (n.nodeType === 1) enforceNumericPolicy(n);
            });
        });
    });
    numObserver.observe(document.body, { childList: true, subtree: true });
    // Impedir montos negativos al digitar en cualquier control numérico (delegado).
    document.addEventListener('input', function (e) {
        var t = e.target;
        if (t && t.tagName === 'INPUT' && t.type === 'number') {
            if (parseFloat(t.value) < 0) t.value = 0;
        }
    }, true);
});
</script>
}
