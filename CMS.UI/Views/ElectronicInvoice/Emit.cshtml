@{
    ViewData["Title"] = "Emitir Comprobante Electrónico";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken   = ViewBag.ApiToken   as string ?? "";
}

@*
    ============================================================================
    VISTA: ElectronicInvoice/Emit.cshtml
    PROPÓSITO: Formulario de emisión de comprobantes electrónicos CR v4.4 con
               validadores frontend (guards): CAByS 13 díg., regex correo,
               cálculo inverso I.V.I.
    AUTOR: EAMR, BITI SOLUTIONS S.A
    ============================================================================
*@

<style>
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .ei-card { background-color: #16213e; border: 1px solid #24304f; }
    .ei-line-table th, .ei-line-table td { vertical-align: middle; }
    .cabys-valid { border-color: #16a34a !important; }
    .cabys-invalid { border-color: #dc2626 !important; }
    .ei-line-exon { background-color: rgba(234, 179, 8, 0.12) !important; }

    /* ── Modales: forzar por encima del sidebar/navbar ── */
    #issuerModal,
    #receptorModal {
        z-index: 1060 !important;
    }
    #issuerModal .modal-dialog,
    #receptorModal .modal-dialog {
        margin-top: 4rem;          /* espacio para el navbar */
        max-height: calc(100vh - 5rem);
    }
    #issuerModal .modal-content,
    #receptorModal .modal-content {
        max-height: calc(100vh - 6rem);
        display: flex;
        flex-direction: column;
    }
    #issuerModal .modal-body,
    #receptorModal .modal-body {
        overflow-y: auto;
        flex: 1 1 auto;
    }
    /* Tabla interna con scroll propio */
    #issuerModal  .table-responsive,
    #receptorModal .table-responsive {
        max-height: 55vh;
        overflow-y: auto;
    }
    /* Thead fijo dentro del scroll */
    #issuerModal  thead th,
    #receptorModal thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #1a2340;
    }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Emitir Comprobante Electrónico</h4>
        <a asp-action="Index" class="btn btn-outline-light btn-sm"><i class="bi bi-list"></i> Comprobantes</a>
    </div>

    <div class="card ei-card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Emisor</label>
                    <div class="input-group">
                        <input id="issuerDisplay" type="text" class="form-control" readonly placeholder="Click para seleccionar emisor..." />
                        <button class="btn btn-outline-info" type="button" data-bs-toggle="modal" data-bs-target="#issuerModal">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <input id="issuerId" type="hidden" />
                    <small class="form-text">Cliente/empresa en cuyo nombre se factura.</small>
                </div>
                <div class="col-md-6" id="receptorField">
                    <label class="form-label">Receptor</label>
                    <div class="input-group">
                        <input id="receptorDisplay" type="text" class="form-control" readonly placeholder="Click para seleccionar receptor..." />
                        <button class="btn btn-outline-info" type="button" data-bs-toggle="modal" data-bs-target="#receptorModal">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <input id="receptorId" type="hidden" />
                    <small class="form-text">Proveedor al que se emite la factura.</small>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-2">
                    <label class="form-label">Tipo de documento</label>
                    <select id="documentType" class="form-select">
                        <option value="01">Factura Electrónica (FE)</option>
                        <option value="04">Tiquete Electrónico (TE)</option>
                        <option value="03">Nota de Crédito (NC)</option>
                        <option value="02">Nota de Débito (ND)</option>
                        <option value="08">Factura de Compra (FEC)</option>
                        <option value="10">Recibo Electrónico de Pago (REP)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Condición venta</label>
                    <select id="saleCondition" class="form-select">
                        <option value="01">Contado</option>
                        <option value="02">Crédito</option>
                    </select>
                </div>
                <div class="col-md-2 d-none" id="creditTermWrapper">
                    <label class="form-label">Plazo crédito (días)</label>
                    <input type="number" id="creditTerm" class="form-control" min="1" max="999" value="30" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Moneda</label>
                    <select id="currency" class="form-select">
                        <option value="CRC">CRC</option>
                        <option value="USD">USD</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Referencia (NC/ND/REP) -->
    <div class="card ei-card mb-3 d-none" id="referenceCard">
        <div class="card-body">
            <h6 class="text-light"><i class="bi bi-link-45deg"></i> Referencia al documento previo (obligatorio)</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Clave del documento referenciado (50 díg.)</label>
                    <input id="refClave" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo doc. ref.</label>
                    <select id="refDocType" class="form-select">
                        <option value="01">Factura Electrónica</option>
                        <option value="02">Nota de Débito</option>
                        <option value="03">Nota de Crédito</option>
                        <option value="04">Tiquete Electrónico</option>
                        <option value="08">Factura de Compra</option>
                        <option value="10">Recibo Electrónico de Pago</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha emisión ref.</label>
                    <input id="refDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Código referencia</label>
                    <select id="refCode" class="form-select">
                        <option value="01">Anula documento</option>
                        <option value="02">Corrige monto</option>
                        <option value="04">Referencia a otro documento</option>
                        <option value="12">Comprobante de pago (REP)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Razón</label>
                    <input id="refReason" class="form-control" maxlength="180" />
                </div>
            </div>
        </div>
    </div>

    <!-- Líneas -->
    <div class="card ei-card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-light mb-0"><i class="bi bi-card-list"></i> Detalle</h6>
                <div class="d-flex gap-3 align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="docExonerated">
                        <label class="form-check-label" for="docExonerated">Documento exonerado</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="priceIncludesTax">
                        <label class="form-check-label" for="priceIncludesTax">Precios con IVA incluido (I.V.I.)</label>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-sm ei-line-table">
                    <thead>
                        <tr>
                            <th style="width:14%">CAByS (13 díg.)</th>
                            <th>Detalle</th>
                            <th style="width:8%">Cant.</th>
                            <th style="width:12%">Precio</th>
                            <th style="width:8%">IVA %</th>
                            <th style="width:10%">Descuento</th>
                            <th style="width:12%">Naturaleza desc.</th>
                            <th style="width:6%" title="Exonerar línea">Exon.</th>
                            <th style="width:10%">Total</th>
                            <th style="width:4%"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody"></tbody>
                </table>
            </div>
            <button class="btn btn-sm btn-outline-info" id="addLineBtn"><i class="bi bi-plus-lg"></i> Agregar línea</button>
            <button class="btn btn-sm btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#itemModal"><i class="bi bi-box-seam"></i> Seleccionar ítem</button>
        </div>
    </div>

    <!-- Totales -->
    <div class="card ei-card mb-3">
        <div class="card-body">
            <div class="row text-end">
                <div class="col-md-3 ms-auto">
                    <div class="d-flex justify-content-between"><span class="text-muted">Subtotal:</span><strong id="tSubtotal">0.00</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Descuentos:</span><strong id="tDiscount">0.00</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Exonerado (IVA):</span><strong id="tExonerado">0.00</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">IVA:</span><strong id="tTax">0.00</strong></div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5"><span class="text-light fw-bold">Total:</span><strong id="tTotal" class="text-info">0.00</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Datos de exoneración: visible solo cuando hay al menos una línea exonerada -->
    <div class="card ei-card mb-3 d-none" id="exonCard">
        <div class="card-body">
            <h6 class="text-light mb-3"><i class="bi bi-patch-check"></i> Datos de la exoneración</h6>
            <div class="alert alert-warning py-2 small mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Estos datos deben corresponder a la <strong>autorización de exoneración real</strong> del cliente.
                Hacienda los valida contra su registro. Los valores por defecto solo evitan errores de esquema en pruebas.
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo de documento</label>
                    <select id="exonDocType" class="form-select">
                        <option value="01">01 - Compras autorizadas por la DGT</option>
                        <option value="02">02 - Ventas exentas a diplomáticos</option>
                        <option value="03">03 - Autorizado por Ley especial</option>
                        <option value="04">04 - Exenciones DGH autorización local genérica</option>
                        <option value="05">05 - Transitorio V (servicios de ingeniería/arquitectura)</option>
                        <option value="06">06 - Transitorio IX (recolección/reciclaje)</option>
                        <option value="07">07 - Transitorio XVII (Régimen de zona franca)</option>
                        <option value="08">08 - Exoneración a Zonas Francas</option>
                        <option value="09">09 - Exoneración de servicios complementarios ZF</option>
                        <option value="10">10 - Órdenes especiales (contratación pública)</option>
                        <option value="11">11 - Exoneración Instituciones/Órganos públicos</option>
                        <option value="99" selected>99 - Otros</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de documento / autorización</label>
                    <input id="exonDocNumber" class="form-control" maxlength="40" value="0"
                           placeholder="N.º de la autorización de exoneración">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Institución que emite</label>
                    <select id="exonInstitution" class="form-select">
                        <option value="01">01 - Ministerio de Hacienda</option>
                        <option value="02">02 - Ministerio de Relaciones Exteriores y Culto</option>
                        <option value="03">03 - Ministerio de Agricultura y Ganadería</option>
                        <option value="04">04 - Ministerio de Economía, Industria y Comercio</option>
                        <option value="05">05 - Cruz Roja Costarricense</option>
                        <option value="06">06 - Benemérito Cuerpo de Bomberos de Costa Rica</option>
                        <option value="07">07 - Asociación Obras del Espíritu Santo</option>
                        <option value="08">08 - Federación Cruzada Nacional protección Ancianos (Fecrunapa)</option>
                        <option value="09">09 - Escuela de Agricultura de la Región Húmeda (EARTH)</option>
                        <option value="10">10 - Instituto Centroamericano de Administración de Empresas (INCAE)</option>
                        <option value="11">11 - Junta de Protección Social (JPS)</option>
                        <option value="12">12 - Autoridad Reguladora de los Servicios Públicos (Aresep)</option>
                        <option value="99" selected>99 - Otros</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de emisión de la exoneración</label>
                    <input id="exonDate" type="date" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Porcentaje de exoneración (%)</label>
                    <input id="exonPercent" type="number" class="form-control" min="1" max="100" step="1" value="100">
                    <small class="form-text">100 = exoneración total del IVA de la línea.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-success" id="emitBtn"><i class="bi bi-send-check"></i> Emitir y enviar a Hacienda</button>
    </div>

    <div id="emitResult" class="mt-3"></div>

    <!-- Consola de progreso estilo CMD -->
    <div id="emitConsoleCard" class="card ei-card mt-3 d-none">
        <div class="card-header d-flex align-items-center justify-content-between" style="background:#0d1117;border-bottom:1px solid #24304f;">
            <span class="text-light"><i class="bi bi-terminal me-2"></i>Consola de emisión</span>
            <span id="emitConsoleStatus" class="badge bg-secondary">En espera</span>
        </div>
        <div id="emitConsole" style="background:#0b0e14;color:#c9d1d9;font-family:'Cascadia Code','Consolas',monospace;font-size:.82rem;line-height:1.5;padding:1rem;max-height:340px;overflow-y:auto;white-space:pre-wrap;border-radius:0 0 .375rem .375rem;"></div>
    </div>
</div>

<!-- ============================= MODAL: BUSCAR EMISOR ============================= -->
<div class="modal fade" id="issuerModal" tabindex="-1" aria-labelledby="issuerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h5 class="modal-title" id="issuerModalLabel"><i class="bi bi-building"></i> Buscar Emisor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Filtros -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <input id="issuerSearchTerm" type="text" class="form-control" placeholder="Buscar por nombre, código o cédula..." />
                    </div>
                    <div class="col-md-3">
                        <select id="issuerIdentificationType" class="form-select">
                            <option value="">Todos los tipos de ID</option>
                            <option value="01">Cédula Física (01)</option>
                            <option value="02">Cédula Jurídica (02)</option>
                            <option value="03">DIMEX (03)</option>
                            <option value="04">NITE (04)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100" onclick="searchIssuers()">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>

                <!-- Error alert -->
                <div id="issuerError" class="alert alert-danger d-none" role="alert"></div>

                <!-- Resultados -->
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-dark table-hover">
                        <thead class="sticky-top">
                            <tr>
                                <th>Nombre</th>
                                <th>Cédula</th>
                                <th>Código Cliente</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Ambiente</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="issuerResults">
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    Click en "Buscar" para ver resultados
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================= MODAL: BUSCAR RECEPTOR ============================= -->
<div class="modal fade" id="receptorModal" tabindex="-1" aria-labelledby="receptorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h5 class="modal-title" id="receptorModalLabel"><i class="bi bi-truck"></i> Buscar Receptor (Proveedor)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Filtros -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <input id="receptorSearchTerm" type="text" class="form-control" placeholder="Buscar por nombre, código o cédula..." />
                    </div>
                    <div class="col-md-3">
                        <select id="receptorIdentificationType" class="form-select">
                            <option value="">Todos los tipos de ID</option>
                            <option value="01">Cédula Física (01)</option>
                            <option value="02">Cédula Jurídica (02)</option>
                            <option value="03">DIMEX (03)</option>
                            <option value="04">NITE (04)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="receptorSupplierType" class="form-select">
                            <option value="">Todos los tipos</option>
                            <option value="Goods">Bienes</option>
                            <option value="Services">Servicios</option>
                            <option value="Both">Ambos</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100" onclick="searchReceptors()">
