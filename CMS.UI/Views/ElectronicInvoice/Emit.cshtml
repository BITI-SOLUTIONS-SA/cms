@section Scripts {
<script>
    window.EMIT_API   = '@Html.Raw(apiBaseUrl)';
    window.EMIT_TOKEN = '@Html.Raw(apiToken)';
</script>
<script>
console.log('%c✅ EMIT.CSHTML SCRIPT V3.0 CARGADO', 'background: #00ff00; color: #000; font-size: 20px; font-weight: bold;');
(function () {
    // ── Config ─────────────────────────────────────────────────────────────
    const EMIT = {
        api:   window.EMIT_API   || '',
        token: window.EMIT_TOKEN || ''
    };

    // ── Fetch helper (igual que inventoryMovements) ─────────────────────────
    async function emitFetch(path, options = {}) {
        const url  = EMIT.api + path;
        const opts = Object.assign({ headers: {} }, options);
        if (EMIT.token) opts.headers['Authorization'] = `Bearer ${EMIT.token}`;
        if (!opts.headers['Content-Type'] && opts.method !== 'GET' && opts.method !== undefined) {
            opts.headers['Content-Type'] = 'application/json';
        }
        const res = await fetch(url, opts);
        return res;
    }

    // ── Catálogo de naturalezas de descuento (admin.electronic_document_discount) ──
    let discountNatures = [];

    // ---------------- Filtrado por CAByS (impuestos / descuentos permitidos) ----------------
    // Cuando se abre el modal de descuentos o impuestos de una línea, se consulta el
    // catálogo de relaciones CAByS. Un valor null significa "sin reglas => todos permitidos".
    // Se cachea por código CAByS para evitar llamadas repetidas.
    let allowedTaxTypeIds = null;   // Set de ids de tipo de impuesto permitidos, o null.
    let allowedDiscountCodes = null; // Set de códigos de descuento permitidos, o null.
    const cabysTaxCache = {};
    const cabysDiscountCache = {};

    // Lee el código CAByS de una fila de línea (respeta CAByS manual).
    function getLineCabysCode(tr) {
        return (tr?.querySelector('.cabys')?.value || '').trim();
    }

    async function loadAllowedTaxesForCabys(code) {
        if (!code) { allowedTaxTypeIds = null; return; }
        if (cabysTaxCache[code] !== undefined) { allowedTaxTypeIds = cabysTaxCache[code]; return; }
        try {
            const res = await emitFetch(`/api/electronicdocumentcabys/by-code/${encodeURIComponent(code)}/allowed-taxes`);
            if (res.ok) {
                const list = await res.json();
                const set = (Array.isArray(list) && list.length > 0)
                    ? new Set(list.map(x => String(x.idElectronicDocumentTaxType)))
                    : null; // sin reglas => todos permitidos
                cabysTaxCache[code] = set;
                allowedTaxTypeIds = set;
                return;
            }
        } catch (e) { console.warn('No se pudieron cargar impuestos permitidos por CAByS:', e); }
        cabysTaxCache[code] = null;
        allowedTaxTypeIds = null;
    }

    async function loadAllowedDiscountsForCabys(code) {
        if (!code) { allowedDiscountCodes = null; return; }
        if (cabysDiscountCache[code] !== undefined) { allowedDiscountCodes = cabysDiscountCache[code]; return; }
        try {
            const res = await emitFetch(`/api/electronicdocumentcabys/by-code/${encodeURIComponent(code)}/allowed-discounts`);
            if (res.ok) {
                const list = await res.json();
                const set = (Array.isArray(list) && list.length > 0)
                    ? new Set(list.map(x => String(x.code)))
                    : null; // sin reglas => todos permitidos
                cabysDiscountCache[code] = set;
                allowedDiscountCodes = set;
                return;
            }
        } catch (e) { console.warn('No se pudieron cargar descuentos permitidos por CAByS:', e); }
        cabysDiscountCache[code] = null;
        allowedDiscountCodes = null;
    }

    async function loadDiscountNatures() {
        try {
            const res = await emitFetch('/api/electronicdocumentdiscount/active');
            if (res.ok) {
                discountNatures = await res.json();
            }
        } catch (e) {
            console.warn('No se pudo cargar el catálogo de descuentos:', e);
            discountNatures = [];
        }
    }

    function buildNatureOptions(selected) {
        let html = '<option value="">Código de Descuento…</option>';
        (discountNatures || []).forEach(d => {
            // Filtrado por CAByS: si hay reglas, ocultar naturalezas no permitidas
            // (salvo la que ya estuviera seleccionada, para no perder datos previos).
            if (allowedDiscountCodes && !allowedDiscountCodes.has(String(d.code))
                && String(selected) !== String(d.code)) return;
            const sel = (selected != null && String(selected) === String(d.code)) ? ' selected' : '';
            html += `<option value="${d.code}"${sel}>${d.code} - ${escapeHtmlNature(d.description)}</option>`;
        });
        return html;
    }

    function escapeHtmlNature(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    // Rellena los selectores de naturaleza ya renderizados con el catálogo cargado.
    function refreshNatureSelectors() {
        document.querySelectorAll('select.nature').forEach(sel => {
            const current = sel.value;
            sel.innerHTML = buildNatureOptions(current);
        });
    }

    // ---------------- Catálogo de tipos de impuesto (CodigoImpuesto v4.4) ----------------
    let taxTypes = [];

    async function loadTaxTypes() {
        try {
            const res = await emitFetch('/api/electronicdocumenttaxtype/active');
            if (res.ok) {
                taxTypes = await res.json();
            }
        } catch (e) {
            console.warn('No se pudo cargar el catálogo de tipos de impuesto:', e);
            taxTypes = [];
        }
    }

    // Construye las opciones del selector de tipo de impuesto (obligatorio, siempre con selección).
    function buildTaxTypeOptions(selectedId) {
        // Si no se indica selección, usa el primero (id=1 → 01 IVA) del catálogo.
        let html = '';
        const list = taxTypes || [];
        let hasSel = false;
        list.forEach(t => {
            const isSel = (selectedId != null && String(selectedId) === String(t.id));
            // Filtrado por CAByS: si hay reglas, ocultar tipos de impuesto no permitidos
            // (salvo el que ya estuviera seleccionado en esta línea).
            if (allowedTaxTypeIds && !allowedTaxTypeIds.has(String(t.id)) && !isSel) return;
            if (isSel) hasSel = true;
            html += `<option value="${t.id}"${isSel ? ' selected' : ''}>${escapeHtmlNature(t.code)} - ${escapeHtmlNature(t.description)}</option>`;
        });
        // Si nada quedó seleccionado, marca el primero por defecto.
        if (!hasSel && list.length > 0) {
            html = html.replace('<option', '<option selected');
        }
        return html;
    }

    // Rellena los selectores de tipo de impuesto ya renderizados con el catálogo cargado.
    function refreshTaxTypeSelectors() {
        document.querySelectorAll('select.taxType').forEach(sel => {
            const current = sel.dataset.selected || sel.value;
            sel.innerHTML = buildTaxTypeOptions(current);
        });
    }

    // ---------------- Catálogo de códigos de tarifa (CodigoTarifa v4.4) ----------------
    let taxRates = [];

    async function loadTaxRates() {
        try {
            const res = await emitFetch('/api/electronicdocumenttaxrate/active');
            if (res.ok) {
                taxRates = await res.json();
            }
        } catch (e) {
            console.warn('No se pudo cargar el catálogo de códigos de tarifa:', e);
            taxRates = [];
        }
    }

    // Indica si el tipo de impuesto (por id) requiere seleccionar código de tarifa.
    function taxTypeRequiresRate(taxTypeId) {
        const t = (taxTypes || []).find(x => String(x.id) === String(taxTypeId));
        return !!(t && t.requiresTaxRate);
    }

    // Construye las opciones del selector de código de tarifa.
    function buildTaxRateOptions(selectedCode) {
        let html = '<option value="">Código de la tarifa…</option>';
        (taxRates || []).forEach(r => {
            const isSel = (selectedCode != null && String(selectedCode) === String(r.code));
            html += `<option value="${r.code}" data-rate="${r.ratePercent}"${isSel ? ' selected' : ''}>${escapeHtmlNature(r.name)}</option>`;
        });
        return html;
    }

    // ---------------- Catálogo de tipos de documento de exoneración/autorización ----------------
    let exonAuthTypes = [];

    async function loadExonAuthTypes() {
        try {
            const res = await emitFetch('/api/electronicdocumentexemptionauthorizationtype/active');
            if (res.ok) {
                exonAuthTypes = await res.json();
            }
        } catch (e) {
            console.warn('No se pudo cargar el catálogo de tipos de documento de exoneración:', e);
            exonAuthTypes = [];
        }
    }

    // Construye las opciones del selector de tipo de documento de exoneración.
    function buildExonAuthTypeOptions(selectedCode) {
        let html = '<option value="">Tipo de documento de exoneración o de autorización…</option>';
        (exonAuthTypes || []).forEach(t => {
            const isSel = (selectedCode != null && String(selectedCode) === String(t.code));
            html += `<option value="${t.code}"${isSel ? ' selected' : ''}>${escapeHtmlNature(t.code)} - ${escapeHtmlNature(t.name)}</option>`;
