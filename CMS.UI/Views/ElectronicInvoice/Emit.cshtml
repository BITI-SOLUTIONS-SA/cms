    // ---------------- Emisión ----------------
    function logToConsole(step, message, level) {
        const consoleEl = document.getElementById('emitConsole');
        const ts = new Date().toLocaleTimeString('es-CR', { hour12: false });
        const colors = { INFO: '#c9d1d9', SUCCESS: '#3fb950', WARNING: '#d29922', ERROR: '#f85149' };
        const color = colors[level] || '#c9d1d9';
        const line = document.createElement('div');
        line.innerHTML = `<span style="color:#6e7681">[${ts}]</span> ` +
            `<span style="color:#58a6ff">${step.padEnd(12, ' ').replace(/ /g, '&nbsp;')}</span> ` +
            `<span style="color:${color}">${message}</span>`;
        consoleEl.appendChild(line);
        consoleEl.scrollTop = consoleEl.scrollHeight;
    }

    function setConsoleStatus(text, cls) {
        const badge = document.getElementById('emitConsoleStatus');
        badge.className = 'badge ' + cls;
        badge.textContent = text;
    }

    // Consulta el estado real en Hacienda varias veces (aceptación/rechazo es
    // asíncrono). Actualiza la consola y el badge con el desenlace final.
    async function pollHaciendaStatus(documentId) {
        const maxAttempts = 6;      // ~6 intentos
        const delayMs = 5000;       // cada 5s (total ~30s)
        setConsoleStatus('Consultando Hacienda...', 'bg-warning text-dark');
        logToConsole('CONSULTA', 'La aceptación de Hacienda es asíncrona. Consultando estado real...', 'INFO');

        for (let attempt = 1; attempt <= maxAttempts; attempt++) {
            await new Promise(res => setTimeout(res, delayMs));
            try {
                const r = await emitFetch(`/api/electronicinvoice/${documentId}/poll-status`, { method: 'POST' });
                if (!r.ok) { continue; }
                const s = await r.json();

                if (s.resolved) {
                    const accepted = /acept/i.test(s.status);
                    const lvl = accepted ? 'SUCCESS' : 'ERROR';
                    logToConsole('CONSULTA', `Hacienda resolvió el comprobante — Estado: ${s.status}. ${s.haciendaDetail || s.message || ''}`, lvl);
                    setConsoleStatus(s.status, accepted ? 'bg-success' : 'bg-danger');
                    document.getElementById('emitResult').innerHTML =
                        `<div class="alert ${accepted ? 'alert-success' : 'alert-danger'}">` +
                        `Estado final: <strong>${s.status}</strong>. ${s.haciendaDetail || s.message || ''}</div>`;
                    return;
                } else {
                    logToConsole('CONSULTA', `Intento ${attempt}/${maxAttempts}: Hacienda aún procesando...`, 'INFO');
                }
            } catch (e) {
                logToConsole('CONSULTA', `Intento ${attempt}/${maxAttempts}: no se pudo consultar (${e.message}).`, 'WARNING');
            }
        }

        // No resolvió dentro del tiempo de la consola: es normal, seguirá en background.
        logToConsole('CONSULTA', 'Hacienda continúa procesando. El sistema seguirá consultando automáticamente en segundo plano; podrá ver el resultado desde la lista de documentos (botón de bitácora).', 'WARNING');
        setConsoleStatus('Procesando (en background)', 'bg-info text-dark');
    }

    async function emit() {
        const lines = [];
        let ok = true;
        // Datos de exoneración capturados en la tarjeta (aplican a las líneas exoneradas).
        const docExonChecked = document.getElementById('docExonerated').checked;
        const exDocType = (document.getElementById('exonDocType')?.value || '99');
        const exDocNumber = (document.getElementById('exonDocNumber')?.value || '').trim() || '0';
        const exInstitution = (document.getElementById('exonInstitution')?.value || '99');
        const exDateVal = document.getElementById('exonDate')?.value;
        const exDate = exDateVal ? new Date(exDateVal + 'T00:00:00').toISOString() : new Date().toISOString();
        let exPct = parseFloat(document.getElementById('exonPercent')?.value) || 100;
        if (exPct < 1) exPct = 1; if (exPct > 100) exPct = 100;
        document.querySelectorAll('#linesBody tr').forEach(tr => {
            const cabys = tr.querySelector('.cabys').value.trim();
            if (!isValidCabys(cabys)) { tr.querySelector('.cabys').classList.add('cabys-invalid'); ok = false; return; }
            const disc = parseFloat(tr.querySelector('.disc').value) || 0;
            const nature = tr.querySelector('.nature').value;
            if (disc > 0 && !nature) { tr.querySelector('.nature').classList.add('cabys-invalid'); ok = false; return; }
            const ratePct = parseFloat(tr.querySelector('.rate').value) || 0;
            const lineExon = tr.querySelector('.exon').checked || docExonChecked;
            lines.push({
                cabysCode: cabys,
                detail: tr.querySelector('.detail').value,
                quantity: parseFloat(tr.querySelector('.qty').value) || 0,
                unitPrice: parseFloat(tr.querySelector('.price').value) || 0,
                priceIncludesTax: document.getElementById('priceIncludesTax').checked,
                taxRatePercent: ratePct,
                taxRateCode: mapTaxRateCode(ratePct),
                discountAmount: disc,
                discountNature: nature || null,
                isExonerated: lineExon,
                exonPercent: lineExon ? exPct : 0,
                exonDocumentType: lineExon ? exDocType : null,
                exonDocumentNumber: lineExon ? exDocNumber : null,
                exonInstitution: lineExon ? exInstitution : null,
                exonDate: lineExon ? exDate : null
            });
        });

        if (!ok || lines.length === 0) {
            alert('Corrija las líneas: CAByS de 13 dígitos y naturaleza de descuento son obligatorios.');
            return;
        }

        const issuerRaw = document.getElementById('issuerId').value;
        const issuerId = parseInt(issuerRaw, 10);
        if (!issuerRaw || Number.isNaN(issuerId)) {
            alert('Debe seleccionar un emisor antes de emitir el comprobante.');
            document.getElementById('issuerDisplay')?.classList.add('cabys-invalid');
            return;
        }

        const receptorRaw = document.getElementById('receptorId').value;
        // El Tiquete Electrónico (TE) no lleva receptor: forzamos null aunque hubiese
        // quedado un valor residual seleccionado antes de cambiar el tipo de documento.
        const docTypeVal = document.getElementById('documentType').value;
        const receptorId = (docTypeVal === '04')
            ? null
            : (receptorRaw ? (parseInt(receptorRaw, 10) || null) : null);

        const payload = {
            issuerId: issuerId,
            receptorId: receptorId,
            documentType: document.getElementById('documentType').value,
            saleCondition: document.getElementById('saleCondition').value,
            currency: document.getElementById('currency').value,
            isExonerated: document.getElementById('docExonerated').checked,
            lines: lines,
            references: []
        };

        // Plazo de crédito: obligatorio cuando la condición de venta es "02" (Crédito).
        // Hacienda rechaza el comprobante (error -58) si falta el nodo <PlazoCredito>.
        if (payload.saleCondition === '02') {
            const creditTerm = parseInt(document.getElementById('creditTerm').value, 10);
            if (!creditTerm || creditTerm < 1) {
                alert('Para ventas a crédito debe indicar el plazo de crédito (en días).');
                return;
            }
            payload.creditTerm = creditTerm;
        }

        if (toggleReference()) {
            const refClave = document.getElementById('refClave').value.trim();
            if (refClave.length !== 50) { alert('La clave de referencia debe tener 50 dígitos.'); return; }
            const refReason = document.getElementById('refReason').value.trim();
            if (!refReason) { alert('Debe indicar la razón de la referencia.'); return; }
            const refDateVal = document.getElementById('refDate').value;
            // Si el usuario no indicó fecha, se intenta derivar del documento referenciado
            // (posiciones 7-12 de la clave = AAMMDD); si no, se usa la fecha actual.
            let refDateIso;
            if (refDateVal) {
                refDateIso = new Date(refDateVal + 'T00:00:00').toISOString();
            } else {
                refDateIso = new Date().toISOString();
            }
            payload.references.push({
                refDocumentType: document.getElementById('refDocType').value,
                refClave: refClave,
                refDate: refDateIso,
                refCode: document.getElementById('refCode').value,
                refReason: refReason
            });
        }

        const btn = document.getElementById('emitBtn');
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Emitiendo...';

        // Mostrar consola de progreso
        const consoleCard = document.getElementById('emitConsoleCard');
        const consoleEl = document.getElementById('emitConsole');
        consoleCard.classList.remove('d-none');
        consoleEl.innerHTML = '';
        document.getElementById('emitResult').innerHTML = '';
        setConsoleStatus('Procesando...', 'bg-warning text-dark');
        logToConsole('CLIENTE', 'Enviando solicitud de emisión al servidor...', 'INFO');
        consoleCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        try {
            const r = await emitFetch('/api/electronicinvoice/emit', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
                });
            const d = await r.json();

            // Reproducir la bitácora paso a paso devuelta por el servidor
            if (d.logs && d.logs.length) {
                for (const entry of d.logs) {
                    logToConsole(entry.step, entry.message, entry.level);
                    await new Promise(res => setTimeout(res, 220));
                }
            }

            if (r.ok) {
                const statusLevel = /acept/i.test(d.status) ? 'SUCCESS'
                    : /contingencia|proces/i.test(d.status) ? 'WARNING' : 'INFO';
                logToConsole('RESULTADO', `Comprobante ${d.clave} — Estado: ${d.status}. ${d.message || ''}`, statusLevel);
                document.getElementById('emitResult').innerHTML =
                    `<div class="alert alert-success">Comprobante <strong>${d.clave}</strong> — Estado: <strong>${d.status}</strong>. ${d.message || ''}</div>`;

                // Si Hacienda quedó "Procesando", la aceptación/rechazo es asíncrona.
                // Consultamos su estado real unas cuantas veces antes de dar por
                // terminada la consola, para que el usuario vea el desenlace.
                if (/proces/i.test(d.status) && d.documentId) {
                    await pollHaciendaStatus(d.documentId);
                } else {
                    setConsoleStatus(d.status || 'Completado', statusLevel === 'SUCCESS' ? 'bg-success' : 'bg-info text-dark');
                }
            } else {
                // Extraer el mensaje de error más específico disponible en la respuesta.
                // Backend: 400 → { message }, 500 → { message, error },
                // validación de modelo → { title, errors: { campo: [msgs] } }.
                let detail = d.message || d.title || 'Error al emitir';
                if (d.error) detail += `: ${d.error}`;
                if (d.errors) {
                    const flat = Object.values(d.errors).flat();
                    if (flat.length) detail += ' — ' + flat.join(' | ');
                }
                logToConsole('ERROR', detail, 'ERROR');
                setConsoleStatus('Error', 'bg-danger');
                document.getElementById('emitResult').innerHTML =
                    `<div class="alert alert-danger">${detail}</div>`;
            }
        } catch (e) {
            const msg = (e && e.message) ? e.message : 'Error de conexión con el servidor.';
            logToConsole('ERROR', `Error de conexión: ${msg}`, 'ERROR');
            setConsoleStatus('Error', 'bg-danger');
            document.getElementById('emitResult').innerHTML =
                `<div class="alert alert-danger">Error de conexión: ${msg}</div>`;
        } finally {
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-send-check"></i> Emitir y enviar a Hacienda';
        }
    }

    // ---------------- Init ----------------
    // ── Exponer en window para que los onclick del HTML los encuentren
    //    (los modales se mueven al <body> con appendChild, por lo que
    //     los atributos onclick necesitan alcance global)
    window.searchIssuers   = searchIssuers;
    window.searchReceptors = searchReceptors;

    document.getElementById('addLineBtn').addEventListener('click', () => addLine());
    document.getElementById('priceIncludesTax').addEventListener('change', recalc);
    document.getElementById('docExonerated').addEventListener('change', recalc);
    document.getElementById('exonPercent')?.addEventListener('input', recalc);
    document.getElementById('documentType').addEventListener('change', toggleReference);
    document.getElementById('emitBtn').addEventListener('click', emit);

    // Muestra/oculta el plazo de crédito según la condición de venta (obligatorio para "02").
    function toggleCreditTerm() {
        const isCredit = document.getElementById('saleCondition').value === '02';
        document.getElementById('creditTermWrapper').classList.toggle('d-none', !isCredit);
    }
    document.getElementById('saleCondition').addEventListener('change', toggleCreditTerm);
    toggleCreditTerm();

    addLine();

    // Estado inicial: ocultar receptor si el tipo por defecto fuese TE.
    toggleReceptor();

    // ---------------- Precarga de Nota de Crédito desde la lista ----------------
    // Si la URL trae ?ncFrom=... la pantalla se abre lista para emitir una NC
    // referenciando el documento origen (clave, tipo y fecha) y precargando
    // exactamente las mismas líneas de la factura a reversar.
    (async function prefillNoteCredit() {
        const qp = new URLSearchParams(window.location.search);
        const refClave = qp.get('refClave');
        const ncFrom = qp.get('ncFrom');
        const ndFrom = qp.get('ndFrom');
        const repFrom = qp.get('repFrom');
        if (!refClave) return;

        // REP (10) documenta el pago de una FE/FEC a crédito.
        // ND (02) referencia una NC; NC (03) referencia una factura.
        const isRep = !!repFrom;
        const isNd = !!ndFrom;
        const targetType = isRep ? '10' : (isNd ? '02' : '03');
        const sourceId = repFrom || ndFrom || ncFrom;
        const docLabel = isRep ? 'Recibo Electrónico de Pago' : (isNd ? 'Nota de Débito' : 'Nota de Crédito');
        const sourceLabel = isRep ? 'factura a crédito' : (isNd ? 'Nota de Crédito' : 'factura');

        // Seleccionar tipo de documento y mostrar la tarjeta de referencia
        const dtSel = document.getElementById('documentType');
        dtSel.value = targetType;
        toggleReference();
        // La reversa/REP solo puede referenciar un documento existente: bloquear el cambio de tipo
        dtSel.setAttribute('disabled', 'disabled');

        // Precargar los datos de la referencia
        document.getElementById('refClave').value = refClave;
        const refType = qp.get('refType');
        if (refType) document.getElementById('refDocType').value = refType;
        const refDate = qp.get('refDate');
        if (refDate) document.getElementById('refDate').value = refDate;
        // Código por defecto: REP → 12 (Comprobante de pago); reversa → 01 (Anula documento)
        document.getElementById('refCode').value = isRep ? '12' : '01';
        document.getElementById('refReason').value = isRep
            ? 'Pago de factura a crédito'
            : (isNd ? 'Ajuste por Nota de Débito' : 'Anulación de documento');

        const result = document.getElementById('emitResult');

        // Cargar las líneas del documento origen y precargarlas bloqueadas
        let loadedLines = 0;
        if (sourceId) {
            try {
                const r = await emitFetch(`/api/electronicinvoice/${sourceId}`);
                if (r.ok) {
                    const doc = await r.json();

                    // Auto-seleccionar el emisor y receptor del documento origen.
                    // La reversa (NC/ND) DEBE emitirse con el mismo emisor del documento
                    // original; el backend lo valida. Se buscan por número de identificación.
                    const emisor = doc.emisor || doc.Emisor;
                    const receptor = doc.receptor || doc.Receptor;
                    // IDs directos de catálogo persistidos en el documento origen. Son la
                    // fuente más confiable: evitan depender de que el receptor siga
                    // existiendo/coincida en el catálogo de proveedores por identificación.
                    const idIssuerDirect   = doc.idCustomerIssuer   ?? doc.IdCustomerIssuer;
                    const idReceptorDirect = doc.idCustomerReceptor ?? doc.IdCustomerReceptor;

                    // Emisor: intentar ID directo; si no, buscar por identificación.
                    if (idIssuerDirect) {
                        setParty('issuer', idIssuerDirect, emisor);
                    } else if (emisor) {
                        const idNum = emisor.identificacionNumero ?? emisor.IdentificacionNumero;
                        if (idNum) await autoSelectParty('issuer', idNum);
                    }

                    // Receptor: intentar ID directo; si no, buscar por identificación.
                    // Nota: el REP/NC no lleva receptor solo cuando es TE (04), que no aplica aquí.
                    if (idReceptorDirect) {
                        setParty('receptor', idReceptorDirect, receptor);
                    } else if (receptor) {
                        const idNum = receptor.identificacionNumero ?? receptor.IdentificacionNumero;
                        if (idNum) await autoSelectParty('receptor', idNum);
                    }

                    // Precargar condiciones comerciales del documento origen para que el
                    // usuario solo tenga que ingresar/ajustar lo propio del recibo.
                    const srcCurrency = doc.currency ?? doc.Currency;
                    if (srcCurrency) {
                        const curSel = document.getElementById('currency');
                        if (curSel && [...curSel.options].some(o => o.value === srcCurrency)) {
                            curSel.value = srcCurrency;
                        }
                    }
                    const srcSaleCond = doc.saleCondition ?? doc.SaleCondition;
                    if (srcSaleCond) {
                        const scSel = document.getElementById('saleCondition');
                        // Un REP documenta el PAGO: la condición efectiva es Contado (01).
                        // Para NC/ND se conserva la condición del documento origen.
                        const valToSet = isRep ? '01' : srcSaleCond;
                        if (scSel && [...scSel.options].some(o => o.value === valToSet)) {
                            scSel.value = valToSet;
                            scSel.dispatchEvent(new Event('change'));
                        }
                    }

                    const srcLines = (doc.lines || doc.Lines || []);
                    if (srcLines.length) {
                        // Vaciar la línea vacía inicial
                        document.getElementById('linesBody').innerHTML = '';
                        for (const l of srcLines) {
                            // El backend persiste TaxRateIva como FRACCIÓN (0.13). El campo
                            // '.rate' de la pantalla trabaja en PORCENTAJE (13). Normalizamos:
                            // si el valor viene <= 1 se asume fracción y se multiplica por 100.
                            let rate = (l.taxRateIva ?? l.TaxRateIva);
                            if (rate == null) rate = 13;
                            else if (rate <= 1) rate = rate * 100;

                            // Para una N/C (reversa) precargamos la cantidad DISPONIBLE
                            // (original − lo ya acreditado por N/C previas). Para un REP
                            // precargamos el saldo PENDIENTE de pago (original − REP previos).
                            // Si una línea ya fue totalmente acreditada/pagada, se omite.
                            const fullQty = l.quantity ?? l.Quantity;
                            let qty = fullQty;
                            if (isRep) {
                                const availRep = (l.availableQuantityRep ?? l.AvailableQuantityRep);
                                qty = (availRep == null) ? fullQty : availRep;
                                if (qty <= 0) continue; // línea sin saldo por pagar → no precargar
                            } else {
                                const avail = (l.availableQuantity ?? l.AvailableQuantity);
                                qty = (avail == null) ? fullQty : avail;
                                if (qty <= 0) continue; // línea sin saldo disponible → no precargar
                            }

                            addLine({
                                cabys: l.cabysCode ?? l.CabysCode,
                                detail: l.detail ?? l.Detail,
                                quantity: qty,
                                unitPrice: l.unitPrice ?? l.UnitPrice,
                                taxRate: rate,
                                discount: l.discountAmount ?? l.DiscountAmount ?? 0,
                                nature: l.discountNature ?? l.DiscountNature ?? '',
                                locked: true
                            });
                            loadedLines++;
                        }
                        recalc();
                    }
                }
            } catch (e) {
                console.error('[Reversa] No se pudieron cargar las líneas del documento origen:', e);
            }
        }

        // Bloquear "Agregar línea": en una reversa/REP no se pueden inventar líneas nuevas.
        // El REP documenta el pago de la factura referenciada; sus líneas provienen de ella.
        const addBtn = document.getElementById('addLineBtn');
        if (addBtn && loadedLines > 0) {
            addBtn.setAttribute('disabled', 'disabled');
            addBtn.title = isRep
                ? `En un ${docLabel} no se pueden agregar líneas que no existan en la ${sourceLabel} referenciada.`
                : `En una ${docLabel} no se pueden agregar líneas que no existan en la ${sourceLabel} a reversar.`;
            // Marcar la pantalla en modo reversa para validaciones de emisión
            window.__ncMode = true;
        }

        // Aviso visual
        if (result) {
            if (loadedLines === 0) {
                result.innerHTML = '<div class="alert alert-warning">' +
                    '<i class="bi bi-exclamation-triangle me-1"></i> ' +
                    (isRep
                        ? 'Esta ' + sourceLabel + ' ya fue <strong>pagada en su totalidad</strong> ' +
                          'por Recibos Electrónicos de Pago previos. No queda saldo pendiente para emitir otro REP.'
                        : 'Esta ' + sourceLabel + ' ya fue <strong>totalmente acreditada</strong> por Notas de Crédito previas. ' +
                          'No queda saldo disponible para emitir otra Nota de Crédito.') +
                    '</div>';
            } else {
            result.innerHTML = '<div class="alert alert-info">' +
                (isRep
                    ? `<i class="bi bi-info-circle me-1"></i> <strong>${docLabel}</strong> precargado con las ` +
                      `${loadedLines} línea(s) de la ${sourceLabel} referenciada. ` +
                      `Este comprobante documenta el <strong>pago (total o parcial)</strong> de dicha factura. ` +
                      `Para un pago <strong>parcial</strong> ajuste las líneas/cantidades al monto efectivamente abonado. ` +
                      `Se emite un REP por cada abono recibido.`
                    : `<i class="bi bi-info-circle me-1"></i> <strong>${docLabel}</strong> precargada con las ` +
                      `${loadedLines} línea(s) de la ${sourceLabel} a reversar. ` +
                      `Para una reversa <strong>total</strong> deje todas las líneas; para una <strong>parcial</strong> elimine ` +
                      'las líneas que no desea reversar (debe quedar al menos una). No puede agregar ni alterar las líneas de origen.') +
                '</div>';
            }
        }
        dtSel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    })();
})();

// ── Mover modales al <body> DESPUÉS de que el DOM esté listo
//    (mismo patrón que InventoryMovements)
document.addEventListener('DOMContentLoaded', function () {
    ['issuerModal', 'receptorModal', 'itemModal'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) document.body.appendChild(el);
    });

    var issuerModalEl   = document.getElementById('issuerModal');
    var receptorModalEl = document.getElementById('receptorModal');
    var itemModalEl     = document.getElementById('itemModal');

    if (issuerModalEl)   issuerModalEl.addEventListener('shown.bs.modal',   () => window.searchIssuers());
    if (receptorModalEl) receptorModalEl.addEventListener('shown.bs.modal', () => window.searchReceptors());
    if (itemModalEl)     itemModalEl.addEventListener('shown.bs.modal',     () => window.searchItems());
});
</script>
}
