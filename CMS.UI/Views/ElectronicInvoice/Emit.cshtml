    // ---------------- Actividades económicas (emisor / receptor) ----------------
    // Emisor: se resuelven las actividades del cliente asociado a la credencial del emisor.
    async function loadIssuerActivities(issuerCredentialId) {
        const sel = document.getElementById('issuerActivityCode');
        if (!sel) return;
        if (!issuerCredentialId) {
            sel.innerHTML = '<option value="">Seleccione un emisor...</option>';
            return;
        }
        sel.innerHTML = '<option value="">Cargando...</option>';
        try {
            const r = await emitFetch('/api/customereconomicactivity/for-emit-issuer/' + issuerCredentialId);
            const list = r.ok ? await r.json() : [];
            fillActivitySelect(sel, list, 'Sin actividades registradas');
        } catch (e) {
            console.error(e);
            sel.innerHTML = '<option value="">(error)</option>';
        }
    }
    window.loadIssuerActivities = loadIssuerActivities;

    // Receptor: se cargan las actividades económicas asignadas al cliente (receptor).
    // Si el cliente no tiene actividades asignadas, se ofrece el catálogo central como respaldo.
    async function loadReceptorActivities(customerId) {
        const sel = document.getElementById('receptorActivityCode');
        if (!sel) return;

        // Resolver el id del cliente: parámetro explícito o el receptor seleccionado.
        if (customerId === undefined || customerId === null || customerId === '') {
            customerId = document.getElementById('receptorId')?.value || '';
        }

        sel.innerHTML = '<option value="">Cargando...</option>';
        try {
            let mapped = [];

            // Catálogo central: mapa código -> descripción (para completar descripciones faltantes).
            let catalogMap = {};
            try {
                const rc = await emitFetch('/api/electronicdocumenteconomicactivity/active');
                const catalog = rc.ok ? await rc.json() : [];
                (catalog || []).forEach(a => { if (a.code) catalogMap[a.code] = a.description; });
            } catch (e) { console.warn('No se pudo cargar el catálogo central de actividades', e); }

            if (customerId) {
                const rv = await emitFetch('/api/customereconomicactivity/for-emit/' + customerId);
                const activities = rv.ok ? await rv.json() : [];
                mapped = (activities || [])
                    .map(a => ({
                        code: a.code,
                        description: a.description || catalogMap[a.code] || '',
                        isDefault: !!a.isDefault
                    }));
            }

            // Respaldo: catálogo central si el cliente no tiene actividades asignadas.
            if (mapped.length === 0) {
                mapped = Object.keys(catalogMap).map(code => ({ code: code, description: catalogMap[code], isDefault: false }));
                fillActivitySelect(sel, mapped, 'Sin actividades en el catálogo');
                return;
            }

            fillActivitySelect(sel, mapped, 'Sin actividades registradas');
        } catch (e) {
            console.error(e);
            sel.innerHTML = '<option value="">(error)</option>';
        }
    }
    window.loadReceptorActivities = loadReceptorActivities;

    function fillActivitySelect(sel, list, emptyMsg) {
        if (!list || list.length === 0) {
            sel.innerHTML = `<option value="">${emptyMsg}</option>`;
            return;
        }
        sel.innerHTML = list.map(a =>
            `<option value="${escapeHtml(a.code)}" ${a.isDefault ? 'selected' : ''}>${escapeHtml(a.code)}${a.description ? ' — ' + escapeHtml(a.description) : ''}</option>`
        ).join('');
        // Si ninguno viene marcado como default, seleccionar el primero.
        if (!list.some(a => a.isDefault)) sel.selectedIndex = 0;
    }

