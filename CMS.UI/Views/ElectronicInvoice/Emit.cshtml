@* ── Modal Impuesto de línea ── *@
<div class="modal fade" id="lineTaxModal" tabindex="-1" aria-labelledby="lineTaxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header d-flex align-items-center">
                <h5 class="modal-title me-auto" id="lineTaxModalLabel">Impuesto</h5>
                <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3 me-2" id="ltmAddTaxBtn" onclick="ltmAddTax()">
                    <i class="bi bi-plus-lg"></i> Añadir impuesto
                </button>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- ═══════════ VISTA LISTA: tarjetas de impuestos ═══════════ -->
                <div id="ltmListView">
                    <div id="ltmCardList"></div>
                    <div id="ltmEmptyHint" class="text-center py-4 d-none" style="color:#cbd5e1">
                        No hay impuestos en esta línea. Use <strong>Añadir impuesto</strong> para agregar uno.
                    </div>
                    <!-- Resumen de totales de la línea -->
                    <div class="ltm-summary rounded p-3 mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-light">Impuestos</span>
                            <span id="ltmSumTax" class="text-light">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-light">Impuestos asumidos por el Emisor o cobrado a nivel de fábrica</span>
                            <span id="ltmSumAsumido" class="text-light">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-light">Impuestos exonerados</span>
                            <span id="ltmSumExon" class="text-warning">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold border-top border-secondary pt-2 mt-1">
                            <span class="text-light">Impuestos netos</span>
                            <span id="ltmSumNet" class="text-light">0.00</span>
                        </div>
                    </div>
                </div>

                <!-- ═══════════ VISTA EDITOR: alta/edición de un impuesto ═══════════ -->
                <div id="ltmEditorView" class="d-none">
                    <div class="mb-3">
                        <label class="form-label small" for="ltmTaxType">Código del impuesto</label>
                        <select id="ltmTaxType" class="form-select" onchange="onTaxTypeChange()"></select>
                    </div>
                    <div class="mb-3 d-none" id="ltmTaxRateGroup">
                        <label class="form-label small" for="ltmTaxRate">Código de la tarifa</label>
                        <select id="ltmTaxRate" class="form-select" onchange="onTaxRateChange()"></select>
                    </div>
                    <div class="mb-2" id="ltmRateRow">
                        <label class="form-label small" for="ltmRate">Tarifa (%)</label>
                        <input id="ltmRate" type="number" class="form-control text-end" min="0" step="1" value="13" placeholder="13" oninput="recalcTaxModal()">
                    </div>
                    <!-- ── Impuesto por MONTO (solo código 02 - selectivo de consumo) ── -->
                    <div class="mb-2 d-none" id="ltmByAmountRow">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ltmByAmount" onchange="onByAmountChange()">
                            <label class="form-check-label small" for="ltmByAmount">Indicar el <strong>monto</strong> del impuesto (el sistema calcula la tarifa)</label>
                        </div>
                    </div>
                    <div class="mb-2 d-none" id="ltmAmountGroup">
                        <label class="form-label small" for="ltmTaxAmount">Monto del impuesto</label>
                        <input id="ltmTaxAmount" type="number" class="form-control text-end" min="0" step="0.01" value="0" placeholder="0.00" oninput="onTaxAmountChange()">
                        <small class="form-text">Debe ser mayor a 0. La tarifa se calcula automáticamente sobre la base imponible.</small>
                    </div>

                    <!-- ═══ Código 03 - Impuesto único a los combustibles ═══ -->
                    <div class="d-none" id="ltmSpec03">
                        <div class="mb-2">
                            <label class="form-label small" for="ltm03Qty">Cantidad de la unidad de medida a utilizar</label>
                            <input id="ltm03Qty" type="number" class="form-control text-end" min="0" step="0.01" value="1" oninput="onSpecificTaxChange()">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm03PerUnit">Impuesto por unidad</label>
                            <input id="ltm03PerUnit" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                        </div>
                    </div>

                    <!-- ═══ Código 04 - Impuesto específico de bebidas alcohólicas ═══ -->
                    <div class="d-none" id="ltmSpec04">
                        <div class="mb-2">
                            <label class="form-label small" for="ltm04Qty">Cantidad</label>
                            <input id="ltm04Qty" type="number" class="form-control text-end" value="1" readonly>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm04UnitQty">Cantidad de la unidad de medida a utilizar</label>
                            <input id="ltm04UnitQty" type="number" class="form-control text-end" min="0" step="0.01" value="1" oninput="onSpecificTaxChange()">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm04Percent">Porcentaje (%)</label>
                            <input id="ltm04Percent" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm04Prop">Proporción</label>
                            <input id="ltm04Prop" type="text" class="form-control text-end" value="—" readonly>
                            <small class="form-text">Proporción = Cantidad de unidad de medida × Porcentaje ÷ 100.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm04PerUnit">Impuesto por unidad</label>
                            <input id="ltm04PerUnit" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                        </div>
                    </div>

                    <!-- ═══ Código 05 - Impuesto específico bebidas envasadas sin contenido alcohólico ═══ -->
                    <div class="d-none" id="ltmSpec05">
                        <div class="mb-2">
                            <label class="form-label small" for="ltm05Qty">Cantidad</label>
                            <input id="ltm05Qty" type="number" class="form-control text-end" value="1" readonly>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm05Volume">Volumen por unidad de consumo</label>
                            <input id="ltm05Volume" type="number" class="form-control text-end" min="0" step="0.01" value="1" oninput="onSpecificTaxChange()">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm05PerUnit">Impuesto por unidad</label>
                            <input id="ltm05PerUnit" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                        </div>
                    </div>

                    <!-- ═══ Código 06 - Impuesto a los productos de tabaco ═══ -->
                    <div class="d-none" id="ltmSpec06">
                        <div class="mb-2">
                            <label class="form-label small" for="ltm06Qty">Cantidad</label>
                            <input id="ltm06Qty" type="number" class="form-control text-end" value="1" readonly>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm06UnitQty">Cantidad de la unidad de medida a utilizar</label>
                            <input id="ltm06UnitQty" type="number" class="form-control text-end" min="0" step="0.01" value="1" oninput="onSpecificTaxChange()">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm06PerUnit">Impuesto por unidad</label>
                            <input id="ltm06PerUnit" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                        </div>
                    </div>

                    <!-- ═══ Código 07 - IVA (cálculo especial): base imponible especial + impuesto de fábrica ═══ -->
                    <div class="d-none" id="ltmSpec07">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="ltm07Factory" onchange="onSpecificTaxChange()">
                            <label class="form-check-label small" for="ltm07Factory">Este producto tiene impuesto cobrado a nivel de fábrica</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="ltm07Base">Base imponible especial</label>
                            <input id="ltm07Base" type="number" class="form-control text-end" min="0" step="0.01" value="0" oninput="onSpecificTaxChange()">
                            <small class="form-text">Monto sobre el que se calcula el IVA en el régimen especial. El impuesto = Base imponible especial × Tarifa ÷ 100.</small>
                        </div>
                    </div>

                    <!-- ═══ Código 99 - Otros: descripción libre del impuesto ═══ -->
                    <div class="d-none" id="ltmSpec99">
                        <div class="mb-2">
                            <label class="form-label small" for="ltm99Desc">Descripción del impuesto</label>
                            <input id="ltm99Desc" type="text" class="form-control" maxlength="160" placeholder="Descripción del impuesto" oninput="onSpecificTaxChange()">
                        </div>
                    </div>

                    <!-- Resumen del monto calculado para impuestos específicos (03/04/05) -->
                    <div class="d-none" id="ltmSpecCalc">
                        <div class="d-flex justify-content-between small border-top border-secondary pt-2 mt-1">
                            <span class="text-light" id="ltmSpecFormula">Monto del impuesto</span>
