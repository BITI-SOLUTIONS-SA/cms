    // Valida el número de identificación del tercero según el tipo seleccionado.
    // Los tres campos del tercero son OPCIONALES; solo se valida el número si se
    // ingresó junto con un tipo. Devuelve true si es válido (o si está vacío).
    function validateThirdIdentification() {
        const errEl = document.getElementById('ocgIdentError');
        const typeCode = document.getElementById('ocgIdentType')?.value || '';
        const number = (document.getElementById('ocgIdentification')?.value || '').trim();
        const showError = (msg) => {
            if (!errEl) return;
            errEl.textContent = msg; errEl.classList.remove('d-none');
        };
        if (errEl) { errEl.classList.add('d-none'); errEl.textContent = ''; }
        if (!number) return true;               // sin número: válido (opcional)
        if (!typeCode) { showError('Seleccione el tipo de identificación para validar el número.'); return false; }
        const opt = document.getElementById('ocgIdentType')?.selectedOptions?.[0];
        // Reglas por tipo (Hacienda CR): 01=9, 02=10, 03=11-12, 04=10, 05/06<=20.
        const rules = { '01': [9, 9], '02': [10, 10], '03': [11, 12], '04': [10, 10] };
        if (rules[typeCode]) {
            const [min, max] = rules[typeCode];
            if (!/^[0-9]+$/.test(number)) { showError('El número debe contener solo dígitos.'); return false; }
            if (number.length < min || number.length > max) {
                showError(min === max ? `Debe tener ${min} dígitos.` : `Debe tener entre ${min} y ${max} dígitos.`);
                return false;
            }
        } else if (number.length > 20) {
            showError('No puede exceder 20 caracteres.'); return false;
        }
        return true;
    }

    async function openOtherChargeModal() {
        otherChargeEditIndex = -1; // Nueva captura (no edición).
        await Promise.all([loadOtherChargesCatalog(), loadIdentificationTypes()]);
        // Limpiar el formulario para una nueva captura.
        document.getElementById('ocgOtherType').value = '';
        document.getElementById('ocgDetail').value = '';
        document.getElementById('ocgAmount').value = '';
        document.getElementById('ocgIdentType').value = '';
        document.getElementById('ocgIdentification').value = '';
        document.getElementById('ocgThirdName').value = '';
        document.getElementById('ocgIdentError')?.classList.add('d-none');
        onOtherChargeTypeChange();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('otherChargeModal')).show();
    }

    function addOtherChargeFromModal() {
        const sel = document.getElementById('ocgType');
        const opt = sel?.selectedOptions?.[0];
        if (!opt) { alert('Seleccione el tipo de documento de otros cargos.'); return; }
        const typeCode = opt.dataset.code || '';
        const detail = document.getElementById('ocgDetail').value.trim();
        const amount = parseFloat(document.getElementById('ocgAmount').value) || 0;
        const otherType = document.getElementById('ocgOtherType').value.trim();
        if (amount <= 0) { alert('Indique el monto del cargo (mayor a 0).'); return; }
        if (!detail) { alert('Indique el detalle de otros cargos.'); return; }
        if (typeCode === '99' && !otherType) { alert('Indique la descripción del otro tipo de documento.'); return; }
        if (!validateThirdIdentification()) return;

        // Etiquetas legibles para la tabla (documento y tipo de identificación).
        const docLabel = (ocgCatalog.find(x => String(x.id) === opt.value)?.description) || typeCode;
        const identTypeOpt = document.getElementById('ocgIdentType')?.selectedOptions?.[0];
        const identTypeLabel = identTypeOpt && identTypeOpt.value ? identTypeOpt.textContent.trim() : '';

        const charge = {
            typeId: parseInt(opt.value, 10),
            typeCode: typeCode,
            docLabel: docLabel,
            otherTypeDescription: typeCode === '99' ? otherType : '',
            detail: detail,
            amount: amount,
            percent: 0,
            thirdIdentType: document.getElementById('ocgIdentType').value || '',
            thirdIdentTypeLabel: identTypeLabel,
            thirdIdentNumber: (document.getElementById('ocgIdentification').value || '').trim(),
            thirdName: document.getElementById('ocgThirdName').value.trim()
        };
        if (otherChargeEditIndex >= 0 && otherChargesList[otherChargeEditIndex]) {
            // Conservar el porcentaje editado en línea al reemplazar en edición.
            charge.percent = otherChargesList[otherChargeEditIndex].percent || 0;
            otherChargesList[otherChargeEditIndex] = charge;
        } else {
            otherChargesList.push(charge);
        }
        otherChargeEditIndex = -1;
        renderOtherCharges();
        recalc();
        bootstrap.Modal.getInstance(document.getElementById('otherChargeModal'))?.hide();
    }

    // Elimina un cargo por índice.
    window.removeOtherCharge = function (i) {
        otherChargesList.splice(i, 1);
        renderOtherCharges();
        recalc();
    };

    // Actualiza el monto de un cargo desde el input inline de la tabla.
    window.updateOtherChargeAmount = function (i, value) {
        if (!otherChargesList[i]) return;
        otherChargesList[i].amount = parseFloat(value) || 0;
        const totalEl = document.getElementById(`ocRowTotal_${i}`);
        if (totalEl) totalEl.textContent = otherChargesList[i].amount.toFixed(2);
        recalc();
    };

    // Actualiza el porcentaje informativo de un cargo desde el input inline de la tabla.
    window.updateOtherChargePercent = function (i, value) {
        if (!otherChargesList[i]) return;
        otherChargesList[i].percent = parseFloat(value) || 0;
    };

    // Reabre el modal para editar un cargo existente. NO se elimina la fila aquí:
    // el índice en edición se guarda y solo se aplica al guardar. Si el usuario
    // cancela, la fila permanece intacta.
    window.editOtherCharge = async function (i) {
        const c = otherChargesList[i];
        if (!c) return;
        await Promise.all([loadOtherChargesCatalog(), loadIdentificationTypes()]);
        document.getElementById('ocgType').value = String(c.typeId);
        onOtherChargeTypeChange();
        document.getElementById('ocgOtherType').value = c.otherTypeDescription || '';
        document.getElementById('ocgDetail').value = c.detail || '';
        document.getElementById('ocgAmount').value = c.amount || '';
        document.getElementById('ocgIdentType').value = c.thirdIdentType || '';
        document.getElementById('ocgIdentification').value = c.thirdIdentNumber || '';
        document.getElementById('ocgThirdName').value = c.thirdName || '';
        document.getElementById('ocgIdentError')?.classList.add('d-none');
        otherChargeEditIndex = i;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('otherChargeModal')).show();
    };

    // Dibuja la tabla de "Otros cargos" del documento. La sección se muestra solo
    // cuando hay al menos un cargo. Monto y porcentaje son editables en línea.
    function renderOtherCharges() {
        const section = document.getElementById('otherChargesSection');
        const body = document.getElementById('otherChargesBody');
        if (!body) return;
        if (otherChargesList.length === 0) {
            body.innerHTML = '';
            section?.classList.add('d-none');
            return;
        }
        section?.classList.remove('d-none');
        body.innerHTML = otherChargesList.map((c, i) => {
            const ident = c.thirdIdentNumber
                ? `${escapeHtmlNature(c.thirdIdentTypeLabel || '')}: ${escapeHtmlNature(c.thirdIdentNumber)}${c.thirdName ? '<br>' + escapeHtmlNature(c.thirdName) : ''}`
                : '';
            return `
            <tr>
                <td>${escapeHtmlNature(c.docLabel || c.typeCode)}</td>
                <td>${escapeHtmlNature(c.detail)}</td>
                <td>${ident}</td>
                <td class="text-end">
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                           value="${c.amount.toFixed(2)}" onchange="updateOtherChargeAmount(${i}, this.value)" style="max-width:110px;display:inline-block;">
                </td>
                <td class="text-end">
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                           value="${(c.percent || 0) ? c.percent : ''}" placeholder="%" onchange="updateOtherChargePercent(${i}, this.value)" style="max-width:80px;display:inline-block;">
                </td>
                <td class="text-end"><span id="ocRowTotal_${i}" class="ei-sum-val">${c.amount.toFixed(2)}</span></td>
                <td class="text-end text-nowrap" style="white-space:nowrap;">
                    <div class="d-inline-flex align-items-center justify-content-end gap-2 flex-nowrap">
                        <button type="button" class="btn btn-sm btn-link text-info p-0" title="Editar cargo" onclick="editOtherCharge(${i})"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Eliminar cargo" onclick="removeOtherCharge(${i})"><i class="bi bi-trash"></i></button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

