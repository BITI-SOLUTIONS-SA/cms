@{
    ViewData["Title"] = "Códigos de Tarifa";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? "";
    var apiToken = ViewBag.ApiToken as string ?? "";
}

<style>
    .dtr-card { background: #16213e; border: 1px solid #23305c; border-radius: .75rem; }
    .dtr-table { color: #1e293b; background-color: #ffffff; }
    .dtr-table thead th { color: #334155; border-color: #cbd5e1; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; background-color: #f1f5f9; }
    .dtr-table td, .dtr-table th { border-color: #cbd5e1; vertical-align: middle; }
    .dtr-table td { color: #1e293b; }
    .dtr-code { font-family: monospace; font-weight: 700; color: #1d4ed8; }
    .badge-flag { font-size: .68rem; }
    small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
    .modal-content { background: #16213e; color: #e0e0e0; border: 1px solid #23305c; }
    .modal-header, .modal-footer { border-color: #23305c; }
    .form-check-label { color: #e0e0e0; }
    .dtr-table td small, .dtr-table .text-muted { color: #475569 !important; }
</style>

<div class="container-fluid py-3 text-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-percent me-2"></i>Códigos de Tarifa</h4>
        <div>
            <a asp-action="TaxTypes" class="btn btn-outline-light btn-sm"><i class="bi bi-percent-square"></i> Tipos de Impuesto</a>
            <a asp-action="Discounts" class="btn btn-outline-light btn-sm"><i class="bi bi-percent"></i> Códigos de Descuento</a>
            <button id="dtrNewBtn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nueva tarifa</button>
        </div>
    </div>

    <div class="card dtr-card mb-3">
        <div class="card-body">
            <p class="text-light mb-3">
                Catálogo central de <strong>códigos de tarifa del IVA del Ministerio de Hacienda</strong>
                (<code>CodigoTarifa</code>, formato <code>00</code>). Es compartido por todas las compañías.
                Los códigos marcados como <strong>activos</strong> aparecen en el selector "Código de la tarifa"
                del modal de impuesto en la pantalla de emisión <em>"/ElectronicInvoice/Emit"</em>.
            </p>

            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-light">Buscar (código o nombre)</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="dtrSearch" class="form-control" placeholder="Ej: general..." />
                        <button class="btn btn-outline-info" type="button" id="dtrSearchBtn"><i class="bi bi-search"></i></button>
                        <button class="btn btn-outline-secondary" type="button" id="dtrSearchClear" title="Limpiar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="dtrOnlyActive" />
                        <label class="form-check-label" for="dtrOnlyActive">Solo activos</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table dtr-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Código</th>
                            <th>Nombre</th>
                            <th class="text-end" style="width: 90px;">% Tarifa</th>
                            <th class="text-center" style="width: 90px;">Default</th>
                            <th class="text-center" style="width: 90px;">Exenta</th>
                            <th class="text-center" style="width: 90px;">Orden</th>
                            <th class="text-center" style="width: 80px;">Activo</th>
                            <th class="text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="dtrTableBody">
                        <tr><td colspan="8" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <small class="text-light" id="dtrInfo"></small>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-light" id="dtrPrev"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-light" id="dtrNext"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal edición/creación -->
<div class="modal fade" id="dtrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i><span id="dtrModalTitle">Editar tarifa</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="fr_id" />
                <div class="row g-2">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Código</label>
                        <input type="text" id="fr_code" class="form-control" maxlength="2" placeholder="00" />
                        <small class="form-text">Formato Hacienda: 00</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">% Tarifa</label>
                        <input type="number" id="fr_ratePercent" class="form-control" min="0" max="100" step="0.01" value="0" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" id="fr_displayOrder" class="form-control" min="0" max="999" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" id="fr_name" class="form-control" maxlength="200" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="fr_description" class="form-control" rows="2" maxlength="1000"></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fr_isDefault" />
                            <label class="form-check-label" for="fr_isDefault">Default</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fr_isExempt" />
                            <label class="form-check-label" for="fr_isExempt">Exenta</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fr_isActive" checked />
                            <label class="form-check-label" for="fr_isActive">Activo</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="dtrSaveBtn"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const DTR = { api: '@Html.Raw(apiBaseUrl)', token: '@Html.Raw(apiToken)' };
    let dtrPage = 1, dtrPageSize = 50, dtrTotal = 0;

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    async function dtrFetch(path, options = {}) {
        const opts = Object.assign({ headers: {} }, options);
        if (DTR.token) opts.headers['Authorization'] = `Bearer ${DTR.token}`;
        if (options.body) opts.headers['Content-Type'] = 'application/json';
        return fetch(DTR.api + path, opts);
    }

    function boolBadge(v) {
        return v
            ? '<span class="badge bg-success badge-flag">Sí</span>'
            : '<span class="badge bg-secondary badge-flag">No</span>';
    }

    async function loadTaxRates() {
        const body = document.getElementById('dtrTableBody');
        body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Cargando...</td></tr>';
        const search = document.getElementById('dtrSearch').value.trim();
        const onlyActive = document.getElementById('dtrOnlyActive').checked;
        const qs = new URLSearchParams({ page: dtrPage, pageSize: dtrPageSize, onlyActive });
        if (search) qs.set('search', search);
        try {
            const r = await dtrFetch('/api/electronicdocumenttaxrate?' + qs.toString());
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            dtrTotal = data.total;
            const rows = data.items || [];
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Sin resultados.</td></tr>';
            } else {
                body.innerHTML = rows.map(a => `
                    <tr>
                        <td><span class="dtr-code">${escapeHtml(a.code)}</span></td>
                        <td>${escapeHtml(a.name)}</td>
                        <td class="text-end">${(a.ratePercent ?? 0)}</td>
                        <td class="text-center">${boolBadge(a.isDefault)}</td>
                        <td class="text-center">${boolBadge(a.isExempt)}</td>
                        <td class="text-center">${a.displayOrder ?? 0}</td>
                        <td class="text-center">${boolBadge(a.isActive)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick='dtrEdit(${JSON.stringify(a).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="dtrDelete(${a.id})"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`).join('');
            }
            const from = dtrTotal === 0 ? 0 : (dtrPage - 1) * dtrPageSize + 1;
            const to = Math.min(dtrPage * dtrPageSize, dtrTotal);
            document.getElementById('dtrInfo').textContent = `Mostrando ${from}-${to} de ${dtrTotal}`;
        } catch (e) {
            console.error(e);
            body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Error al cargar.</td></tr>';
        }
    }

    function dtrOpenModal(title) {
        document.getElementById('dtrModalTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('dtrModal')).show();
    }

    function dtrNew() {
        document.getElementById('fr_id').value = '';
        document.getElementById('fr_code').value = '';
        document.getElementById('fr_name').value = '';
        document.getElementById('fr_description').value = '';
        document.getElementById('fr_ratePercent').value = '0';
        document.getElementById('fr_displayOrder').value = '0';
        document.getElementById('fr_isDefault').checked = false;
        document.getElementById('fr_isExempt').checked = false;
        document.getElementById('fr_isActive').checked = true;
        document.getElementById('fr_code').disabled = false;
        dtrOpenModal('Nueva tarifa');
    }

    function dtrEdit(a) {
        document.getElementById('fr_id').value = a.id;
        document.getElementById('fr_code').value = a.code;
        document.getElementById('fr_name').value = a.name;
        document.getElementById('fr_description').value = a.description ?? '';
        document.getElementById('fr_ratePercent').value = a.ratePercent ?? 0;
        document.getElementById('fr_displayOrder').value = a.displayOrder ?? 0;
        document.getElementById('fr_isDefault').checked = a.isDefault;
        document.getElementById('fr_isExempt').checked = a.isExempt;
        document.getElementById('fr_isActive').checked = a.isActive;
        document.getElementById('fr_code').disabled = false;
        dtrOpenModal('Editar tarifa');
    }

    async function dtrSave() {
        const id = document.getElementById('fr_id').value;
        const payload = {
            code: document.getElementById('fr_code').value.trim(),
            name: document.getElementById('fr_name').value.trim(),
            description: document.getElementById('fr_description').value.trim(),
            ratePercent: parseFloat(document.getElementById('fr_ratePercent').value) || 0,
            displayOrder: parseInt(document.getElementById('fr_displayOrder').value, 10) || 0,
            isDefault: document.getElementById('fr_isDefault').checked,
            isExempt: document.getElementById('fr_isExempt').checked,
            isActive: document.getElementById('fr_isActive').checked
        };
        if (!payload.code || !payload.name) {
            alert('Código y nombre son obligatorios.');
            return;
        }
        try {
            const r = id
                ? await dtrFetch('/api/electronicdocumenttaxrate/' + id, { method: 'PUT', body: JSON.stringify(payload) })
                : await dtrFetch('/api/electronicdocumenttaxrate', { method: 'POST', body: JSON.stringify(payload) });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al guardar.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('dtrModal')).hide();
            await loadTaxRates();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    async function dtrDelete(id) {
        if (!confirm('¿Eliminar este código de tarifa?')) return;
        try {
            const r = await dtrFetch('/api/electronicdocumenttaxrate/' + id, { method: 'DELETE' });
            if (!r.ok) {
                const err = await r.json().catch(() => ({}));
                alert(err.message || 'Error al eliminar.');
                return;
            }
            await loadTaxRates();
        } catch (e) { console.error(e); alert('Error de red.'); }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Mover modal al body para evitar problemas de z-index con el sidebar
        ['dtrModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });

        document.getElementById('dtrNewBtn').addEventListener('click', dtrNew);
        document.getElementById('dtrSaveBtn').addEventListener('click', dtrSave);
        document.getElementById('dtrSearchBtn').addEventListener('click', () => { dtrPage = 1; loadTaxRates(); });
        document.getElementById('dtrSearch').addEventListener('keyup', e => { if (e.key === 'Enter') { dtrPage = 1; loadTaxRates(); } });
        document.getElementById('dtrSearchClear').addEventListener('click', () => { document.getElementById('dtrSearch').value = ''; dtrPage = 1; loadTaxRates(); });
        document.getElementById('dtrOnlyActive').addEventListener('change', () => { dtrPage = 1; loadTaxRates(); });
        document.getElementById('dtrPrev').addEventListener('click', () => { if (dtrPage > 1) { dtrPage--; loadTaxRates(); } });
        document.getElementById('dtrNext').addEventListener('click', () => { if (dtrPage * dtrPageSize < dtrTotal) { dtrPage++; loadTaxRates(); } });

        loadTaxRates();
    });
</script>
}
