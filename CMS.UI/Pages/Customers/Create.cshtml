@page
@model CMS.UI.Pages.Customers.CreateModel
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Cliente</h2>
            <p class="text-light small mb-0">Crear un nuevo cliente, proveedor o emisor de facturación electrónica</p>
        </div>
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" id="customerForm">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" 
                                data-bs-target="#general" type="button" role="tab">
                            <i class="bi bi-info-circle me-1"></i>General
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="billing-tab" data-bs-toggle="tab" 
                                data-bs-target="#billing" type="button" role="tab">
                            <i class="bi bi-receipt me-1"></i>Facturación Electrónica
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="commercial-tab" data-bs-toggle="tab" 
                                data-bs-target="#commercial" type="button" role="tab">
                            <i class="bi bi-cart me-1"></i>Comercial
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="contact-tab" data-bs-toggle="tab" 
                                data-bs-target="#contact" type="button" role="tab">
                            <i class="bi bi-telephone me-1"></i>Contacto
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="customerTabContent">

                    <!-- TAB: GENERAL -->
                    <div class="tab-pane fade show active" id="general" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.Code" class="form-label text-light">Código *</label>
                                    <input asp-for="Customer.Code" class="form-control" required />
                                    <small class="form-text">Código único del cliente</small>
                                    <span asp-validation-for="Customer.Code" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.CustomerType" class="form-label text-light">Tipo *</label>
                                    <select asp-for="Customer.CustomerType" class="form-select" required>
                                        <option value="Customer">Cliente</option>
                                        <option value="Supplier">Proveedor</option>
                                        <option value="Both">Ambos</option>
                                        <option value="Issuer">Emisor</option>
                                    </select>
                                    <small class="form-text">Tipo de relación comercial</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Customer.Name" class="form-label text-light">Razón Social / Nombre *</label>
                                    <input asp-for="Customer.Name" class="form-control" required />
                                    <span asp-validation-for="Customer.Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.CommercialName" class="form-label text-light">Nombre Comercial</label>
                                    <input asp-for="Customer.CommercialName" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.IdentificationType" class="form-label text-light">Tipo Identificación</label>
                                    <select asp-for="Customer.IdentificationType" class="form-select">
                                        <option value="">Ninguno</option>
                                        <option value="01">01 - Física</option>
                                        <option value="02">02 - Jurídica</option>
                                        <option value="03">03 - DIMEX</option>
                                        <option value="04">04 - NITE</option>
                                        <option value="05">05 - Extranjero</option>
                                    </select>
                                    <small class="form-text">Tipo de cédula (Hacienda CR)</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.Identification" class="form-label text-light">Identificación</label>
                                    <input asp-for="Customer.Identification" class="form-control" 
                                           placeholder="Ej: 304560789" />
                                    <small class="form-text">Cédula o identificación fiscal</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.ForeignIdentification" class="form-label text-light">ID Extranjero</label>
                                    <input asp-for="Customer.ForeignIdentification" class="form-control" 
                                           placeholder="Para clientes sin cédula nacional" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="Customer.Notes" class="form-label text-light">Notas</label>
                                    <textarea asp-for="Customer.Notes" class="form-control" rows="3"></textarea>
                                    <small class="form-text">Notas visibles para el cliente</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="Customer.InternalNotes" class="form-label text-light">Notas Internas</label>
                                    <textarea asp-for="Customer.InternalNotes" class="form-control" rows="2"></textarea>
                                    <small class="form-text">Notas privadas (no visibles al cliente)</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="Customer.IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="Customer.IsActive" class="form-check-label text-light">Cliente Activo</label>
                        </div>
                    </div>

                    <!-- TAB: FACTURACIÓN ELECTRÓNICA -->
                    <div class="tab-pane fade" id="billing" role="tabpanel">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Facturación Electrónica CR v4.4</strong><br/>
                            Configure estos campos solo si este customer emitirá comprobantes electrónicos ante Hacienda.
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Customer.IsIssuer" class="form-check-input" type="checkbox" 
                                   id="isIssuerSwitch" onchange="toggleIssuerFields(this.checked)" />
                            <label asp-for="Customer.IsIssuer" class="form-check-label text-light">
                                <strong>Es Emisor de Comprobantes Electrónicos</strong>
                            </label>
                            <small class="form-text d-block">Marque si este cliente tiene certificado digital de Hacienda</small>
                        </div>

                        <div id="issuerFields" style="display: none;">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Customer.EconomicActivity" class="form-label text-light">Actividad Económica</label>
                                        <input asp-for="Customer.EconomicActivity" class="form-control" 
                                               placeholder="Ej: 620200" maxlength="6" />
                                        <small class="form-text">Código de 6 dígitos según Hacienda</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Customer.ActiveEnvironment" class="form-label text-light">Ambiente Activo</label>
                                        <select asp-for="Customer.ActiveEnvironment" class="form-select">
                                            <option value="stag">Pruebas (Sandbox)</option>
                                            <option value="prod">Producción</option>
                                        </select>
                                        <small class="form-text">Ambiente de Hacienda a usar</small>
                                    </div>
                                </div>
                            </div>

                            <div class="form-check form-switch">
                                <input asp-for="Customer.IsCompanyOwner" class="form-check-input" type="checkbox" />
                                <label asp-for="Customer.IsCompanyOwner" class="form-check-label text-light">
                                    <strong>Es el Dueño de la Compañía (Master)</strong>
                                </label>
                                <small class="form-text d-block">Solo un cliente puede ser master por compañía</small>
                            </div>
                        </div>
                    </div>

                    <!-- TAB: COMERCIAL -->
                    <div class="tab-pane fade" id="commercial" role="tabpanel">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.CreditLimit" class="form-label text-light">Límite de Crédito</label>
                                    <input asp-for="Customer.CreditLimit" class="form-control" type="number" step="0.01" 
                                           placeholder="0.00" />
                                    <small class="form-text">Monto máximo de crédito</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.CreditDays" class="form-label text-light">Días de Crédito</label>
                                    <input asp-for="Customer.CreditDays" class="form-control" type="number" 
                                           placeholder="0" />
                                    <small class="form-text">Plazo de pago en días</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.DiscountPct" class="form-label text-light">% Descuento</label>
                                    <input asp-for="Customer.DiscountPct" class="form-control" type="number" 
                                           step="0.01" min="0" max="100" placeholder="0.00" />
                                    <small class="form-text">Porcentaje de descuento general</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.PaymentTerms" class="form-label text-light">Condiciones de Pago</label>
                                    <input asp-for="Customer.PaymentTerms" class="form-control" 
                                           placeholder="Ej: 30 días neto" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.PriceList" class="form-label text-light">Lista de Precios</label>
                                    <input asp-for="Customer.PriceList" class="form-control" 
                                           placeholder="Ej: LISTA-A" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB: CONTACTO -->
                    <div class="tab-pane fade" id="contact" role="tabpanel">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Customer.Email" class="form-label text-light">Email</label>
                                    <input asp-for="Customer.Email" class="form-control" type="email" 
                                           placeholder="email@ejemplo.com" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.Website" class="form-label text-light">Sitio Web</label>
                                    <input asp-for="Customer.Website" class="form-control" 
                                           placeholder="www.ejemplo.com" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label asp-for="Customer.PhoneCode" class="form-label text-light">Código</label>
                                    <input asp-for="Customer.PhoneCode" class="form-control" 
                                           placeholder="506" maxlength="3" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="Customer.Phone" class="form-label text-light">Teléfono</label>
                                    <input asp-for="Customer.Phone" class="form-control" 
                                           placeholder="2222-3333" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="Customer.Mobile" class="form-label text-light">Móvil</label>
                                    <input asp-for="Customer.Mobile" class="form-control" 
                                           placeholder="8888-9999" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.ContactName" class="form-label text-light">Nombre Contacto</label>
                                    <input asp-for="Customer.ContactName" class="form-control" 
                                           placeholder="Nombre de persona de contacto" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.ContactPosition" class="form-label text-light">Cargo</label>
                                    <input asp-for="Customer.ContactPosition" class="form-control" 
                                           placeholder="Ej: Gerente General" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h5 class="text-light mb-3">Ubicación (Códigos Hacienda CR)</h5>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.Province" class="form-label text-light">Provincia</label>
                                    <select asp-for="Customer.Province" class="form-select">
                                        <option value="">Seleccione...</option>
                                        <option value="1">1 - San José</option>
                                        <option value="2">2 - Alajuela</option>
                                        <option value="3">3 - Cartago</option>
                                        <option value="4">4 - Heredia</option>
                                        <option value="5">5 - Guanacaste</option>
                                        <option value="6">6 - Puntarenas</option>
                                        <option value="7">7 - Limón</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.Canton" class="form-label text-light">Cantón</label>
                                    <input asp-for="Customer.Canton" class="form-control" 
                                           placeholder="Ej: 01" maxlength="2" />
                                    <small class="form-text">Código de 2 dígitos</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Customer.District" class="form-label text-light">Distrito</label>
                                    <input asp-for="Customer.District" class="form-control" 
                                           placeholder="Ej: 01" maxlength="2" />
                                    <small class="form-text">Código de 2 dígitos</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="Customer.OtherSigns" class="form-label text-light">Otras Señas</label>
                                    <textarea asp-for="Customer.OtherSigns" class="form-control" rows="2" 
                                              placeholder="Dirección completa en texto"></textarea>
                                    <small class="form-text">Dirección textual completa</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.GpsLatitude" class="form-label text-light">GPS Latitud</label>
                                    <input asp-for="Customer.GpsLatitude" class="form-control" type="number" 
                                           step="0.00000001" placeholder="9.9356731" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Customer.GpsLongitude" class="form-label text-light">GPS Longitud</label>
                                    <input asp-for="Customer.GpsLongitude" class="form-control" type="number" 
                                           step="0.00000001" placeholder="-84.0831107" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Crear Cliente
                </button>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Toggle issuer fields
        function toggleIssuerFields(isChecked) {
            const fields = document.getElementById('issuerFields');
            if (fields) {
                fields.style.display = isChecked ? 'block' : 'none';
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', function () {
            const isIssuerCheckbox = document.getElementById('isIssuerSwitch');
            if (isIssuerCheckbox) {
                toggleIssuerFields(isIssuerCheckbox.checked);
            }
        });
    </script>

    <style>
        small, .form-text, small.text-muted, .text-muted small { 
            color: #cbd5e1 !important; 
        }

        .nav-tabs .nav-link {
            color: #cbd5e1;
        }

        .nav-tabs .nav-link.active {
            background-color: #1a1a2e;
            color: #ffffff;
            border-color: #dee2e6 #dee2e6 #1a1a2e;
        }

        .card {
            background-color: #16213e;
            border-color: #0f3460;
        }

        .card-header {
            background-color: #0f3460;
            border-bottom-color: #dee2e6;
        }
    </style>
}
