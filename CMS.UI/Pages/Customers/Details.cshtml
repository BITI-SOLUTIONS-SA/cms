@page "{id:int}"
@model CMS.UI.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = "Detalles del Customer";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark text-light">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-eye me-2"></i>Detalles del Customer</h4>
                    <div>
                        <a asp-page="./Edit" asp-route-id="@Model.Customer.Id" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <a asp-page="./Index" class="btn btn-sm btn-outline-light ms-2">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- General Info -->
                    <div class="mb-4">
                        <h5 class="border-bottom border-secondary pb-2 mb-3">
                            <i class="bi bi-info-circle me-2"></i>Información General
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Código:</strong>
                                <p class="text-light mb-0">@Model.Customer.Code</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Tipo:</strong>
                                <p class="text-light mb-0">
                                    @switch (Model.Customer.CustomerType)
                                    {
                                        case "Customer": <span class="badge bg-primary">Cliente</span> break;
                                        case "Supplier": <span class="badge bg-info">Proveedor</span> break;
                                        case "Both": <span class="badge bg-success">Cliente y Proveedor</span> break;
                                        case "Issuer": <span class="badge bg-warning text-dark">Emisor</span> break;
                                        default: <span class="badge bg-secondary">@Model.Customer.CustomerType</span> break;
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <strong class="text-light">Razón Social / Nombre:</strong>
                                <p class="text-light mb-0">@Model.Customer.Name</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Nombre Comercial:</strong>
                                <p class="text-light mb-0">@(Model.Customer.CommercialName ?? "-")</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Tipo Identificación:</strong>
                                <p class="text-light mb-0">
                                    @(Model.Customer.IdentificationType switch
                                    {
                                        "01" => "01 - Física",
                                        "02" => "02 - Jurídica",
                                        "03" => "03 - DIMEX",
                                        "04" => "04 - NITE",
                                        "05" => "05 - Extranjero",
                                        _ => Model.Customer.IdentificationType ?? "-"
                                    })
                                </p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Identificación:</strong>
                                <p class="text-light mb-0">@(Model.Customer.Identification ?? "-")</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">ID Extranjero:</strong>
                                <p class="text-light mb-0">@(Model.Customer.ForeignIdentification ?? "-")</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <strong class="text-light">Estado:</strong>
                                <p class="text-light mb-0">
                                    @if (Model.Customer.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Commercial Info -->
                                        {
                                            <span>Provincia: @Model.Customer.Province, Cantón: @(Model.Customer.Canton ?? "-"), Distrito: @(Model.Customer.District ?? "-")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </p>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Customer.OtherSigns))
                            {
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <strong class="text-light">Otras Señas:</strong>
                                        <p class="text-light mb-0">@Model.Customer.OtherSigns</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Commercial Info -->
                    <div class="mb-4">
                        <h5 class="border-bottom border-secondary pb-2 mb-3">
                            <i class="bi bi-cash-coin me-2"></i>Información Comercial
                        </h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Límite de Crédito:</strong>
                                <p class="text-light mb-0">@(Model.Customer.CreditLimit?.ToString("C2") ?? "-")</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Días de Crédito:</strong>
                                <p class="text-light mb-0">@(Model.Customer.CreditDays?.ToString() ?? "-")</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <strong class="text-light">Descuento %:</strong>
                                <p class="text-light mb-0">@(Model.Customer.DiscountPct?.ToString("N2") + "%" ?? "-")</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Condiciones de Pago:</strong>
                                <p class="text-light mb-0">@(Model.Customer.PaymentTerms ?? "-")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Lista de Precios:</strong>
                                <p class="text-light mb-0">@(Model.Customer.PriceList ?? "-")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="mb-4">
                        <h5 class="border-bottom border-secondary pb-2 mb-3">
                            <i class="bi bi-telephone me-2"></i>Información de Contacto
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Email:</strong>
                                <p class="text-light mb-0">@(Model.Customer.Email ?? "-")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Teléfono:</strong>
                                <p class="text-light mb-0">
                                    @if (!string.IsNullOrWhiteSpace(Model.Customer.Phone))
                                    {
                                        <span>+@(Model.Customer.PhoneCode ?? "506") @Model.Customer.Phone</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </p>
                            </div>
                        </div>
                        @if (Model.Customer.GpsLatitude.HasValue && Model.Customer.GpsLongitude.HasValue)
                        {
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <strong class="text-light">Coordenadas GPS:</strong>
                                    <p class="text-light mb-0">
                                        Lat: @Model.Customer.GpsLatitude.Value.ToString("N6"), 
                                        Lng: @Model.Customer.GpsLongitude.Value.ToString("N6")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Audit Info -->
                    <div class="mb-2">
                        <h5 class="border-bottom border-secondary pb-2 mb-3">
                            <i class="bi bi-clock-history me-2"></i>Auditoría
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Creado:</strong>
                                <p class="text-light mb-0">
                                    @Model.Customer.CreateDate.ToString("dd/MM/yyyy HH:mm") por @Model.Customer.CreatedBy
                                </p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-light">Última Modificación:</strong>
                                <p class="text-light mb-0">
                                    @Model.Customer.RecordDate.ToString("dd/MM/yyyy HH:mm") por @Model.Customer.UpdatedBy
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-secondary { border-color: #495057 !important; }
</style>
