@page "{id:int}"
@model CMS.UI.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Editar Customer";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark text-light">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Customer</h4>
                    <a asp-page="./Index" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Customer.Id" />

                        <!-- Tabs Navigation -->
                        <ul class="nav nav-tabs mb-3" id="customerTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
                                    <i class="bi bi-info-circle me-1"></i>General
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="billing-tab" data-bs-toggle="tab" data-bs-target="#billing" type="button" role="tab">
                                    <i class="bi bi-receipt me-1"></i>Facturación Electrónica
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="commercial-tab" data-bs-toggle="tab" data-bs-target="#commercial" type="button" role="tab">
                                    <i class="bi bi-cash-coin me-1"></i>Comercial
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab">
                                    <i class="bi bi-telephone me-1"></i>Contacto
                                </button>
                            </li>
                        </ul>

                        <!-- Tabs Content -->
                        <div class="tab-content" id="customerTabsContent">
                            <!-- General Tab -->
                            <div class="tab-pane fade show active" id="general" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.Code" class="form-label text-light">Código *</label>
                                        <input asp-for="Customer.Code" class="form-control bg-dark text-light border-secondary" required />
                                        <span asp-validation-for="Customer.Code" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.CustomerType" class="form-label text-light">Tipo *</label>
                                        <select asp-for="Customer.CustomerType" class="form-select bg-dark text-light border-secondary" required>
                                            <option value="Customer">Cliente</option>
                                            <option value="Supplier">Proveedor</option>
                                            <option value="Both">Cliente y Proveedor</option>
                                            <option value="Issuer">Emisor</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-8 mb-3">
                                        <label asp-for="Customer.Name" class="form-label text-light">Razón Social / Nombre *</label>
                                        <input asp-for="Customer.Name" class="form-control bg-dark text-light border-secondary" required />
                                        <span asp-validation-for="Customer.Name" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Customer.CommercialName" class="form-label text-light">Nombre Comercial</label>
                                        <input asp-for="Customer.CommercialName" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="Customer.IdentificationType" class="form-label text-light">Tipo Identificación</label>
                                        <select asp-for="Customer.IdentificationType" class="form-select bg-dark text-light border-secondary">
                                            <option value="">Seleccione...</option>
                                            <option value="01">01 - Física</option>
                                            <option value="02">02 - Jurídica</option>
                                            <option value="03">03 - DIMEX</option>
                                            <option value="04">04 - NITE</option>
                                            <option value="05">05 - Extranjero</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5 mb-3">
                                        <label asp-for="Customer.Identification" class="form-label text-light">Identificación</label>
                                        <input asp-for="Customer.Identification" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Customer.ForeignIdentification" class="form-label text-light">ID Extranjero</label>
                                        <input asp-for="Customer.ForeignIdentification" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>

                                <div class="form-check form-switch mb-3">
                                    <input asp-for="Customer.IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="Customer.IsActive" class="form-check-label text-light">Activo</label>
                                </div>
                            </div>

                            <!-- Billing Tab -->
                            <div class="tab-pane fade" id="billing" role="tabpanel">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="Customer.IsIssuer" class="form-check-input" type="checkbox" id="isIssuerSwitch" />
                                    <label asp-for="Customer.IsIssuer" class="form-check-label text-light">Es Emisor de Comprobantes Electrónicos</label>
                                </div>

                                <div id="issuerFields">
                                    <div class="form-check form-switch mb-3">
                                        <input asp-for="Customer.IsCompanyOwner" class="form-check-input" type="checkbox" />
                                        <label asp-for="Customer.IsCompanyOwner" class="form-check-label text-light">Es Dueño de la Compañía (Master Issuer)</label>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="Customer.ActiveEnvironment" class="form-label text-light">Ambiente Activo</label>
                                            <select asp-for="Customer.ActiveEnvironment" class="form-select bg-dark text-light border-secondary">
                                                <option value="stag">Pruebas (Staging)</option>
                                                <option value="prod">Producción</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="Customer.EconomicActivity" class="form-label text-light">Actividad Económica</label>
                                            <input asp-for="Customer.EconomicActivity" class="form-control bg-dark text-light border-secondary" maxlength="6" />
                                            <small class="text-light">6 dígitos (ej: 620200)</small>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label asp-for="Customer.Province" class="form-label text-light">Provincia</label>
                                            <input asp-for="Customer.Province" class="form-control bg-dark text-light border-secondary" maxlength="1" />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label asp-for="Customer.Canton" class="form-label text-light">Cantón</label>
                                            <input asp-for="Customer.Canton" class="form-control bg-dark text-light border-secondary" maxlength="2" />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label asp-for="Customer.District" class="form-label text-light">Distrito</label>
                                            <input asp-for="Customer.District" class="form-control bg-dark text-light border-secondary" maxlength="2" />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Customer.OtherSigns" class="form-label text-light">Otras Señas</label>
                                        <textarea asp-for="Customer.OtherSigns" class="form-control bg-dark text-light border-secondary" rows="2"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Commercial Tab -->
                            <div class="tab-pane fade" id="commercial" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Customer.CreditLimit" class="form-label text-light">Límite de Crédito</label>
                                        <input asp-for="Customer.CreditLimit" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Customer.CreditDays" class="form-label text-light">Días de Crédito</label>
                                        <input asp-for="Customer.CreditDays" type="number" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Customer.DiscountPct" class="form-label text-light">Descuento %</label>
                                        <input asp-for="Customer.DiscountPct" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.PaymentTerms" class="form-label text-light">Condiciones de Pago</label>
                                        <input asp-for="Customer.PaymentTerms" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.PriceList" class="form-label text-light">Lista de Precios</label>
                                        <input asp-for="Customer.PriceList" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Tab -->
                            <div class="tab-pane fade" id="contact" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.Email" class="form-label text-light">Email</label>
                                        <input asp-for="Customer.Email" type="email" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="Customer.PhoneCode" class="form-label text-light">Código País</label>
                                        <input asp-for="Customer.PhoneCode" class="form-control bg-dark text-light border-secondary" value="506" />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="Customer.Phone" class="form-label text-light">Teléfono</label>
                                        <input asp-for="Customer.Phone" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.GpsLatitude" class="form-label text-light">Latitud GPS</label>
                                        <input asp-for="Customer.GpsLatitude" type="number" step="any" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Customer.GpsLongitude" class="form-label text-light">Longitud GPS</label>
                                        <input asp-for="Customer.GpsLongitude" type="number" step="any" class="form-control bg-dark text-light border-secondary" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mover modales al body
        document.addEventListener('DOMContentLoaded', function () {
            // Toggle issuer fields
            const isIssuerSwitch = document.getElementById('isIssuerSwitch');
            const issuerFields = document.getElementById('issuerFields');

            function toggleIssuerFields() {
                issuerFields.style.display = isIssuerSwitch.checked ? 'block' : 'none';
            }

            isIssuerSwitch.addEventListener('change', toggleIssuerFields);
            toggleIssuerFields(); // Initial state
        });
    </script>
    <style>
        small, .form-text, small.text-muted, .text-muted small { color: #cbd5e1 !important; }
        .nav-tabs .nav-link { color: #adb5bd; }
        .nav-tabs .nav-link.active { color: #fff; background-color: #495057; border-color: #495057; }
    </style>
}
